  .pj__method-label {
    display: block;
    border: 1.5px solid var(--line);
    border-radius: 12px;
    background: var(--white);
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
