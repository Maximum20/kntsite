---
import { SEO } from "astro-seo";
import { Icon } from "astro-icon/components";
import Footer from "../components/footer.astro";
import Navbar from "../components/navbar/navbar.astro";
import { siteSettings } from "../data";

import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque/index.css";
import "../styles/global.css";

const { title, description, hideSubNav = false } = Astro.props;
const makeTitle = title
  ? `${title} | ${siteSettings.clinicShortName}`
  : `${siteSettings.departmentName} | ${siteSettings.clinicShortName}`;
const makeDesc =
  description ||
  "Сучасна променева терапія у Дніпрі. Лінійні прискорювачі Elekta Versa HD, Synergy, система BrainLAB, КТ-розмітка, брахітерапія та гамма-терапія за програмою НСЗУ.";
---

<!DOCTYPE html>
<html lang="uk" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{makeTitle}</title>
    <SEO title={makeTitle} description={makeDesc} />

    {/* Миттєве відновлення теми та налаштувань доступності до рендеру сторінки (без миготіння) */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var savedTheme = localStorage.getItem("knt_theme_v1");
          if (savedTheme === "dark") {
            root.setAttribute("data-theme", "dark");
            root.classList.add("dark");
          } else {
            root.removeAttribute("data-theme");
            root.classList.remove("dark");
          }
        } catch (e) {}

        try {
          var raw = localStorage.getItem("dokod_a11y_v1");
          if (raw) {
            var cfg = JSON.parse(raw);
            if (cfg.font && cfg.font !== "normal") {
              root.setAttribute("data-a11y-font", cfg.font);
            }
            if (cfg.contrast && cfg.contrast !== "normal") {
              root.setAttribute("data-a11y-contrast", cfg.contrast);
            }
            if (cfg.motion === "reduce") {
              root.setAttribute("data-a11y-motion", "reduce");
            }
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased min-h-screen relative overflow-x-hidden flex flex-col">
    {/* Прихований контейнер для Google Translate Website Element */}
    <div id="google_translate_element" class="notranslate" translate="no" aria-hidden="true"></div>

    {/* ДЕКОРАТИВНІ ЕЛЕМЕНТИ ФОНУ */}
    <div id="bg-blobs" class="fixed inset-0 -z-10 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute top-[-15%] left-[-10%] w-[800px] h-[800px] bg-blue-400/20 rounded-full blur-[120px] animate-blob"></div>
      <div class="absolute top-[20%] right-[-10%] w-[600px] h-[600px] bg-cyan-400/20 rounded-full blur-[100px] animate-blob animation-delay-2000"></div>
      <div class="absolute bottom-[-10%] left-[10%] w-[700px] h-[700px] bg-indigo-400/15 rounded-full blur-[130px] animate-blob animation-delay-4000"></div>
    </div>

    <Navbar hideSubNav={hideSubNav} />

    <div class="flex-1">
      <slot />
    </div>

    <Footer />

    {/* ГЛОБАЛЬНЕ СПОВІЩЕННЯ TOAST (Для копіювання телефонів, адрес, посилань) */}
    <div
      id="global-toast"
      role="status"
      aria-live="polite"
      class="fixed top-6 right-6 z-[1100] flex items-center gap-3 px-5 py-3.5 bg-emerald-600 text-white rounded-2xl shadow-2xl shadow-emerald-900/20 font-bold text-sm pointer-events-none opacity-0 -translate-y-6 transition-all duration-300"
    >
      <Icon name="bx:check-circle" class="w-5 h-5 shrink-0" />
      <span id="global-toast-message">Скопійовано в буфер обміну</span>
    </div>

    {/* ГЛОБАЛЬНА КНОПКА ПРОКРУТКИ ВГОРУ (Працює на всіх сторінках сайту) */}
    <button
      id="scroll-to-top"
      type="button"
      class="fixed bottom-6 right-6 md:bottom-8 md:right-8 z-[100] bg-white/85 hover:bg-blue-600 backdrop-blur-xl text-blue-600 hover:text-white p-3.5 md:p-4 rounded-full border border-blue-200/80 shadow-xl shadow-blue-900/10 transition-all duration-300 translate-y-20 opacity-0 pointer-events-none hover:-translate-y-1 active:scale-95 cursor-pointer"
      aria-label="Прокрутити сторінку вгору"
      title="Вгору"
    >
      <Icon name="bx:chevron-up" class="w-7 h-7 md:w-8 md:h-8" />
    </button>

    <style is:global>
      @keyframes blob {
        0%, 100% { transform: translate(0px, 0px) scale(1); }
        33% { transform: translate(40px, -60px) scale(1.08); }
        66% { transform: translate(-30px, 30px) scale(0.94); }
      }

      .animate-blob {
        animation: blob 14s infinite alternate ease-in-out;
      }

      .animation-delay-2000 { animation-delay: 2s; }
      .animation-delay-4000 { animation-delay: 4s; }

      img {
        max-width: 100%;
      }

      /* Скролбар */
      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
      ::-webkit-scrollbar-thumb:hover { background: #94a1b4; }
    </style>

    <script is:inline>
      // Глобальна функція показу Toast-повідомлення
      window.showGlobalToast = function (message) {
        const toast = document.getElementById("global-toast");
        const msgEl = document.getElementById("global-toast-message");
        if (!toast || !msgEl) return;
        msgEl.textContent = message || "Скопійовано";
        toast.classList.remove("opacity-0", "-translate-y-6");
        toast.classList.add("opacity-100", "translate-y-0");
        clearTimeout(window.__toastTimer);
        window.__toastTimer = setTimeout(() => {
          toast.classList.add("opacity-0", "-translate-y-6");
          toast.classList.remove("opacity-100", "translate-y-0");
        }, 2800);
      };

      // --- КЛІЄНТСЬКИЙ ПЕРЕКЛАД UA <-> EN (GOOGLE TRANSLATE WEBSITE ELEMENT) ---
      (function setupGoogleTranslateController() {
        var LANG_STORAGE_KEY = "knt_lang_v1";

        function getGoogTransCookie() {
          var match = document.cookie.match(/(?:^|;\s*)googtrans=([^;]+)/);
          return match ? decodeURIComponent(match[1]) : "";
        }

        function setGoogTransCookie(value) {
          var hostname = window.location.hostname;
          var isLocalOrIp =
            hostname === "localhost" ||
            hostname === "127.0.0.1" ||
            /^\d+\.\d+\.\d+\.\d+$/.test(hostname);

          if (!value) {
            document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; SameSite=Lax";
            if (!isLocalOrIp && hostname.includes(".")) {
              var parts = hostname.split(".");
              var rootDomain = "." + parts.slice(-2).join(".");
              document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=" + hostname + "; SameSite=Lax";
              document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=" + rootDomain + "; SameSite=Lax";
            }
            return;
          }

          document.cookie = "googtrans=" + value + "; path=/; SameSite=Lax";
          if (!isLocalOrIp && hostname.includes(".")) {
            var parts2 = hostname.split(".");
            var rootDomain2 = "." + parts2.slice(-2).join(".");
            document.cookie = "googtrans=" + value + "; path=/; domain=" + hostname + "; SameSite=Lax";
            document.cookie = "googtrans=" + value + "; path=/; domain=" + rootDomain2 + "; SameSite=Lax";
          }
        }

        function getCurrentLang() {
          var cookieVal = getGoogTransCookie();
          if (cookieVal.indexOf("/en") !== -1) return "en";
          try {
            if (localStorage.getItem(LANG_STORAGE_KEY) === "en") return "en";
          } catch (e) {}
          return "uk";
        }

        function updateLangButtonsUI(lang) {
          document.querySelectorAll("[data-lang-btn]").forEach(function (btn) {
            var btnLang = btn.getAttribute("data-lang-btn");
            var isActive = btnLang === lang;
            btn.classList.toggle("is-active", isActive);
            btn.classList.toggle("bg-blue-600", isActive);
            btn.classList.toggle("text-white", isActive);
            btn.classList.toggle("shadow-xs", isActive);
            btn.classList.toggle("text-slate-600", !isActive);
            btn.setAttribute("aria-pressed", isActive ? "true" : "false");
          });
        }

        function triggerGoogleCombo(targetLang, attemptsLeft) {
          var combo = document.querySelector(".goog-te-combo");
          if (combo) {
            if (combo.value !== targetLang) {
              combo.value = targetLang;
              combo.dispatchEvent(new Event("change", { bubbles: true }));
            }
            return;
          }
          if (attemptsLeft > 0) {
            setTimeout(function () {
              triggerGoogleCombo(targetLang, attemptsLeft - 1);
            }, 180);
          }
        }

        function ensureGoogleTranslateScript(targetLang) {
          window.__kntPendingLang = targetLang;

          if (window.google && window.google.translate && window.google.translate.TranslateElement) {
            if (!document.querySelector(".goog-te-combo")) {
              window.googleTranslateElementInit();
            }
            triggerGoogleCombo(targetLang, 20);
            return;
          }

          if (document.getElementById("google-translate-script")) {
            triggerGoogleCombo(targetLang, 30);
            return;
          }

          var script = document.createElement("script");
          script.id = "google-translate-script";
          script.src = "https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit";
          script.async = true;
          document.head.appendChild(script);
        }

        window.googleTranslateElementInit = function () {
          var host = document.getElementById("google_translate_element");
          if (!host || !window.google || !window.google.translate) return;
          if (!host.querySelector(".goog-te-combo")) {
            new window.google.translate.TranslateElement(
              {
                pageLanguage: "uk",
                includedLanguages: "uk,en",
                autoDisplay: false,
              },
              "google_translate_element"
            );
          }
          var pending = window.__kntPendingLang || getCurrentLang();
          if (pending === "en") {
            triggerGoogleCombo("en", 25);
          }
        };

        window.__kntGetLang = getCurrentLang;
        window.__kntSyncLangUI = function () {
          updateLangButtonsUI(getCurrentLang());
        };

        window.__kntSetLang = function (lang) {
          var normalized = lang === "en" ? "en" : "uk";
          try {
            localStorage.setItem(LANG_STORAGE_KEY, normalized);
          } catch (e) {}
          updateLangButtonsUI(normalized);

          if (normalized === "en") {
            setGoogTransCookie("/uk/en");
            ensureGoogleTranslateScript("en");
          } else {
            setGoogTransCookie("");
            var wasTranslated =
              document.documentElement.classList.contains("translated-ltr") ||
              document.documentElement.classList.contains("translated-rtl") ||
              Boolean(document.querySelector(".goog-te-combo"));

            var combo = document.querySelector(".goog-te-combo");
            if (combo) {
              combo.value = "uk";
              combo.dispatchEvent(new Event("change", { bubbles: true }));
            }

            if (wasTranslated) {
              // Чисте повернення оригінального українського DOM без залишкових тегів Google Translate
              window.location.reload();
            }
          }
        };

        // Захист від зміщення body (top: 40px), яке додає банер Google Translate
        function lockBodyTop() {
          if (document.body && document.body.style.top && document.body.style.top !== "0px") {
            document.body.style.top = "0px";
          }
        }

        function initLangOnLoad() {
          var current = getCurrentLang();
          updateLangButtonsUI(current);
          if (current === "en") {
            setGoogTransCookie("/uk/en");
            ensureGoogleTranslateScript("en");
          }

          if (document.body && !window.__kntBodyTopObserver) {
            lockBodyTop();
            window.__kntBodyTopObserver = new MutationObserver(lockBodyTop);
            window.__kntBodyTopObserver.observe(document.body, {
              attributes: true,
              attributeFilter: ["style"],
            });
          }
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initLangOnLoad);
        } else {
          initLangOnLoad();
        }
        document.addEventListener("astro:after-swap", initLangOnLoad);
      })();

      function initGlobalLayoutControls() {
        const toTopBtn = document.getElementById("scroll-to-top");

        function handleScroll() {
          const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
          if (scrollTop > 320) {
            toTopBtn?.classList.remove("translate-y-20", "opacity-0", "pointer-events-none");
          } else {
            toTopBtn?.classList.add("translate-y-20", "opacity-0", "pointer-events-none");
          }
        }

        window.addEventListener("scroll", handleScroll, { passive: true });
        handleScroll();

        if (toTopBtn && !toTopBtn.hasAttribute("data-top-bound")) {
          toTopBtn.setAttribute("data-top-bound", "true");
          toTopBtn.addEventListener("click", () => {
            window.scrollTo({
              top: 0,
              behavior: "smooth",
            });
          });
        }

        // Глобальна підтримка кнопок копіювання [data-copy] на будь-якій сторінці
        document.querySelectorAll("[data-copy]").forEach((btn) => {
          if (btn.hasAttribute("data-copy-bound")) return;
          btn.setAttribute("data-copy-bound", "true");
          btn.addEventListener("click", async (e) => {
            e.preventDefault();
            e.stopPropagation();
            const val = btn.getAttribute("data-copy") || "";
            if (!val) return;
            try {
              await navigator.clipboard.writeText(val);
              btn.classList.add("copied");
              setTimeout(() => btn.classList.remove("copied"), 2000);
              window.showGlobalToast(`Скопійовано: ${val}`);
            } catch (err) {
              const ta = document.createElement("textarea");
              ta.value = val;
              document.body.appendChild(ta);
              ta.select();
              document.execCommand("copy");
              document.body.removeChild(ta);
              window.showGlobalToast(`Скопійовано: ${val}`);
            }
          });
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initGlobalLayoutControls);
      } else {
        initGlobalLayoutControls();
      }
      document.addEventListener("astro:after-swap", initGlobalLayoutControls);
    </script>
  </body>
</html>
