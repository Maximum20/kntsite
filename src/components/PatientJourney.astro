---
interface Props {
  title?: string;
}
const { title = "Шлях пацієнта" } = Astro.props;
---

<section class="pj">

 <header class="pj__head">
  <h2 class="pj__title">
    Шлях <span class="pj__title-accent">пацієнта</span>
  </h2>
  <p class="pj__sub">Чотири послідовні кроки — персоналізований шлях для кожного пацієнта</p>
</header>

  <div class="pj__feed">

    <!-- ── КРОК 1 ── -->
    <article class="pj__card">
      <div class="pj__card-media">
        <div class="pj__icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <span class="pj__tag">Крок 1</span>
      </div>
      <div class="pj__card-body">
        <h3 class="pj__card-title">Первинна консультація та Консиліум</h3>
        <p class="pj__card-text">Команда фахівців визначає тактику лікування. На цьому етапі може бути призначено:</p>
        <ul class="pj__pills">
          <li class="pj__pill">Хірургія</li>
          <li class="pj__pill">Гормонотерапія</li>
          <li class="pj__pill">Хіміотерапія</li>
          <li class="pj__pill pj__pill--accent">Променева терапія</li>
        </ul>
      </div>
    </article>

    <div class="pj__flow-sep" aria-hidden="true">
      <div class="pj__flow-line"></div>
      <svg class="pj__flow-arrow" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <div class="pj__flow-line"></div>
    </div>

    <!-- ── КРОК 2 ── -->
    <article class="pj__card pj__card--flip">
      <div class="pj__card-media">
        <div class="pj__icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="10"/>
            <circle cx="12" cy="12" r="6"/>
            <circle cx="12" cy="12" r="2"/>
          </svg>
        </div>
        <span class="pj__tag">Крок 2</span>
      </div>
      <div class="pj__card-body">
        <h3 class="pj__card-title">КТ-розмітка</h3>
        <p class="pj__card-text">Підготовка до опромінення. Формуємо 3D‑план на основі індивідуальної анатомії пацієнта — точна карта лікування, унікальна для кожного.</p>
      </div>
    </article>

    <div class="pj__flow-sep" aria-hidden="true">
      <div class="pj__flow-line"></div>
      <svg class="pj__flow-arrow" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <div class="pj__flow-line"></div>
    </div>

    <!-- ── КРОК 3 ── -->
    <article class="pj__card">
      <div class="pj__card-media">
        <div class="pj__icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
          </svg>
        </div>
        <span class="pj__tag">Крок 3</span>
      </div>
      <div class="pj__card-body">
        <h3 class="pj__card-title">Етап лікування (Методи)</h3>
        <p class="pj__card-text">Залежно від рішення консиліуму, пацієнт направляється в одне з відділень:</p>
        <div class="pj__methods">
          <div class="pj__method">
            <input type="radio" id="m1" name="method" class="pj__radio">
            <label for="m1" class="pj__method-label">
              <div class="pj__method-row">
                <div class="pj__method-check">
                  <svg viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/><circle class="pj__check-fill" cx="8" cy="8" r="3.5" fill="currentColor"/></svg>
                </div>
                <span class="pj__method-name">Мегавольтна терапія</span>
                <svg class="pj__method-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
              </div>
              <div class="pj__method-detail">
                <p>3 лінійні прискорювачі <strong>Elekta</strong>. Дистанційне опромінення пухлин будь-якої локалізації.</p>
              </div>
            </label>
          </div>
          <div class="pj__method">
            <input type="radio" id="m2" name="method" class="pj__radio">
            <label for="m2" class="pj__method-label">
              <div class="pj__method-row">
                <div class="pj__method-check">
                  <svg viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/><circle class="pj__check-fill" cx="8" cy="8" r="3.5" fill="currentColor"/></svg>
                </div>
                <span class="pj__method-name">Гамма-терапія</span>
                <svg class="pj__method-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
              </div>
              <div class="pj__method-detail">
                <p>Апарати <strong>Агат</strong> та <strong>Тератрон</strong>. Класична дистанційна променева терапія.</p>
              </div>
            </label>
          </div>
          <div class="pj__method">
            <input type="radio" id="m3" name="method" class="pj__radio">
            <label for="m3" class="pj__method-label">
              <div class="pj__method-row">
                <div class="pj__method-check">
                  <svg viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/><circle class="pj__check-fill" cx="8" cy="8" r="3.5" fill="currentColor"/></svg>
                </div>
                <span class="pj__method-name">Брахітерапія</span>
                <svg class="pj__method-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
              </div>
              <div class="pj__method-detail">
                <p>Система <strong>Multisource</strong>. Контактне лікування з введенням джерела безпосередньо в зону пухлини.</p>
              </div>
            </label>
          </div>
          <div class="pj__method">
            <input type="radio" id="m4" name="method" class="pj__radio">
            <label for="m4" class="pj__method-label">
              <div class="pj__method-row">
                <div class="pj__method-check">
                  <svg viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/><circle class="pj__check-fill" cx="8" cy="8" r="3.5" fill="currentColor"/></svg>
                </div>
                <span class="pj__method-name">Близькофокусна терапія</span>
                <svg class="pj__method-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
              </div>
              <div class="pj__method-detail">
                <p>Лікування раку шкіри та поверхневих новоутворень.</p>
              </div>
            </label>
          </div>
        </div>
      </div>
    </article>

    <div class="pj__flow-sep" aria-hidden="true">
      <div class="pj__flow-line"></div>
      <svg class="pj__flow-arrow" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <div class="pj__flow-line"></div>
    </div>

    <!-- ── КРОК 4 ── -->
    <article class="pj__card pj__card--flip">
      <div class="pj__card-media">
        <div class="pj__icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
        </div>
        <span class="pj__tag">Крок 4</span>
      </div>
      <div class="pj__card-body">
        <h3 class="pj__card-title">Реабілітація</h3>
        <p class="pj__card-text">Можливий індивідуальний курс, спрямований на мінімізацію побічних ефектів та швидке повернення до звичного життя. Використовуємо <strong>магнітотерапію</strong> для прискореної регенерації тканин та естетичної корекції рубців.</p>
      </div>
    </article>

  </div>
</section>

<style>
  *, *::before, *::after { box-sizing: border-box; }

  :root {
    --teal:      #0D9488;
    --teal-dark: #0F766E;
    --teal-glow: rgba(13,148,136,.15);
    --teal-lt:   #F0FDF9;
    --teal-ring: rgba(13,148,136,.1);
    --sky:       #0891B2;
    --ink:       #0F172A;
    --slate:     #334155;
    --muted:     #64748B;
    --line:      #E2E8F0;
    --white:     #FFFFFF;
    --card-r:    22px;
  }

  /* ─── WRAPPER ─── */
  .pj {
    background: transparent;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 2rem 5rem;
  }

 





.pj__head {
  text-align: left;
  margin-bottom: 4rem;
  /* Додай невеликий відступ зліва, щоб заголовок був на одній лінії з картками */
  padding-left: 1rem; 
}

.pj__title {
  display: block; /* Повертаємо слова в один рядок */
  font-size: clamp(2.5rem, 6vw, 4rem);
  font-weight: 800;
  line-height: 1.2;
  margin: 0 0 1.5rem;
  letter-spacing: -0.03em;
}

.pj__title-main {
  color: var(--ink);
  margin-right: 0.2em; /* Відступ між словами */
}

.pj__title-accent {
  position: relative;
  display: inline-block;
  background: linear-gradient(135deg, var(--teal) 0%, var(--sky) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Ота сама товста лінія, як у референсі */
.pj__title-accent::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -6px; /* Відстань від тексту до лінії */
  width: 65px;   /* Коротша лінія, як на фото */
  height: 5px;   /* Товщина */
  background: #0066FF; /* Яскраво-синій акцент */
  border-radius: 4px;
}

.pj__sub {
  text-align: left;
  margin: 0; /* Прибираємо margin: auto, щоб текст не тікав */
  font-size: 1.05rem;
  color: var(--muted);
  max-width: 500px;
  line-height: 1.6;
}

/* Для мобілок */
@media (max-width: 768px) {
  .pj__head {
    padding-left: 0;
    margin-bottom: 3rem;
  }
  .pj__title {
    font-size: 2.5rem;
  }
  .pj__title-accent::after {
    width: 45px;
    height: 4px;
  }
}









  .pj__sub {
  font-size: 1.125rem;
  font-weight: 450;
  color: var(--muted);
  line-height: 1.6;
  max-width: 600px;
  margin: 0 auto 3rem;
  opacity: 0.9;
}

  /* step crumbs */
  .pj__crumbs {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .625rem 1.25rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 100px;
    flex-wrap: wrap;
    justify-content: center;
    animation: up .6s .24s ease both;
  }

  .pj__crumb {
    font-size: .8125rem;
    font-weight: 600;
    color: var(--slate);
  }

  .pj__crumb-sep {
    width: 14px;
    height: 14px;
    color: var(--line);
    flex-shrink: 0;
  }

  /* ─── FEED ─── */
  .pj__feed {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  /* ─── CARD ─── */
  .pj__card {
    display: flex;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
    width: 100%;
    align-items: center;
    padding: 2.75rem 3rem;
    background: linear-gradient(155deg, var(--white) 0%, #f7fffe 100%);
    justify-content: flex-start;
    border-radius: var(--card-r);
    /* gradient border via pseudo-element */
    position: relative;
    box-shadow:
      0 4px 24px rgba(0,0,0,.04),
      0 1px 3px rgba(0,0,0,.04);
    transition: box-shadow .4s ease, transform .4s cubic-bezier(.34,1.56,.64,1);
    animation: up .6s ease both;
  }

  /* gradient border */
  .pj__card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--card-r);
    padding: 1.5px;
    background: linear-gradient(
      135deg,
      rgba(13,148,136,.35) 0%,
      rgba(8,145,178,.2) 50%,
      rgba(13,148,136,.06) 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    transition: opacity .4s ease;
  }

  .pj__card:hover {
    transform: translateY(-5px);
    box-shadow:
      0 20px 60px var(--teal-glow),
      0 4px 12px rgba(0,0,0,.04);
  }

  .pj__card:hover::before {
    background: linear-gradient(
      135deg,
      rgba(13,148,136,.6) 0%,
      rgba(8,145,178,.4) 50%,
      rgba(13,148,136,.15) 100%
    );
  }

  /* flip layout for even cards */
  .pj__card--flip .pj__card-media { order: 2; }
  .pj__card--flip .pj__card-body  { order: 1; }

  /* ─── MEDIA COLUMN ─── */
  .pj__card-media {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  /* icon ring — padding gives space so the hover transform never touches any overflow boundary */
  .pj__icon-wrap {
    padding: 16px;
  }

  .pj__icon-wrap > svg {
    display: none; /* overridden below */
  }

  /* the actual visual icon circle */
  .pj__icon-wrap {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: linear-gradient(145deg, var(--teal) 0%, var(--sky) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    box-shadow:
      0 0 0 10px var(--teal-ring),
      0 0 0 20px rgba(13,148,136,.04),
      0 8px 28px rgba(13,148,136,.3);
    transition: transform .45s cubic-bezier(.34,1.56,.64,1),
                box-shadow .45s ease;
    flex-shrink: 0;
  }

  .pj__icon-wrap svg {
    display: block;
    width: 44px;
    height: 44px;
    stroke: white;
  }

  .pj__card:hover .pj__icon-wrap {
    transform: rotate(-8deg) scale(1.1);
    box-shadow:
      0 0 0 14px var(--teal-ring),
      0 0 0 26px rgba(13,148,136,.04),
      0 14px 36px rgba(13,148,136,.38);
  }

  .pj__tag {
    font-size: .7rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--teal);
    background: var(--teal-lt);
    border: 1px solid rgba(13,148,136,.18);
    border-radius: 100px;
    padding: .3rem .8rem;
  }

 .pj__card-body {
  flex: 1;           /* Змушує блок розтягуватися на весь доступний простір */
  min-width: 0;      /* Запобігає переповненню */
  max-width: 600px;  /* ЗБІЛЬШ ЦЕ ЗНАЧЕННЯ (або постав 100%, якщо треба на всю ширину) */
  width: 100%;       /* Додатково підштовхує до розтягування */
}

  .pj__card-title {
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    font-weight: 800;
    color: var(--ink);
    letter-spacing: -.02em;
    line-height: 1.25;
    margin: 0 0 .875rem;
  }

 .pj__card-text {
  font-size: .9375rem;
  color: var(--muted);
  line-height: 1.75;
  margin: 0;
  max-width: 100% !important; /* Гарантує, що текст не затиснутий десь у 300px */
}

  .pj__card-text strong { color: var(--slate); }

  /* ─── PILLS (step 1) ─── */
  .pj__pills {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }

  .pj__pill {
    padding: .45rem .9rem;
    font-size: .8125rem;
    font-weight: 600;
    color: var(--muted);
    background: var(--white);
    border: 1.5px solid var(--line);
    border-radius: 8px;
    transition: all .22s ease;
  }

  .pj__pill:hover {
    border-color: #cbd5e1;
    background: #f8fafc;
    transform: translateY(-2px);
  }

  .pj__pill--accent {
    color: var(--teal);
    background: var(--teal-lt);
    border-color: rgba(13,148,136,.25);
    font-weight: 700;
  }

  /* ─── METHODS (step 3) ─── */
  .pj__methods {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }

  .pj__method { position: relative; }

  .pj__radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .pj__method-label {
    display: block;
    border: 1.5px solid var(--line);
    border-radius: 12px;
    background: var(--white);
    cursor: pointer;
    overflow: hidden;
    transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease;
  }

  .pj__method-label:hover {
    border-color: rgba(13,148,136,.4);
    box-shadow: 0 4px 16px rgba(13,148,136,.08);
    transform: translateX(5px);
  }

  .pj__radio:checked + .pj__method-label {
    border-color: var(--teal);
    box-shadow: 0 6px 20px rgba(13,148,136,.14);
    transform: none;
  }

  .pj__method-row {
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: .875rem 1.125rem;
  }

  .pj__method-check {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--line);
    transition: color .3s ease;
  }

  .pj__method-check .pj__check-fill { opacity: 0; transition: opacity .3s ease; }

  .pj__radio:checked + .pj__method-label .pj__method-check { color: var(--teal); }
  .pj__radio:checked + .pj__method-label .pj__check-fill { opacity: 1; }

  .pj__method-name {
    flex: 1;
    font-size: .9rem;
    font-weight: 700;
    color: var(--ink);
  }

  .pj__method-chevron {
    width: 17px;
    height: 17px;
    stroke: #94A3B8;
    flex-shrink: 0;
    transition: transform .35s cubic-bezier(.34,1.56,.64,1), stroke .25s;
  }

  .pj__method-label:hover .pj__method-chevron { stroke: var(--teal); }
  .pj__radio:checked + .pj__method-label .pj__method-chevron {
    stroke: var(--teal);
    transform: rotate(90deg);
  }

  .pj__method-detail {
    max-height: 0;
    overflow: hidden;
    transition: max-height .4s cubic-bezier(.4,0,.2,1);
  }

  .pj__radio:checked + .pj__method-label .pj__method-detail {
    max-height: 100px;
    border-top: 1px solid rgba(13,148,136,.1);
  }

  .pj__method-detail p {
    padding: .875rem 1.125rem .875rem 3.125rem;
    margin: 0;
    font-size: .85rem;
    color: var(--muted);
    line-height: 1.65;
    animation: fadeIn .3s ease;
  }

  .pj__method-detail strong { color: var(--slate); }

  /* ─── FLOW SEPARATORS ─── */
  .pj__flow-sep {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: .5rem 0;
  }

  .pj__flow-line {
    width: 1.5px;
    height: 18px;
    background: linear-gradient(to bottom, rgba(13,148,136,.2), rgba(13,148,136,.08));
  }






@media (max-width: 768px) {
  .pj__card, 
  .pj__card--flip {
    flex-direction: column !important;
    align-items: center; /* Центрує іконку та блоки по горизонталі */
    gap: 1.5rem;
    padding: 2rem 1.5rem;
  }

  .pj__card-body {
    width: 100%;
    max-width: 100% !important;
  }

  /* Центруємо лише заголовок */
  .pj__card-title {
    text-align: center;
    width: 100%;
  }

  /* Текст залишаємо по лівому краю */
