---
export const prerender = true;

import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import ImagePlaceholder from "../../components/ImagePlaceholder.astro";
import { siteSettings } from "../../data";
import { resolvePhotoUrl } from "../../utils/photos";

export async function getStaticPaths() {
  const newsEntries = await getCollection("news");
  return newsEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
if (!entry) return Astro.redirect("/all-news");
const { Content } = await render(entry);

const rawImg = entry.data.image;
const isStringImg = typeof rawImg === "string";
const resolvedStringImg = isStringImg
  ? resolvePhotoUrl(rawImg, null, siteSettings.hideLegacyPhotos)
  : null;
const hasAssetImg = Boolean(rawImg && !isStringImg);

const wordsPerMinute = 200;
const words = entry.body ? entry.body.split(/\s+/g).length : 0;
const readingTime = Math.max(1, Math.ceil(words / wordsPerMinute));
---

<Layout title={entry.data.title} description={entry.data.description}>
  <div
    id="progress-bar"
    class="fixed top-0 left-0 h-1.5 bg-gradient-to-r from-blue-600 to-cyan-400 z-50 transition-all duration-150 w-0 shadow-[0_0_10px_rgba(37,99,235,0.3)]"
  ></div>

  <main class="max-w-6xl mx-auto px-5 py-10 md:py-16 font-sans relative">
    <div class="flex justify-between items-center mb-10 gap-4">
      <a
        href="/all-news"
        class="inline-flex items-center gap-2 text-slate-500 hover:text-blue-600 transition-colors font-bold text-xs uppercase tracking-widest group"
      >
        <Icon name="bx:left-arrow-alt" class="w-5 h-5 group-hover:-translate-x-1 transition-transform" />
        Назад до списку новин
      </a>

      <div class="flex items-center gap-2 bg-white/70 backdrop-blur-sm px-4 py-1.5 rounded-full border border-slate-100 shadow-xs text-slate-500 font-bold text-[10px] uppercase tracking-tighter shrink-0">
        <Icon name="bx:time-five" class="w-4 h-4 text-blue-500" />
        <span>~ {readingTime} хв читання</span>
      </div>
    </div>

    <header class="grid md:grid-cols-[1fr_1.2fr] gap-8 md:gap-16 items-start mb-16">
      <div class="rounded-[2.5rem] overflow-hidden shadow-2xl border-4 border-white bg-sky-50 relative group">
        {hasAssetImg ? (
          <Image
            src={rawImg as any}
            alt={entry.data.title}
            class="w-full max-h-[500px] md:max-h-[600px] object-cover transition-transform duration-700 group-hover:scale-105"
          />
        ) : resolvedStringImg ? (
          <img
            src={resolvedStringImg}
            alt={entry.data.title}
            class="w-full max-h-[500px] md:max-h-[600px] object-cover transition-transform duration-700 group-hover:scale-105"
          />
        ) : (
          <div class="aspect-[16/10] w-full">
            <ImagePlaceholder
              variant="news"
              title={entry.data.title}
              subtitle={entry.data.category || "Новина"}
              size="lg"
            />
          </div>
        )}
      </div>

      <div class="flex flex-col">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="px-3 py-1 bg-blue-50 text-blue-600 text-[10px] font-black uppercase tracking-widest rounded-lg">
            {entry.data.category || "Новина"}
          </span>
          <time class="text-slate-400 font-black uppercase text-xs tracking-[0.2em]">
            {entry.data.date ? entry.data.date.toLocaleDateString("uk-UA") : ""}
          </time>
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 leading-[1.1] tracking-tight mb-8">
          {entry.data.title}
        </h1>

        {entry.data.description && (
          <div class="bg-blue-50/40 border-l-4 border-blue-500 p-6 md:p-8 rounded-r-[2rem] mb-6">
            <p class="text-lg md:text-xl text-slate-700 leading-relaxed italic font-medium">
              {entry.data.description}
            </p>
          </div>
        )}

        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {entry.data.tags.map((tag: string) => (
              <span class="text-xs font-bold text-slate-600 bg-white border border-slate-200 px-3 py-1 rounded-full">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="flex flex-col items-center gap-4 mb-16 animate-bounce opacity-80">
      <span class="text-xs uppercase font-black tracking-[0.3em] text-blue-600">Розповідаємо детально</span>
      <Icon name="bx:chevron-down" class="w-7 h-7 text-blue-600" />
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="article-box relative">
        <article
          class="prose prose-slate prose-lg max-w-none
          prose-headings:text-slate-900 prose-headings:font-bold prose-headings:leading-tight
          prose-strong:text-blue-900 prose-strong:font-black
          prose-img:rounded-[2rem] prose-img:shadow-xl
          prose-a:text-blue-600 prose-a:font-bold hover:prose-a:underline"
        >
          <Content />
        </article>

        <div class="mt-24 pt-16 border-t border-slate-100 flex flex-col items-center text-center article-box-child">
          <div class="hug-card-trigger w-20 h-20 rounded-[2rem] bg-gradient-to-br from-blue-500 to-cyan-400 flex items-center justify-center text-white shadow-xl shadow-blue-200/50 mb-8 rotate-6 hover:rotate-0 transition-all duration-500 cursor-pointer group relative overflow-hidden active:scale-95">
            <div class="heart-layer absolute inset-0 flex items-center justify-center transition-all duration-300">
              <Icon name="bx:bxs-heart" class="w-10 h-10 group-hover:scale-110 transition-transform" />
            </div>
            <div class="hug-layer absolute inset-0 flex items-center justify-center text-5xl opacity-0 scale-50 transition-all duration-300 leading-none">
              🤗
            </div>
          </div>

          <div class="space-y-3">
            <h2 class="text-xl md:text-2xl font-black uppercase tracking-[0.2em] text-slate-900 leading-tight">
              Ваше відділення <br class="md:hidden" /> променевої терапії
            </h2>
            <div class="flex items-center justify-center gap-3">
              <span class="h-px w-8 bg-blue-200"></span>
              <p class="text-xs md:text-sm text-blue-500 font-bold uppercase tracking-[0.15em] italic">
                Працюємо заради вашого здоров'я
              </p>
              <span class="h-px w-8 bg-blue-200"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  :root {
    --font-primary: "Inter Variable", ui-sans-serif, system-ui;
  }

  .article-box article > * {
    font-family: var(--font-primary) !important;
    background-color: #fcfdfe;
    border-radius: 1.5rem;
    padding: 1.75rem 2.5rem !important;
    border: 1px solid #f1f5f9;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -2px rgba(0, 0, 0, 0.02);
    margin-bottom: 2.5rem !important;
    position: relative;
  }

  .article-box article p {
    line-height: 1.9 !important;
    color: #334155 !important;
    font-size: 1.125rem;
    white-space: pre-line;
    margin-bottom: 0 !important;
  }

  .article-box article p::before,
  .article-box article p::after {
    content: "";
    position: absolute;
    top: 1.75rem;
    bottom: 1.75rem;
    width: 3px;
    background-color: #93c5fd;
    border-radius: 999px;
  }

  .article-box article p::before {
    left: 1.25rem;
  }
  .article-box article p::after {
    right: 1.25rem;
  }

  .article-box .article-box-child {
    background-color: transparent !important;
    box-shadow: none !important;
    border: none !important;
    padding: 0 !important;
    margin-bottom: 0 !important;
  }

  .article-box article strong {
    color: #0f172a;
    background: linear-gradient(180deg, transparent 70%, #dbeafe 0);
  }
</style>

<script>
  function initArticlePage() {
    const progressBar = document.getElementById("progress-bar");

    window.addEventListener(
      "scroll",
      () => {
        const st = window.pageYOffset || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        const scrolled = height > 0 ? (st / height) * 100 : 0;
        if (progressBar) progressBar.style.width = `${scrolled}%`;
      },
      { passive: true }
    );

    const cards = document.querySelectorAll<HTMLElement>(".hug-card-trigger");
    cards.forEach((card) => {
      const heart = card.querySelector<HTMLElement>(".heart-layer");
      const hug = card.querySelector<HTMLElement>(".hug-layer");

      if (heart && hug) {
        card.addEventListener("click", () => {
          heart.style.opacity = "0";
          heart.style.transform = "scale(0)";
          hug.style.opacity = "1";
          hug.style.transform = "scale(1.3)";

          setTimeout(() => {
            heart.style.opacity = "1";
            heart.style.transform = "scale(1)";
            hug.style.opacity = "0";
            hug.style.transform = "scale(0.5)";
          }, 1500);
        });
      }
    });
  }

  initArticlePage();
  document.addEventListener("astro:after-swap", initArticlePage);
</script>
