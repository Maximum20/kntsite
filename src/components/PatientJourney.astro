---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { patientRouteData, equipmentData, siteSettings } from "../data";
import ImagePlaceholder from "./ImagePlaceholder.astro";
import { resolvePhotoUrl } from "../utils/photos";

interface Props {
  title?: string;
  showJourney?: boolean;
  showEquipment?: boolean;
  showFaq?: boolean;
}
const {
  title = patientRouteData.title || "Шлях пацієнта",
  showJourney = true,
  showEquipment = true,
  showFaq = true,
} = Astro.props;

const allServices = (await getCollection("services")) || [];
const visibleServices = allServices
  .filter((s) => s.data?.isVisible !== false)
  .sort((a, b) => (a.data?.order ?? 99) - (b.data?.order ?? 99));
const visibleServiceIds = new Set(visibleServices.map((s) => s.id));

const treatmentDescriptions: Record<string, { label: string; summary: string }> = {
  linac: {
    label: "Мегавольтна терапія (Versa HD + BrainLAB)",
    summary:
      "3 лінійні прискорювачі Elekta та система навігації BrainLAB. Дистанційне високоточне опромінення (IMRT, VMAT, IGRT, SBRT).",
  },
  gamma: {
    label: "Гамма-терапія",
    summary:
      "Апарати Theratron Elite 80 та АГАТ-Р1. Надійна класична дистанційна променева терапія.",
  },
  brachy: {
    label: "Брахітерапія",
    summary:
      "Система MultiSource HDR. Контактне лікування з підведенням джерела безпосередньо в зону пухлини.",
  },
  nearfocus: {
    label: "Близькофокусна рентгенотерапія",
    summary:
      "Безопераційне лікування новоутворень шкіри та поверхневих патологій.",
  },
};

const step3Services = visibleServices
  .filter((s) => s.id !== "ct" && s.id !== "mlt")
  .map((s) => ({
    id: s.id,
    label: treatmentDescriptions[s.id]?.label || s.data.title,
    summary: treatmentDescriptions[s.id]?.summary || s.data.description || s.data.heroText || "",
  }));

const checklistItems = patientRouteData.checklistItems || [];
const methods = equipmentData.methods || [];
const accelerators = equipmentData.accelerators || [];
const faqItems = equipmentData.faq || [];
const hasAnySection = showJourney || showEquipment || showFaq;
---

{hasAnySection && (
<section class="pj" id="patient-journey">
  {showJourney && (
    <>
  <header class="pj__head">
    <h2 class="pj__title">
      Шлях <span class="pj__title-accent">пацієнта</span>
    </h2>
    <p class="pj__sub">{patientRouteData.subtitle}</p>
  </header>

  <div class="pj__feed">
    <!-- ── КРОК 1 ── -->
    <article class="pj__card">
      <div class="pj__card-media">
        <div class="pj__icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <span class="pj__tag">Крок 1</span>
      </div>
      <div class="pj__card-body">
        <h3 class="pj__card-title">Первинна консультація та Консиліум</h3>
        <p class="pj__card-text">
          Звернення за електронним направленням (безоплатно за програмою НСЗУ). Мультидисциплінарна команда визначає персональну тактику лікування:
        </p>
        <ul class="pj__pills">
          <li class="pj__pill">Хірургія</li>
          <li class="pj__pill">Гормонотерапія</li>
          <li class="pj__pill">Хіміотерапія</li>
          <li class="pj__pill pj__pill--accent">Променева терапія</li>
        </ul>
      </div>
    </article>

    <div class="pj__flow-sep" aria-hidden="true">
      <div class="pj__flow-line"></div>
      <svg class="pj__flow-arrow" viewBox="0 0 24 24" fill="none">
        <path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <div class="pj__flow-line"></div>
    </div>

    <!-- ── КРОК 2 ── -->
    <article class="pj__card pj__card--flip">
      <div class="pj__card-media">
        <div class="pj__icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="10"></circle>
            <circle cx="12" cy="12" r="6"></circle>
            <circle cx="12" cy="12" r="2"></circle>
          </svg>
        </div>
        <span class="pj__tag">Крок 2</span>
      </div>
      <div class="pj__card-body">
        <h3 class="pj__card-title">КТ-розмітка та 3D-планування</h3>
        <p class="pj__card-text">
          Підготовка до опромінення на томографі <strong>Toshiba Aquilion</strong>. Виготовляються індивідуальні фіксуючі маски/матраци, а лікарі та медичні фізики у системі <strong>Monaco</strong> формують прецизійний 3D-план із захистом здорових органів.
        </p>
        {visibleServiceIds.has("ct") && (
          <div class="mt-4">
            <a href="/services/ct" class="inline-flex items-center gap-1.5 text-xs font-bold text-teal-700 hover:text-teal-900 underline underline-offset-4">
              <span>Детальніше про КТ-розмітку</span>
              <Icon name="bx:right-arrow-alt" class="w-4 h-4" />
            </a>
          </div>
        )}
      </div>
    </article>

    <div class="pj__flow-sep" aria-hidden="true">
      <div class="pj__flow-line"></div>
      <svg class="pj__flow-arrow" viewBox="0 0 24 24" fill="none">
        <path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <div class="pj__flow-line"></div>
    </div>

    <!-- ── КРОК 3 ── -->
    <article class="pj__card">
      <div class="pj__card-media">
        <div class="pj__icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
          </svg>
        </div>
        <span class="pj__tag">Крок 3</span>
      </div>
      <div class="pj__card-body">
        <h3 class="pj__card-title">Етап лікування (Сеанси терапії)</h3>
        <p class="pj__card-text">
          Залежно від локалізації та рішення консиліуму, пацієнт проходить курс в одному з підрозділів:
        </p>
        {step3Services.length > 0 && (
          <div class="pj__methods">
            {step3Services.map((svc, idx) => (
              <div class="pj__method">
                <input type="radio" id={`m-${svc.id}`} name="method" class="pj__radio" checked={idx === 0} />
                <label for={`m-${svc.id}`} class="pj__method-label">
                  <div class="pj__method-row">
                    <div class="pj__method-check">
                      <svg viewBox="0 0 16 16" fill="none">
                        <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"></circle>
                        <circle class="pj__check-fill" cx="8" cy="8" r="3.5" fill="currentColor"></circle>
                      </svg>
                    </div>
                    <span class="pj__method-name">{svc.label}</span>
                    <svg class="pj__method-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M9 18l6-6-6-6"></path>
                    </svg>
                  </div>
                  <div class="pj__method-detail">
                    <p>
                      {svc.summary}{" "}
                      <a href={`/services/${svc.id}`} class="text-teal-700 font-bold underline">Перейти →</a>
                    </p>
                  </div>
                </label>
              </div>
            ))}
          </div>
        )}
      </div>
    </article>

    <div class="pj__flow-sep" aria-hidden="true">
      <div class="pj__flow-line"></div>
      <svg class="pj__flow-arrow" viewBox="0 0 24 24" fill="none">
        <path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <div class="pj__flow-line"></div>
    </div>

    <!-- ── КРОК 4 ── -->
    <article class="pj__card pj__card--flip">
      <div class="pj__card-media">
        <div class="pj__icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>
        <span class="pj__tag">Крок 4</span>
      </div>
      <div class="pj__card-body">
        <h3 class="pj__card-title">Реабілітація та супровід</h3>
        <p class="pj__card-text">
          Індивідуальний курс відновлення, спрямований на мінімізацію побічних ефектів та швидке повернення до звичного життя. Використовуємо <strong>магнітотерапію</strong> для прискореної регенерації тканин.
        </p>
        {visibleServiceIds.has("mlt") && (
          <div class="mt-4">
            <a href="/services/mlt" class="inline-flex items-center gap-1.5 text-xs font-bold text-teal-700 hover:text-teal-900 underline underline-offset-4">
              <span>Детальніше про реабілітацію</span>
              <Icon name="bx:right-arrow-alt" class="w-4 h-4" />
            </a>
          </div>
        )}
      </div>
    </article>
  </div>

  
    </>
  )}

  {/* ── БЛОК ОБЛАДНАННЯ ТА МЕТОДИК ЛІКУВАННЯ (IMRT, VMAT, IGRT, SBRT) З KEYSTATIC ── */}
  {showEquipment && (methods.length > 0 || accelerators.length > 0) && (
    <div id="methods-section" class="mt-20 scroll-mt-32">
      <div class="mb-10">
        <span class="inline-block text-blue-600 font-black uppercase tracking-[0.2em] text-xs mb-2">
          Високоточні технології та обладнання
        </span>
        <h3 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Сучасні методики <span class="text-blue-600">опромінення</span>
        </h3>
        {equipmentData.sectionSubtitle && (
          <p class="text-sm sm:text-base text-slate-600 mt-2 max-w-3xl leading-relaxed">
            {equipmentData.sectionSubtitle}
          </p>
        )}
      </div>

      {methods.length > 0 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {methods.map((m) => (
            <div class="bg-white/85 backdrop-blur-md border border-slate-200/80 rounded-3xl p-6 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 mb-4">
                  <span class="px-3 py-1 rounded-xl bg-blue-600 text-white font-black text-sm tracking-wider">
                    {m.code}
                  </span>
                  {m.badge && (
                    <span class="text-[10px] font-bold text-teal-700 bg-teal-50 px-2.5 py-1 rounded-lg">
                      {m.badge}
                    </span>
                  )}
                </div>
                <h4 class="font-bold text-slate-900 text-base mb-2 leading-snug">{m.title}</h4>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{m.description}</p>
              </div>
              {visibleServiceIds.has("linac") && (
                <div class="mt-5 pt-3 border-t border-slate-100">
                  <a href="/services/linac" class="inline-flex items-center gap-1 text-xs font-bold text-blue-600 hover:text-blue-800">
                    <span>Докладніше про обладнання</span>
                    <Icon name="bx:chevron-right" class="w-4 h-4" />
                  </a>
                </div>
              )}
            </div>
          ))}
        </div>
      )}

      {accelerators.length > 0 && (
        <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-5">
          {accelerators.map((acc) => {
            const accImage = resolvePhotoUrl(acc.image, "/hero/versahd.jpg", siteSettings.hideLegacyPhotos);
            return (
              <div class="bg-white/90 border border-slate-200/80 rounded-3xl overflow-hidden shadow-md flex flex-col">
                <div class="aspect-[16/10] bg-sky-50 overflow-hidden">
                  {accImage ? (
                    <img
                      src={accImage}
                      alt={acc.name}
                      width="600"
                      height="375"
                      loading="lazy"
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <ImagePlaceholder
                      variant="department"
                      title={acc.name}
                      subtitle="Лінійний прискорювач"
                      icon="⚡"
                      size="md"
                    />
                  )}
                </div>
                <div class="p-5 flex flex-col flex-1">
                  <h4 class="font-extrabold text-slate-900 text-lg mb-2">{acc.name}</h4>
                  {acc.imaging && (
                    <p class="text-xs font-bold text-blue-700 bg-blue-50 px-3 py-1.5 rounded-xl mb-2">
                      Візуалізація: {acc.imaging}
                    </p>
                  )}
                  {acc.controlSystem && (
                    <p class="text-xs font-bold text-teal-700 bg-teal-50 px-3 py-1.5 rounded-xl mb-2">
                      Контроль: {acc.controlSystem}
                    </p>
                  )}
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mt-1">{acc.description}</p>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  )}

  {/* ── ПОШИРЕНІ ЗАПИТАННЯ ПАЦІЄНТІВ (FAQ З KEYSTATIC) ── */}
  {showFaq && faqItems.length > 0 && (
    <div id="faq-section" class="mt-20 scroll-mt-32">
      <div class="mb-10">
        <span class="inline-block text-teal-600 font-black uppercase tracking-[0.2em] text-xs mb-2">
          Відповіді фахівців
        </span>
        <h3 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Поширені <span class="text-teal-600">запитання пацієнтів</span>
        </h3>
      </div>

      <div class="space-y-3.5">
        {faqItems.map((item, idx) => (
          <details
            class="group bg-white/90 border border-slate-200/80 rounded-2xl overflow-hidden shadow-xs open:shadow-md open:border-teal-300 transition-all"
            open={idx === 0}
          >
            <summary class="flex items-center justify-between gap-4 p-5 sm:p-6 cursor-pointer list-none hover:bg-slate-50/70 transition-colors">
              <div class="flex items-center gap-3 min-w-0">
                <span class="px-2.5 py-1 rounded-lg bg-teal-50 text-teal-700 text-[10px] font-black uppercase tracking-wider shrink-0">
                  {item.category || "Питання"}
                </span>
                <span class="font-bold text-slate-900 text-sm sm:text-lg leading-snug">
                  {item.question}
                </span>
              </div>
              <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center group-open:rotate-180 group-open:bg-teal-600 group-open:text-white transition-all shrink-0">
                <Icon name="bx:chevron-down" class="w-5 h-5" />
              </div>
            </summary>
            <div class="px-5 sm:px-6 pb-6 pt-2 text-sm sm:text-base text-slate-600 leading-relaxed border-t border-slate-100">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  )}
</section>
)}

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    --teal: #0d9488;
    --teal-dark: #0f766e;
    --teal-glow: rgba(13, 148, 136, 0.15);
    --teal-lt: #f0fdf9;
    --teal-ring: rgba(13, 148, 136, 0.1);
    --sky: #0891b2;
    --ink: #0f172a;
    --slate: #334155;
    --muted: #64748b;
    --line: #e2e8f0;
    --white: #ffffff;
    --card-r: 22px;
  }

  .pj {
    background: transparent;
    font-family: "Inter Variable", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    max-width: 1140px;
    margin: 0 auto;
    padding: 4rem 1.5rem 5rem;
  }

  .pj__head {
    text-align: left;
    margin-bottom: 3.5rem;
    padding-left: 0.5rem;
  }

  .pj__title {
    display: block;
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1.25rem;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .pj__title-accent {
    position: relative;
    display: inline-block;
    background: linear-gradient(135deg, var(--teal) 0%, var(--sky) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .pj__title-accent::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 65px;
    height: 5px;
    background: #0066ff;
    border-radius: 4px;
  }

  .pj__sub {
    text-align: left;
    margin: 0;
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 620px;
    line-height: 1.6;
  }

  .pj__feed {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .pj__card {
    display: flex;
    gap: 2rem;
    width: 100%;
    align-items: center;
    padding: 2.5rem 2.75rem;
    background: linear-gradient(155deg, var(--white) 0%, #f7fffe 100%);
    justify-content: flex-start;
    border-radius: var(--card-r);
    position: relative;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04), 0 1px 3px rgba(0, 0, 0, 0.04);
    transition: box-shadow 0.4s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .pj__card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--card-r);
    padding: 1.5px;
    background: linear-gradient(
      135deg,
      rgba(13, 148, 136, 0.35) 0%,
      rgba(8, 145, 178, 0.2) 50%,
      rgba(13, 148, 136, 0.06) 100%
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .pj__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 60px var(--teal-glow), 0 4px 12px rgba(0, 0, 0, 0.04);
  }

  .pj__card--flip .pj__card-media {
    order: 2;
  }
  .pj__card--flip .pj__card-body {
    order: 1;
  }

  .pj__card-media {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .pj__icon-wrap {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    background: linear-gradient(145deg, var(--teal) 0%, var(--sky) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    box-shadow: 0 0 0 10px var(--teal-ring), 0 0 0 20px rgba(13, 148, 136, 0.04),
      0 8px 28px rgba(13, 148, 136, 0.3);
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.45s ease;
    flex-shrink: 0;
  }

  .pj__icon-wrap svg {
    display: block;
    width: 42px;
    height: 42px;
    stroke: white;
  }

  .pj__card:hover .pj__icon-wrap {
    transform: rotate(-8deg) scale(1.08);
  }

  .pj__tag {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal);
    background: var(--teal-lt);
    border: 1px solid rgba(13, 148, 136, 0.18);
    border-radius: 100px;
    padding: 0.3rem 0.8rem;
  }

  .pj__card-body {
    flex: 1;
    min-width: 0;
    width: 100%;
  }

  .pj__card-title {
    font-size: clamp(1.3rem, 2.5vw, 1.7rem);
    font-weight: 800;
    color: var(--ink);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0 0 0.75rem;
  }

  .pj__card-text {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.7;
    margin: 0;
  }

  .pj__card-text strong {
    color: var(--slate);
  }

  .pj__pills {
    list-style: none;
    padding: 0;
    margin: 1.1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pj__pill {
    padding: 0.45rem 0.9rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
    background: var(--white);
    border: 1.5px solid var(--line);
    border-radius: 8px;
  }

  .pj__pill--accent {
    color: var(--teal);
    background: var(--teal-lt);
    border-color: rgba(13, 148, 136, 0.25);
    font-weight: 700;
  }

  .pj__methods {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pj__method {
    position: relative;
  }

  .pj__radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .pj__method-label {
    display: block;
    border: 1.5px solid var(--line);
    border-radius: 12px;
    background: var(--white);
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .pj__radio:checked + .pj__method-label {
    border-color: var(--teal);
    box-shadow: 0 6px 20px rgba(13, 148, 136, 0.12);
  }

  .pj__method-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.125rem;
  }

  .pj__method-check {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--line);
  }

  .pj__method-check .pj__check-fill {
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .pj__radio:checked + .pj__method-label .pj__method-check {
    color: var(--teal);
  }
  .pj__radio:checked + .pj__method-label .pj__check-fill {
    opacity: 1;
  }

  .pj__method-name {
    flex: 1;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink);
  }

  .pj__method-chevron {
    width: 17px;
    height: 17px;
    stroke: #94a3b8;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .pj__radio:checked + .pj__method-label .pj__method-chevron {
    stroke: var(--teal);
    transform: rotate(90deg);
  }

  .pj__method-detail {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease;
  }

  .pj__radio:checked + .pj__method-label .pj__method-detail {
    max-height: 120px;
    border-top: 1px solid rgba(13, 148, 136, 0.1);
  }

  .pj__method-detail p {
    padding: 0.85rem 1.125rem 0.85rem 3rem;
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .pj__flow-sep {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 0.4rem 0;
  }

  .pj__flow-line {
    width: 1.5px;
    height: 16px;
    background: linear-gradient(to bottom, rgba(13, 148, 136, 0.25), rgba(13, 148, 136, 0.08));
  }

  .pj__flow-arrow {
    width: 18px;
    height: 18px;
    color: rgba(13, 148, 136, 0.4);
  }

  .pj-check-row.is-checked {
    background-color: #f0fdf4;
    border-color: #86efac;
  }
  .pj-check-row.is-checked .pj-check-title {
    text-decoration: line-through;
    color: #64748b;
  }

  @media (max-width: 768px) {
    .pj {
      padding: 2.5rem 1rem 3.5rem;
    }
    .pj__card,
    .pj__card--flip {
      flex-direction: column !important;
      align-items: center;
      gap: 1.25rem;
      padding: 1.75rem 1.35rem;
    }
    .pj__card-media {
      order: -1 !important;
    }
    .pj__card-title {
      text-align: center;
    }
    .pj__icon-wrap {
      width: 80px;
      height: 80px;
    }
    .pj__icon-wrap svg {
      width: 32px;
      height: 32px;
    }
  }
</style>

<script>
  function initPatientChecklist() {
    const STORAGE_KEY = "dokod_patient_checklist_v1";
    const checkboxes = document.querySelectorAll<HTMLInputElement>(".pj-check-input");
    const counterEl = document.getElementById("pj-checklist-counter");
    const barEl = document.getElementById("pj-checklist-bar");
    const doneEl = document.getElementById("pj-checklist-done");
    const resetBtn = document.getElementById("pj-checklist-reset");
    const printBtn = document.getElementById("pj-checklist-print");

    if (checkboxes.length === 0) return;

    function loadSaved(): Record<string, boolean> {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : {};
      } catch {
        return {};
      }
    }

    function saveState(state: Record<string, boolean>) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch {}
    }

    function refreshUI() {
      const total = checkboxes.length;
      let checkedCount = 0;

      checkboxes.forEach((cb) => {
        const row = cb.closest(".pj-check-row");
        if (cb.checked) {
          checkedCount++;
          row?.classList.add("is-checked");
        } else {
          row?.classList.remove("is-checked");
        }
      });

      const pct = total > 0 ? Math.round((checkedCount / total) * 100) : 0;
      if (counterEl) counterEl.textContent = `${checkedCount} з ${total} (${pct}%)`;
      if (barEl) barEl.style.width = `${pct}%`;
      if (doneEl) {
        doneEl.classList.toggle("hidden", checkedCount < total);
      }
    }

    const saved = loadSaved();
    checkboxes.forEach((cb) => {
      cb.checked = Boolean(saved[cb.value]);
      cb.addEventListener("change", () => {
        const current = loadSaved();
        current[cb.value] = cb.checked;
        saveState(current);
        refreshUI();
      });
    });

    refreshUI();

    resetBtn?.addEventListener("click", () => {
      checkboxes.forEach((cb) => {
        cb.checked = false;
      });
      saveState({});
      refreshUI();
      if (typeof (window as any).showGlobalToast === "function") {
        (window as any).showGlobalToast("Чекліст очищено");
      }
    });

    printBtn?.addEventListener("click", () => {
      window.print();
    });
  }

  initPatientChecklist();
  document.addEventListener("astro:after-swap", initPatientChecklist);
</script>
