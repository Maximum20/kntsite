    function escapeHtml(str) {
      return String(str || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function normalizeStr(str) {
      return String(str || "")
        .toLowerCase()
        .replace(/[ʼ’`]/g, "'")
        .replace(/\s+/g, " ")
        .trim();
    }

    function tokenizeWords(str) {
      const normalized = normalizeStr(str);
      if (!normalized) return [];
      return normalized.split(/[^a-z0-9а-яіїєґёыэъ]+/i).filter(Boolean);
    }

    function convertKeyboardLayout(str, map) {
      let out = "";
      for (let i = 0; i < str.length; i++) {
        const ch = str[i].toLowerCase();
        out += Object.prototype.hasOwnProperty.call(map, ch) ? map[ch] : ch;
      }
      return out;
    }

    // Безпечна відстань редагування (макс. 1 помилка для слів від 4 символів)
    function isWithinEditDistanceOne(a, b) {
      if (a === b) return true;
      const la = a.length;
      const lb = b.length;
      if (Math.abs(la - lb) > 1) return false;
      let i = 0;
      let j = 0;
      let edits = 0;
      while (i < la && j < lb) {
        if (a[i] === b[j]) {
          i++;
          j++;
        } else {
          edits++;
          if (edits > 1) return false;
          if (la > lb) i++;
          else if (lb > la) j++;
          else {
            i++;
            j++;
          }
        }
      }
      if (i < la || j < lb) edits++;
      return edits <= 1;
    }

    function matchesTypoPrefix(tok, word) {
      if (!word || word.length < 4) return false;
      if (isWithinEditDistanceOne(tok, word)) return true;
      if (word.length >= tok.length && isWithinEditDistanceOne(tok, word.slice(0, tok.length))) {
        return true;
      }
      if (
        word.length >= tok.length + 1 &&
        isWithinEditDistanceOne(tok, word.slice(0, tok.length + 1))
      ) {
        return true;
      }
      return false;
    }

    function iconSvgMarkup(iconKey, sizeClass) {
      const paths = ICON_PATHS[iconKey] || ICON_PATHS.building;
      return `<svg class="${sizeClass || "w-[18px] h-[18px]"}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
    }

    // Безпечне підсвічування збігів ДО HTML-екранування (не ламає сутності на кшталт &#39; при 1-літерному пошуку)
    function highlightText(rawText, tokens) {
      const text = String(rawText || "");
      if (!text) return "";
      const uniqueTokens = Array.from(
        new Set(
          (tokens || [])
            .map((t) => String(t || "").trim())
            .filter((t) => t.length >= 1)
        )
      ).sort((a, b) => b.length - a.length);

      if (uniqueTokens.length === 0) return escapeHtml(text);

      // Для 1-літерного пошуку акуратно підсвічуємо збіги на початку слів, щоб не створювати візуальний шум
      if (uniqueTokens.length === 1 && uniqueTokens[0].length === 1) {
        const ch = uniqueTokens[0].replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
        const boundaryRegex = new RegExp(`(^|[^a-z0-9а-яіїєґёыэъ])(${ch})`, "gi");
        let matchedBoundary = false;
        let out = "";
        let lastIdx = 0;
        let m;
        while ((m = boundaryRegex.exec(text)) !== null) {
          matchedBoundary = true;
          const prefixLen = m[1].length;
          const matchStart = m.index + prefixLen;
          if (matchStart > lastIdx) {
            out += escapeHtml(text.slice(lastIdx, matchStart));
          }
          out += `<mark class="search-mark">${escapeHtml(m[2])}</mark>`;
          lastIdx = matchStart + m[2].length;
        }
        if (matchedBoundary) {
          if (lastIdx < text.length) out += escapeHtml(text.slice(lastIdx));
          return out;
        }
      }

      const escapedPattern = uniqueTokens
        .map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"))
        .join("|");
      const regex = new RegExp(`(${escapedPattern})`, "gi");

      let result = "";
      let lastIndex = 0;
      let match;

      while ((match = regex.exec(text)) !== null) {
        if (match.index > lastIndex) {
          result += escapeHtml(text.slice(lastIndex, match.index));
        }
        result += `<mark class="search-mark">${escapeHtml(match[0])}</mark>`;
        lastIndex = regex.lastIndex;
        if (match[0].length === 0) regex.lastIndex++;
      }

      if (lastIndex < text.length) {
        result += escapeHtml(text.slice(lastIndex));
      }

      return result;
    }

    // Попередня індексація токенів для миттєвої роботи пошуку
    const preparedIndex = (searchIndex || []).map((item) => {
      const titleLower = normalizeStr(item.title);
      const subtitleLower = normalizeStr(item.subtitle);
      const titleWords = tokenizeWords(titleLower);
      const subtitleWords = tokenizeWords(subtitleLower);
      const tagsLower = (item.tags || []).map((t) => normalizeStr(t)).filter(Boolean);
      const tagWordSet = new Set();
      tagsLower.forEach((tag) => {
        tokenizeWords(tag).forEach((w) => tagWordSet.add(w));
      });
      const tagWords = Array.from(tagWordSet);
      return {
        item,
        titleLower,
        subtitleLower,
        titleWords,
        subtitleWords,
        tagsLower,
        tagWords,
      };
    });

    function expandSynonyms(cleanQuery, tokens) {
      const expanded = new Set();
      // Для 1-літерних запитів не розмиваємо видачу зайвими синонімами
      if (cleanQuery.length < 2) return expanded;

      for (const group of SYNONYM_GROUPS) {
        let matched = false;
        for (const trig of group.triggers) {
          if (trig.includes(" ")) {
            if (cleanQuery.includes(trig) || (cleanQuery.length >= 4 && trig.startsWith(cleanQuery))) {
              matched = true;
              break;
            }
          } else {
            for (const tok of tokens) {
              if (tok.length < 2) continue;
              if (trig.startsWith(tok) || (tok.length >= 4 && tok.startsWith(trig))) {
                matched = true;
                break;
              }
            }
          }
          if (matched) break;
        }
        if (matched) {
          for (const target of group.targets) {
            expanded.add(target);
          }
        }
      }
      return expanded;
    }

    function scorePreparedIndex(rawCleanQuery, allowTypoFallback) {
      const cleanQuery = normalizeStr(rawCleanQuery);
      if (cleanQuery.length < MIN_QUERY_LENGTH) {
        return { results: [], highlightTokens: [] };
      }

      const tokens = tokenizeWords(cleanQuery);
      if (tokens.length === 0) {
        return { results: [], highlightTokens: [] };
      }

      const isSingleChar = cleanQuery.length === 1;
      const expandedTargets = expandSynonyms(cleanQuery, tokens);
      const expandedWords = [];
      expandedTargets.forEach((t) => {
        tokenizeWords(t).forEach((w) => {
          if (w.length >= 2 && !tokens.includes(w)) expandedWords.push(w);
        });
      });

      const scored = [];

      for (const entry of preparedIndex) {
        let score = 0;
        let matchedTokensCount = 0;
        let hasPrefixMatch = false;

        for (const tok of tokens) {
          let tokBest = 0;

          // 1) Пріоритет №1: точний збіг з початку слова в заголовку (prefix match)
          if (entry.titleLower.startsWith(tok)) {
            tokBest = Math.max(tokBest, 145);
            hasPrefixMatch = true;
          } else if (entry.titleWords.some((w) => w === tok)) {
            tokBest = Math.max(tokBest, 132);
            hasPrefixMatch = true;
          } else if (entry.titleWords.some((w) => w.startsWith(tok))) {
            tokBest = Math.max(tokBest, 118);
            hasPrefixMatch = true;
          }

          // 2) Пріоритет №2: збіг з початку слова в тегах / синонімах
          if (tokBest < 85) {
            if (entry.tagsLower.some((t) => t === tok) || entry.tagWords.some((w) => w === tok)) {
              tokBest = Math.max(tokBest, 78);
              hasPrefixMatch = true;
            } else if (
              entry.tagsLower.some((t) => t.startsWith(tok)) ||
              entry.tagWords.some((w) => w.startsWith(tok))
            ) {
              tokBest = Math.max(tokBest, 66);
              hasPrefixMatch = true;
            }
          }

          // 3) Пріоритет №3: входження всередині тексту або опису
          if (tokBest === 0) {
            if (entry.titleLower.includes(tok)) {
              tokBest = isSingleChar ? 18 : 34;
            } else if (entry.subtitleWords.some((w) => w.startsWith(tok))) {
              tokBest = isSingleChar ? 22 : 30;
            } else if (!isSingleChar && entry.subtitleLower.includes(tok)) {
              tokBest = 20;
            } else if (!isSingleChar && entry.tagsLower.some((t) => t.includes(tok))) {
              tokBest = 16;
            }
          }

          // М'який захист від 1 друкарської помилки (напр., "krfh" -> "лкар" -> "лікар")
          if (tokBest === 0 && allowTypoFallback && tok.length >= 4) {
            if (entry.titleWords.some((w) => matchesTypoPrefix(tok, w))) {
              tokBest = 54;
            } else if (entry.tagWords.some((w) => matchesTypoPrefix(tok, w))) {
              tokBest = 42;
            }
          }

          if (tokBest > 0) {
            score += tokBest;
            matchedTokensCount++;
          }
        }

        // Бонуси для багатослівних запитів
        if (tokens.length > 1) {
          if (matchedTokensCount === tokens.length) {
            score += 48;
          }
          if (entry.titleLower.includes(cleanQuery)) {
            score += 52;
          }
        }

        // Семантичне підсилення зі словника асоціацій (Пріоритет №2 для синонімів/російської/суржику)
        if (expandedWords.length > 0) {
          let synBest = 0;
          for (const targetPhrase of expandedTargets) {
            if (entry.titleLower.includes(targetPhrase)) {
              synBest = Math.max(synBest, 64);
            } else if (entry.tagsLower.some((t) => t === targetPhrase || t.startsWith(targetPhrase))) {
              synBest = Math.max(synBest, 58);
            }
          }
          if (synBest === 0) {
            for (const sw of expandedWords) {
              if (entry.titleWords.some((w) => w.startsWith(sw))) {
                synBest = Math.max(synBest, 56);
                break;
              }
              if (entry.tagWords.some((w) => w.startsWith(sw))) {
                synBest = Math.max(synBest, 48);
              }
            }
          }
          if (synBest > 0) {
            score += synBest;
          }
        }

        if (score > 0) {
          scored.push({
            item: entry.item,
            score: score + (entry.item.priority || 0) * 0.5,
            hasPrefixMatch,
          });
        }
      }

      // Для 1-літерних запитів: якщо є достатньо точних prefix-збігів, відсікаємо шумні підрядки
      let filtered = scored;
      if (isSingleChar) {
        const prefixOnly = scored.filter((s) => s.hasPrefixMatch);
        if (prefixOnly.length >= 4) {
          filtered = prefixOnly;
        }
      }

      filtered.sort((a, b) => b.score - a.score);
      return {
        results: filtered,
        highlightTokens: [...tokens, ...expandedWords.slice(0, 3)],
      };
    }

    function runSmartQuery(rawQuery) {
      const cleanQuery = normalizeStr(rawQuery);
      if (cleanQuery.length < MIN_QUERY_LENGTH) {
        return { items: [], highlightTokens: [], layoutHint: "" };
      }

      const primary = scorePreparedIndex(cleanQuery, false);
      const hasEmbeddedLayoutPunct =
        /(?:[a-z].*[\[\];]|[\[\];].*[a-z]|[,.'`][a-z])/i.test(cleanQuery) &&
        !/[а-яіїєґ]/i.test(cleanQuery);
      const hasLatinLayout =
        /[a-z]/i.test(cleanQuery) ||
        (/^[\[\];,\.]+$/.test(cleanQuery) && !/[а-яіїєґ]/i.test(cleanQuery));

      const mergedMap = new Map();
      if (!hasEmbeddedLayoutPunct) {
        primary.results.forEach((r) => {
          mergedMap.set(r.item.id, { item: r.item, score: r.score });
        });
      }

      const highlightSet = new Set(hasEmbeddedLayoutPunct ? [] : tokenizeWords(cleanQuery));
      let layoutHint = "";

      // Якщо є латинські символи й за оригіналом мало збігів (або є символи розкладки на кшталт ,hf[s чи ht,sy) — шукаємо за перекладеною розкладкою
      const strongPrimaryCount = primary.results.filter((r) => r.score >= 55).length;
      if (hasLatinLayout && (hasEmbeddedLayoutPunct || strongPrimaryCount < 3)) {
        const uaConverted = convertKeyboardLayout(cleanQuery, EN_TO_UA);
        const ruConverted = convertKeyboardLayout(cleanQuery, EN_TO_RU);

        let uaPass = scorePreparedIndex(uaConverted, false);
        if (uaPass.results.length === 0 && uaConverted.length >= 4) {
          uaPass = scorePreparedIndex(uaConverted, true);
        }

        let ruPass = { results: [], highlightTokens: [] };
        if (ruConverted !== uaConverted) {
          ruPass = scorePreparedIndex(ruConverted, false);
        }

        const bestConverted =
          ruPass.results.length > uaPass.results.length && uaPass.results.length === 0
            ? { pass: ruPass, text: ruConverted }
            : { pass: uaPass, text: uaConverted };

        if (bestConverted.pass.results.length > 0) {
          layoutHint = bestConverted.text;
          tokenizeWords(bestConverted.text).forEach((t) => highlightSet.add(t));
          bestConverted.pass.results.forEach((r) => {
            const adjustedScore =
              !hasEmbeddedLayoutPunct && primary.results.length > 0 ? r.score * 0.94 : r.score;
            const prev = mergedMap.get(r.item.id);
            if (!prev || adjustedScore > prev.score) {
              mergedMap.set(r.item.id, { item: r.item, score: adjustedScore });
            }
          });
        } else if (hasEmbeddedLayoutPunct) {
          primary.results.forEach((r) => {
            mergedMap.set(r.item.id, { item: r.item, score: r.score });
          });
        }
      }

      // Якщо все ще 0 результатів — одноразовий фолбек на 1 друкарську помилку (для запитів від 4 символів)
      if (mergedMap.size === 0 && cleanQuery.length >= 4) {
        const typoPass = scorePreparedIndex(cleanQuery, true);
        typoPass.results.forEach((r) => {
          mergedMap.set(r.item.id, { item: r.item, score: r.score });
        });
      }

      const finalSorted = Array.from(mergedMap.values())
        .sort((a, b) => b.score - a.score)
        .slice(0, MAX_RESULTS)
        .map((entry) => entry.item);

      return {
        items: finalSorted,
        highlightTokens: Array.from(highlightSet),
        layoutHint:
          hasEmbeddedLayoutPunct || primary.results.length === 0 || strongPrimaryCount < 2
            ? layoutHint
            : "",
      };
    }

    // Випадкова вибірка без повторення щойно показаних елементів
    function pickRandomExcluding(pool, count, excludeIds) {
      const available = pool.filter((item) => !excludeIds.has(item.id));
      const source = available.length >= count ? [...available] : [...pool];

      for (let i = source.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const tmp = source[i];
        source[i] = source[j];
        source[j] = tmp;
      }

      return source.slice(0, Math.min(count, source.length));
    }

    function setupSearchModal() {
      const modal = document.getElementById("search-modal");
      if (!modal) return;
      if (modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }

      if (modal.getAttribute("data-search-initialized") === "true") return;
      modal.setAttribute("data-search-initialized", "true");

      const trigger = document.getElementById("search-trigger");
      const closeBackdrop = document.getElementById("search-close");
      const closeBtn = document.getElementById("modal-close-btn");
      const searchInput = document.getElementById("search-input");
      const clearBtn = document.getElementById("search-clear-btn");
      const suggestionsBox = document.getElementById("suggestions-box");
      const resultsContainer = document.getElementById("results-container");
      const resultsList = document.getElementById("results-list");
      const resultsCount = document.getElementById("results-count");
      const layoutHintEl = document.getElementById("layout-hint");
      const shuffleBtn = document.getElementById("shuffle-suggestions-btn");
      const shuffleIcon = document.getElementById("shuffle-icon");
      const quickChipsList = document.getElementById("quick-chips-list");
      const defaultCardsList = document.getElementById("default-cards-list");

      if (!searchInput || !quickChipsList || !defaultCardsList || !resultsList) return;

      let activeIndex = -1;
      let shuffleRotation = 0;

      let currentChipIds = new Set(
        Array.from(quickChipsList.querySelectorAll("[data-chip-id]")).map((el) =>
          el.getAttribute("data-chip-id")
        )
      );
      let currentCardIds = new Set(
        Array.from(defaultCardsList.querySelectorAll("[data-card-id]")).map((el) =>
          el.getAttribute("data-card-id")
        )
      );

      function getNavigableItems() {
        if (!resultsContainer.classList.contains("hidden")) {
          return Array.from(resultsList.querySelectorAll(".search-nav-item"));
        }
        return Array.from(defaultCardsList.querySelectorAll(".search-nav-item"));
      }

      function updateActiveSelection() {
        const items = getNavigableItems();
        items.forEach((el, idx) => {
          const isActive = idx === activeIndex;
          el.classList.toggle("is-kbd-active", isActive);
          el.setAttribute("aria-selected", isActive ? "true" : "false");
          if (isActive) {
            el.scrollIntoView({ block: "nearest", behavior: "smooth" });
          }
        });
      }

      function toggleClearButton(hasText) {
        if (!clearBtn) return;
        clearBtn.classList.toggle("hidden", !hasText);
        clearBtn.classList.toggle("flex", hasText);
      }

      function openModal() {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
        activeIndex = -1;
        updateActiveSelection();
        setTimeout(() => searchInput.focus(), 20);
      }

      function closeModal() {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        document.body.style.overflow = "";
        activeIndex = -1;
      }

      function renderChips(chips, animate) {
        currentChipIds = new Set(chips.map((c) => c.id));
        quickChipsList.innerHTML = chips
          .map(
            (chip, idx) => `
              <button
                type="button"
                class="tag-btn search-chip ${animate ? "search-fade-in" : ""} group inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-50 hover:bg-sky-50 text-slate-700 hover:text-sky-700 text-xs font-medium transition-all active:scale-[0.98] cursor-pointer border border-slate-200/80 hover:border-sky-200 whitespace-nowrap shrink-0 md:w-full md:min-w-0"
                style="${animate ? `animation-delay: ${idx * 25}ms` : ""}"
                data-query="${escapeHtml(chip.query)}"
                data-chip-id="${escapeHtml(chip.id)}"
              >
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-sky-500 shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" />
                  <path d="M20 20l-3.5-3.5" />
                </svg>
                <span class="truncate">${escapeHtml(chip.label)}</span>
              </button>
            `
          )
          .join("");
      }

      function renderQuickCards(cards, animate) {
        currentCardIds = new Set(cards.map((c) => c.id));
        defaultCardsList.innerHTML = cards
          .map(
            (card, idx) => `
              <a
                href="${escapeHtml(card.href)}"
                data-card-id="${escapeHtml(card.id)}"
                class="search-nav-item search-card ${animate ? "search-fade-in" : ""} group flex items-center justify-between gap-3 p-3 rounded-2xl bg-slate-50/70 hover:bg-sky-50/60 border border-slate-200/75 hover:border-sky-200 transition-all"
                style="${animate ? `animation-delay: ${idx * 25}ms` : ""}"
              >
                <div class="flex items-center gap-3 min-w-0">
                  <span class="search-icon-tile w-9 h-9 rounded-xl bg-sky-50/90 text-sky-600 border border-sky-100/90 flex items-center justify-center shrink-0 group-hover:bg-sky-100/80 group-hover:text-sky-700 transition-colors">
                    ${iconSvgMarkup(card.icon, "w-[18px] h-[18px]")}
                  </span>
                  <div class="min-w-0">
                    <span class="block text-[10px] font-semibold uppercase tracking-wider text-sky-600/90 leading-tight mb-0.5">
                      ${escapeHtml(card.badge)}
                    </span>
                    <span class="block text-[13px] sm:text-sm font-semibold text-slate-800 group-hover:text-sky-700 truncate leading-snug">
                      ${escapeHtml(card.title)}
                    </span>
                    ${
                      card.subtitle
                        ? `<span class="block text-[11px] text-slate-500 truncate mt-0.5 leading-tight">${escapeHtml(card.subtitle)}</span>`
                        : ""
                    }
                  </div>
                </div>
                <svg class="w-4 h-4 text-slate-300 group-hover:text-sky-500 group-hover:translate-x-0.5 transition-all shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 6l6 6-6 6" />
                </svg>
              </a>
            `
          )
          .join("");
        activeIndex = -1;
      }

      function renderEmptyState(rawQuery) {
        const linksHtml = (emptyState.quickLinks || [])
          .slice(0, 3)
          .map(
            (link) => `
              <a
                href="${escapeHtml(link.href)}"
                class="search-nav-item inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-sky-50 border border-slate-200/90 hover:border-sky-200 text-xs font-medium text-slate-700 hover:text-sky-700 transition-colors"
              >
                <span class="text-sky-600">${iconSvgMarkup(link.icon, "w-4 h-4")}</span>
                <span>${escapeHtml(link.label)}</span>
              </a>
            `
          )
          .join("");

        resultsList.innerHTML = `
          <div class="text-center py-8 px-4 bg-slate-50/70 rounded-2xl border border-slate-200/70">
            <div class="search-icon-tile w-11 h-11 rounded-2xl bg-sky-50 text-sky-600 border border-sky-100 flex items-center justify-center mx-auto mb-3">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="M20 20l-3.5-3.5M8.5 11h5" />
              </svg>
            </div>
            <p class="text-sm font-semibold text-slate-800 mb-1">
              За запитом «${escapeHtml(rawQuery.trim())}» нічого не знайдено
            </p>
            <p class="text-xs text-slate-500 max-w-md mx-auto mb-4 leading-relaxed">
              Спробуйте ввести інше слово, коротший запит або перейдіть до одного з основних розділів:
            </p>
            <div class="flex flex-wrap justify-center gap-2 mb-5">
              ${linksHtml}
            </div>
            <div class="pt-4 border-t border-slate-200/70 flex flex-col sm:flex-row items-center justify-center gap-2 text-xs text-slate-500">
              <span>Потрібна підказка реєстратури?</span>
              <a
                href="${escapeHtml(emptyState.phoneTel)}"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-700 border border-sky-200/80 font-semibold transition-colors"
              >
                ${iconSvgMarkup("phone", "w-3.5 h-3.5")}
                <span>${escapeHtml(emptyState.phone)}</span>
              </a>
            </div>
          </div>
        `;
      }

      function performSmartSearch(rawQuery) {
        const value = String(rawQuery || "");
        const trimmed = value.trim();
        toggleClearButton(value.length > 0);

        if (trimmed.length < MIN_QUERY_LENGTH) {
          resultsContainer.classList.add("hidden");
          suggestionsBox.classList.remove("hidden");
          if (layoutHintEl) layoutHintEl.classList.add("hidden");
          activeIndex = -1;
          updateActiveSelection();
          return;
        }

        suggestionsBox.classList.add("hidden");
        resultsContainer.classList.remove("hidden");

        const { items, highlightTokens, layoutHint } = runSmartQuery(trimmed);

        if (resultsCount) {
          resultsCount.textContent = `Знайдено: ${items.length}`;
        }

        if (layoutHintEl) {
          if (layoutHint) {
            layoutHintEl.textContent = `Розкладка: «${layoutHint}»`;
            layoutHintEl.classList.remove("hidden");
          } else {
            layoutHintEl.classList.add("hidden");
          }
        }

        if (items.length === 0) {
          renderEmptyState(trimmed);
          activeIndex = -1;
          return;
        }

        resultsList.innerHTML = items
          .map((item) => {
            const catClass =
              CATEGORY_BADGE_STYLES[item.category] ||
              "bg-slate-100 text-slate-600 border-slate-200/80";
            return `
              <a
                href="${escapeHtml(item.url)}"
                role="option"
                aria-selected="false"
                class="search-nav-item search-result-row group flex items-center justify-between gap-3 p-3 sm:p-3.5 rounded-2xl bg-slate-50/60 hover:bg-sky-50/60 border border-slate-200/75 hover:border-sky-200 transition-all"
              >
                <div class="flex items-start gap-3 min-w-0">
                  <span class="search-icon-tile w-9 h-9 rounded-xl bg-sky-50/90 text-sky-600 border border-sky-100/90 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-sky-100/80 group-hover:text-sky-700 transition-colors">
                    ${iconSvgMarkup(item.icon, "w-[18px] h-[18px]")}
                  </span>
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 mb-0.5">
                      <span class="px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider rounded-md border ${catClass}">
                        ${escapeHtml(item.category)}
                      </span>
                    </div>
                    <div class="text-sm sm:text-[15px] font-semibold text-slate-900 group-hover:text-sky-700 transition-colors leading-snug">
                      ${highlightText(item.title, highlightTokens)}
                    </div>
                    ${
                      item.subtitle
                        ? `<div class="text-xs text-slate-500 mt-0.5 line-clamp-2 leading-relaxed">${highlightText(item.subtitle, highlightTokens)}</div>`
                        : ""
                    }
                  </div>
                </div>
                <svg class="w-4 h-4 text-slate-300 group-hover:text-sky-500 group-hover:translate-x-0.5 transition-all shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 6l6 6-6 6" />
                </svg>
              </a>
            `;
          })
          .join("");

        activeIndex = 0;
        updateActiveSelection();
      }

      // Відкриття / закриття
      trigger?.addEventListener("click", openModal);
      closeBackdrop?.addEventListener("click", closeModal);
      closeBtn?.addEventListener("click", closeModal);

      // Ввід тексту
      searchInput.addEventListener("input", (e) => {
        performSmartSearch(e.target.value);
      });

      searchInput.addEventListener("focus", () => {
        if (!searchInput.value.trim()) {
          suggestionsBox.classList.remove("hidden");
          resultsContainer.classList.add("hidden");
        }
      });

      // Швидке очищення хрестиком
      clearBtn?.addEventListener("click", () => {
        searchInput.value = "";
        performSmartSearch("");
        searchInput.focus();
      });

      // Делегований клік по чіпах "Часто шукають" (працює і після оновлення підбірки)
      quickChipsList.addEventListener("click", (e) => {
        const chipBtn = e.target.closest(".tag-btn");
        if (!chipBtn) return;
        const q = chipBtn.getAttribute("data-query") || "";
        searchInput.value = q;
        performSmartSearch(q);
        searchInput.focus();
      });

      // Закриття модалки при кліку по будь-якому посиланню всередині
      modal.addEventListener("click", (e) => {
        const link = e.target.closest("a[href]");
        if (!link) return;
        const href = link.getAttribute("href") || "";
        if (!href.startsWith("tel:") && !href.startsWith("mailto:")) {
          closeModal();
        }
      });

      // Кнопка "Оновити підбірку": одночасно оновлює 4 чіпи І 6 карток без повторення щойно показаних
      shuffleBtn?.addEventListener("click", () => {
        shuffleRotation += 360;
        if (shuffleIcon) {
          shuffleIcon.style.transform = `rotate(${shuffleRotation}deg)`;
        }
        const nextChips = pickRandomExcluding(
          quickChipsPool,
          CHIPS_PER_ROW,
          currentChipIds
        );
        const nextCards = pickRandomExcluding(
          quickCardsPool,
          CARDS_PER_GRID,
          currentCardIds
        );
        renderChips(nextChips, true);
        renderQuickCards(nextCards, true);
      });

      // Глобальна клавіатурна навігація (захищена від дублювання при astro:after-swap)
      if (window.__kntSearchKeydownHandler) {
        document.removeEventListener("keydown", window.__kntSearchKeydownHandler);
      }

      window.__kntSearchKeydownHandler = function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          if (modal.classList.contains("hidden")) {
            openModal();
          } else {
            closeModal();
          }
          return;
        }

        if (modal.classList.contains("hidden")) return;

        if (e.key === "Escape") {
          e.preventDefault();
          closeModal();
          return;
        }

        const items = getNavigableItems();
        if (items.length === 0) return;

        if (e.key === "ArrowDown") {
          e.preventDefault();
          activeIndex = activeIndex < 0 ? 0 : (activeIndex + 1) % items.length;
          updateActiveSelection();
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          activeIndex = activeIndex <= 0 ? items.length - 1 : activeIndex - 1;
          updateActiveSelection();
        } else if (e.key === "Enter") {
          const targetIdx =
            activeIndex >= 0 && items[activeIndex]
              ? activeIndex
              : !resultsContainer.classList.contains("hidden")
                ? 0
                : -1;
          if (targetIdx >= 0 && items[targetIdx]) {
            e.preventDefault();
            const targetHref = items[targetIdx].getAttribute("href");
            closeModal();
            if (targetHref) {
              window.location.href = targetHref;
            }
          }
        }
      };

      document.addEventListener("keydown", window.__kntSearchKeydownHandler);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupSearchModal);
    } else {
      setupSearchModal();
    }
    document.addEventListener("astro:after-swap", setupSearchModal);
  })();
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 10px;
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  #search-input:focus {
    outline: none;
  }

  /* Плавна анімація оновлення підбірки */
  @keyframes searchFadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  :global(#search-modal .search-fade-in) {
    animation: searchFadeIn 0.22s ease-out both;
  }

  /* Підсвічування збігів у заголовках та описах */
  :global(#search-modal .search-mark) {
    background-color: #e0f2fe;
    color: #0369a1;
    border-radius: 0.25rem;
    padding: 0 0.15rem;
    font-weight: 700;
  }

  /* Стан активного пункту для навігації клавіатурою */
  :global(#search-modal .search-nav-item.is-kbd-active) {
    background-color: #f0f9ff;
    border-color: #7dd3fc;
    box-shadow: 0 0 0 2px rgba(14, 165, 233, 0.22);
  }

  /* Коректний вигляд у темній темі (без втручання у global.css) */
  :global(html[data-theme="dark"]:not([data-a11y-contrast]) #search-modal .search-input-shell) {
    background-color: #0f172a !important;
    border-color: #334155 !important;
  }

  :global(html[data-theme="dark"]:not([data-a11y-contrast]) #search-modal #search-input) {
    background-color: transparent !important;
    border: none !important;
    color: #f8fafc !important;
  }

  :global(html[data-theme="dark"]:not([data-a11y-contrast]) #search-modal .search-icon-tile) {
    background-color: #132540 !important;
    border-color: #1e3a5f !important;
    color: #38bdf8 !important;
  }

  :global(html[data-theme="dark"]:not([data-a11y-contrast]) #search-modal .search-chip:hover),
  :global(html[data-theme="dark"]:not([data-a11y-contrast]) #search-modal .search-card:hover),
  :global(html[data-theme="dark"]:not([data-a11y-contrast]) #search-modal .search-result-row:hover),
  :global(html[data-theme="dark"]:not([data-a11y-contrast]) #search-modal .search-nav-item.is-kbd-active) {
    background-color: #172742 !important;
    border-color: #38bdf8 !important;
  }

  :global(html[data-theme="dark"]:not([data-a11y-contrast]) #search-modal .search-mark) {
    background-color: rgba(56, 189, 248, 0.25) !important;
    color: #bae6fd !important;
  }

  :global(html[data-a11y-contrast="high"] #search-modal .search-mark) {
    background-color: #000000 !important;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
  }

  :global(html[data-a11y-contrast="dark"] #search-modal .search-mark) {
    background-color: #fde047 !important;
    color: #000000 !important;
    -webkit-text-fill-color: #000000 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(#search-modal .search-fade-in) {
      animation: none;
    }
  }
</style>
