---
// src/components/hero.astro
import Link from "@components/ui/link.astro";
import { Icon } from "astro-icon/components";

// 1. Отримуємо дані, які прийдуть з index.astro
const { title, subtitle, description } = Astro.props;
---

{/* МІНЯЄМО max-w-screen-xl на max-w-[1850px] та збільшуємо відступи px */}
<main class="max-w-[1850px] mx-auto px-6 md:px-12 lg:px-20 pt-4 md:pt-20 pb-16 md:pb-32 font-sans relative overflow-visible">
  
  {/* Міняємо співвідношення сітки: 1fr для тексту і 1.3fr для картинки, щоб вона була БІЛЬШОЮ */}
  <div class="grid lg:grid-cols-[1fr_1.3fr] items-center gap-12 lg:gap-24 relative z-10 min-h-[600px]">
    
    <div class="text-center lg:text-left order-1 relative z-10">
  
      <div class="hidden sm:inline-flex items-center gap-2 bg-cyan-50 text-cyan-700 px-4 py-2 rounded-full text-[11px] font-bold uppercase tracking-[0.2em] border border-cyan-100 shadow-sm transition-transform hover:scale-105 select-none shrink-0 w-fit">
  <Icon name="bx:bxs-badge-check" class="w-5 h-5 text-cyan-600" />
  Передові технології лікування
</div>

<div class="hidden sm:inline-flex items-center gap-2 bg-blue-50 text-blue-700 px-3.5 py-1.5 rounded-full text-[10px] md:text-[11px] font-bold uppercase tracking-widest border border-blue-100 shadow-sm transition-transform duration-300 transform hover:scale-105 select-none shrink-0 w-fit">
  <img src="/hero/nszu.png" alt="НСЗУ" class="h-4 md:h-5 w-auto object-contain" />
  Програма медичних гарантій
</div>





    <div class="mb-8 animate-fade-in-up text-center lg:text-left relative z-20 overflow-visible group">
  
  <div class="inline-flex items-center justify-center lg:justify-start gap-2 mb-4 relative">
    
    <div class="w-4 h-8 border-l-2 border-t-2 border-blue-500/40 rounded-tl-lg 
                transition-all duration-700 group-hover:translate-x-1 group-hover:translate-y-1"></div>

    <h2 class="text-5xl md:text-8xl font-extrabold tracking-tight">
      <span class="bg-gradient-to-br from-gray-900 via-slate-800 to-slate-600 bg-clip-text text-transparent px-2">
        Центр
      </span>
    </h2>

    <div class="w-4 h-8 border-r-2 border-b-2 border-blue-500/40 rounded-br-lg 
                transition-all duration-700 group-hover:-translate-x-1 group-hover:-translate-y-1"></div>
    
    <div class="absolute -top-1 -left-1 w-2 h-2 bg-blue-400 rounded-full blur-[2px] animate-pulse opacity-0 group-hover:opacity-100 transition-opacity"></div>
  </div>

  <div class="text-5xl md:text-8xl font-black leading-none mb-8">
    <span class="inline-block pr-2 bg-gradient-to-r from-blue-600 via-cyan-500 to-purple-600 bg-clip-text text-transparent">
      променевої терапії
    </span>
  </div>

  <div class="inline-flex items-center gap-3 px-6 py-3 rounded-2xl 
              bg-white/10 backdrop-blur-md 
              border border-white/20 shadow-[0_8px_32px_0_rgba(31,38,135,0.15)] 
              transition-transform hover:scale-105 cursor-default">
    
    <div class="relative flex items-center justify-center">
       <Icon name="bx:bxs-map-pin" class="w-6 h-6 text-blue-500 animate-bounce" />
       <div class="absolute -bottom-1 w-2 h-1 bg-blue-900/20 rounded-full blur-[2px]"></div>
    </div>

    <span class="text-xl md:text-3xl font-bold bg-gradient-to-r from-slate-700 to-slate-500 bg-clip-text text-transparent tracking-wide">
      У місті Дніпро
    </span>

    <span class="text-2xl group-hover:rotate-12 transition-transform">🏙️</span>
  </div>
</div>


