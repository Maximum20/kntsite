---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import fullLogo from "../assets/full-logo.png";
import { siteSettings } from "../data";

const allServices = (await getCollection("services")) || [];
const isLinacVisible = allServices.some((s) => s.id === "linac" && s.data?.isVisible !== false);
---

<footer id="footer-section" class="mt-20 border-t border-slate-200 py-16 px-5 relative overflow-hidden">
  <div class="max-w-screen-xl mx-auto relative">
    <div class="flex flex-col items-center">
      <!-- Логотип -->
      <div class="mb-8 logo-container">
        <a href="/" class="logo-wrapper block">
          <Image
            src={fullLogo}
            alt="Логотип КНТ ДОКОД ДОР"
            class="h-16 md:h-20 w-auto object-contain drop-shadow-lg"
          />
        </a>
      </div>

      <!-- Текст -->
      <div class="text-center max-w-3xl">
        <p class="text-[10px] md:text-xs uppercase tracking-[0.2em] text-slate-400 font-bold mb-3">
          Дніпропетровська обласна рада
        </p>

        <p class="text-sm md:text-base text-slate-600 font-medium leading-relaxed mb-2">
          {siteSettings.clinicFullName}
        </p>

        <div class="relative inline-block">
          <p class="text-base md:text-lg font-semibold bg-gradient-to-r from-blue-600 via-blue-500 to-blue-600 bg-clip-text text-transparent relative z-10">
            {siteSettings.departmentName}
          </p>
        </div>
      </div>

      <!-- Навігаційні лінки у футері -->
      <div class="mt-8 flex flex-wrap justify-center gap-6 text-xs font-bold text-slate-500 uppercase tracking-wider">
        <a href="/" class="hover:text-blue-600 transition-colors">Головна</a>
        <a href="/doctors" class="hover:text-blue-600 transition-colors">Персонал</a>
        {isLinacVisible && (
          <a href="/services/linac" class="hover:text-blue-600 transition-colors">Лінійні прискорювачі</a>
        )}
        <a href="/all-news" class="hover:text-blue-600 transition-colors">Новини</a>
        <a href="/vacancies" class="hover:text-blue-600 transition-colors">Вакансії</a>
        <a href="/#contacts" class="hover:text-blue-600 transition-colors">Контакти</a>
      </div>

      <!-- Копірайт -->
      <div class="mt-8 text-center relative">
        <p class="text-xs text-slate-400">
          <span>&copy; {new Date().getFullYear()} {siteSettings.clinicShortName}. Всі права захищені.</span>
        </p>
      </div>
    </div>
  </div>
</footer>
