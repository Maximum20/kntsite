---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import ServiceUI from "../../components/ServiceUI.astro";
import ContentBlocks from "../../components/ContentBlocks.astro";
import Interactive from "../../components/Interactive.astro";
import LinearAccelerators from "../../components/LinearAccelerators.astro";
import DepartmentStaff from "../../components/DepartmentStaff.astro";
import { getCollection, render } from "astro:content";
import { formatRichText, formatInlineMarkdown } from "../../utils/formatText";
import { siteSettings } from "../../data";
import { normalizeGallerySlides, resolvePhotoUrl } from "../../utils/photos";

export async function getStaticPaths() {
  const serviceEntries = await getCollection("services");

  return serviceEntries
    .filter((entry) => entry.data?.isVisible !== false)
    .map((entry) => ({
      params: { id: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
if (!entry || entry.data?.isVisible === false) {
  return Astro.redirect("/");
}

const { Content } = await render(entry);
const data = entry.data;
const sections = Array.isArray(data.sections) ? data.sections : [];
const hasExtraMarkdownBody = Boolean((entry.body || "").trim());
const gallerySlides = normalizeGallerySlides(
  data.gallery,
  data.heroTitle || data.title || "Відділення",
  siteSettings.hideLegacyPhotos
);
const heroFallbackSrc = resolvePhotoUrl(
  null,
  data.image || "/hero/main_page2.jpg",
  siteSettings.hideLegacyPhotos
);

function renderTabSectionsHtml(tabSections: any[]): string {
  if (!Array.isArray(tabSections)) return "";
  return tabSections
    .map((sec) => {
      const parts: string[] = [];
      if (sec.heading) {
        parts.push(
          `<h4 class="font-black text-slate-800 mb-2 text-sm sm:text-base">${formatInlineMarkdown(sec.heading)}</h4>`
        );
      }
      if (sec.text) {
        parts.push(`<div class="text-sm text-slate-700 leading-relaxed mb-2">${formatRichText(sec.text)}</div>`);
      }
      if (Array.isArray(sec.bullets) && sec.bullets.length > 0) {
        parts.push(
          `<ul class="list-disc pl-5 text-sm sm:text-base text-slate-700 space-y-1.5">${sec.bullets
            .map((b: string) => `<li>${formatInlineMarkdown(b)}</li>`)
            .join("")}</ul>`
        );
      }
      if (sec.note) {
        parts.push(
          `<div class="mt-3 p-3 bg-blue-50 border border-blue-200 rounded-xl text-xs sm:text-sm text-slate-700">${formatInlineMarkdown(sec.note)}</div>`
        );
      }
      return `<div class="p-3.5 sm:p-4 bg-slate-50/80 rounded-xl border border-slate-200/70">${parts.join("")}</div>`;
    })
    .join('<div class="h-3"></div>');
}
---

<Layout title={data.title || "Відділення"} description={data.description}>
  {data.showScrollProgress !== false && <Interactive type="scroll-progress" />}

  <main class="w-full font-sans">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-10 pt-10 sm:pt-20 pb-32">
      {/* Головний Hero-блок відділення з каруселлю або заглушкою */}
      <ServiceUI
        type="hero"
        subtitle={data.subtitle || "Напрямок лікування"}
        title={data.heroTitle || data.title}
        slides={gallerySlides}
        src={heroFallbackSrc || ""}
        icon={data.icon || ""}
        text={data.heroText || data.description}
      />

      {/* Динамічний рендер структурованих блоків з Keystatic */}
      {sections.map((block: any) => {
        const type = block?.discriminant;
        const val = block?.value || {};

        if (type === "accelerators") {
          return val.enabled !== false ? <LinearAccelerators /> : null;
        }

        if (type === "staff") {
          if (val.displayMode === "section") {
            return (
              <DepartmentStaff
                title={val.title || "Персонал відділення"}
                introText={val.introText}
                departmentFilter={val.departmentFilter}
                roleFilter={val.roleFilter}
                selectedStaff={val.selectedStaff}
              />
            );
          }
          return (
            <ServiceUI type="accordion" title={val.title || "Персонал відділення"} icon={val.icon || "👨‍⚕️"}>
              <DepartmentStaff
                title={val.title || "Персонал відділення"}
                introText={val.introText}
                departmentFilter={val.departmentFilter}
                roleFilter={val.roleFilter}
                selectedStaff={val.selectedStaff}
                compact={true}
              />
            </ServiceUI>
          );
        }

        if (type === "highlight") {
          const hasInner =
            (Array.isArray(val.infoBoxes) && val.infoBoxes.length > 0) ||
            (Array.isArray(val.checklistItems) && val.checklistItems.length > 0) ||
            Boolean(val.warningNote);

          if (hasInner) {
            return (
              <ServiceUI
                type="callout"
                variant={val.variant || "info"}
                icon={val.icon || "💡"}
                title={val.title}
              >
                {val.text && <div class="mb-4" set:html={formatRichText(val.text)} />}
                {Array.isArray(val.infoBoxes) && val.infoBoxes.length > 0 && (
                  <ContentBlocks
                    type="info-boxes"
                    variant={val.variant === "warning" ? "danger" : val.variant || "info"}
                    items={val.infoBoxes}
                  />
                )}
                {Array.isArray(val.checklistItems) && val.checklistItems.length > 0 && (
                  <Interactive
                    type="checklist"
                    title={val.checklistTitle || "Чекліст"}
                    items={val.checklistItems}
                  />
                )}
                {val.warningNote && (
                  <ContentBlocks type="highlight" variant="warning" icon="⚠️">
                    <div set:html={formatRichText(val.warningNote)} />
                  </ContentBlocks>
                )}
              </ServiceUI>
            );
          }

          return (
            <ContentBlocks
              type="highlight"
              variant={val.variant || "info"}
              icon={val.icon || "💡"}
              title={val.title}
            >
              {val.text && <div set:html={formatRichText(val.text)} />}
            </ContentBlocks>
          );
        }

        if (type === "comparison") {
          return (
            <ServiceUI
              type="comparison"
              comparison={{
                leftIcon: val.leftIcon || "⚡",
                leftTitle: val.leftTitle || "",
                leftText: val.leftText || "",
                leftItems: Array.isArray(val.leftItems) ? val.leftItems : [],
                rightIcon: val.rightIcon || "🌱",
                rightTitle: val.rightTitle || "",
                rightText: val.rightText || "",
                rightItems: Array.isArray(val.rightItems) ? val.rightItems : [],
              }}
            />
          );
        }

        if (type === "timeline") {
          return (
            <div class="my-8">
              {val.title && (
                <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mb-4 px-1 tracking-tight">
                  {val.title}
                </h2>
              )}
              <ServiceUI type="timeline" items={Array.isArray(val.items) ? val.items : []} />
            </div>
          );
        }

        if (type === "featureGrid") {
          return (
            <div class="my-8">
              {val.title && (
                <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mb-4 px-1 tracking-tight">
                  {val.title}
                </h2>
              )}
              <ServiceUI type="feature-grid" items={Array.isArray(val.items) ? val.items : []} />
            </div>
          );
        }

        if (type === "checklist") {
          return (
            <div class="my-8 bg-white border-2 border-slate-200 rounded-2xl lg:rounded-[2.5rem] p-5 lg:p-10 shadow-sm">
              <Interactive
                type="checklist"
                title={val.title || "Чекліст підготовки"}
                items={Array.isArray(val.items) ? val.items : []}
              />
            </div>
          );
        }

        if (type === "accordion") {
          const tabItems = Array.isArray(val.tabs)
            ? val.tabs.map((tab: any) => ({
                icon: tab.icon || "",
                title: tab.title || "",
                content: renderTabSectionsHtml(tab.sections || []),
              }))
            : [];

          return (
            <ServiceUI
              type="accordion"
              title={val.title || "Інформація"}
              icon={val.icon || "📋"}
              variant={val.variant || "default"}
              open={Boolean(val.openByDefault)}
            >
              {val.introText && (
                <div class="mb-4 text-sm sm:text-base leading-relaxed" set:html={formatRichText(val.introText)} />
              )}

              {Array.isArray(val.highlights) &&
                val.highlights.map((hl: any) => (
                  <ContentBlocks
                    type="highlight"
                    variant={hl.variant || "info"}
                    icon={hl.icon || ""}
                    title={hl.title || ""}
                  >
                    <div set:html={formatRichText(hl.text || "")} />
                  </ContentBlocks>
                ))}

              {Array.isArray(val.cards) && val.cards.length > 0 && (
                <div>
                  {val.cardsTitle && (
                    <h4 class="font-black text-base sm:text-lg text-slate-800 mt-6 mb-3">
                      {val.cardsTitle}
                    </h4>
                  )}
                  <ContentBlocks type={val.cardsStyle || "card-grid"} items={val.cards} />
                </div>
              )}

              {Array.isArray(val.listItems) && val.listItems.length > 0 && (
                <div>
                  {val.listTitle && (
                    <h4 class="font-black text-base sm:text-lg text-slate-800 mt-6 mb-3">
                      {val.listTitle}
                    </h4>
                  )}
                  <ContentBlocks type={val.listStyle || "icon-list"} items={val.listItems} />
                </div>
              )}

              {Array.isArray(val.steps) && val.steps.length > 0 && (
                <ContentBlocks type="steps" items={val.steps} />
              )}

              {tabItems.length > 0 && (
                <div>
                  {val.tabsTitle && (
                    <h4 class="font-black text-base sm:text-lg text-slate-800 mt-6 mb-3">
                      {val.tabsTitle}
                    </h4>
                  )}
                  <ContentBlocks type="mobile-tabs" items={tabItems} />
                </div>
              )}

              {Array.isArray(val.expandables) && val.expandables.length > 0 && (
                <div class="space-y-3 my-4">
                  {val.expandables.map((exp: any) => (
                    <ContentBlocks type="expandable" title={exp.title || ""} icon={exp.icon || ""}>
                      {exp.text && <div class="mb-2" set:html={formatRichText(exp.text)} />}
                      {Array.isArray(exp.bullets) && exp.bullets.length > 0 && (
                        <ul class="list-disc pl-5 space-y-1 text-sm sm:text-base">
                          {exp.bullets.map((b: string) => (
                            <li set:html={formatInlineMarkdown(b)} />
                          ))}
                        </ul>
                      )}
                      {exp.note && (
                        <div class="mt-3 p-3 bg-blue-50 border border-blue-200 rounded-xl text-xs sm:text-sm" set:html={formatRichText(exp.note)} />
                      )}
                    </ContentBlocks>
                  ))}
                </div>
              )}

              {val.prosCons?.enabled && (
                <div class="grid sm:grid-cols-2 gap-4 my-6 not-prose">
                  <div class="p-5 sm:p-6 bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl border-2 border-green-200">
                    <h4 class="font-black text-green-800 mb-3 flex items-center gap-2">
                      <span class="text-2xl">✅</span>
                      {val.prosCons.prosTitle || "Що покращує"}
                    </h4>
                    <ul class="space-y-2 text-sm sm:text-base text-slate-700">
                      {(val.prosCons.prosItems || []).map((item: string) => (
                        <li set:html={formatInlineMarkdown(item)} />
                      ))}
                    </ul>
                  </div>
                  <div class="p-5 sm:p-6 bg-gradient-to-br from-red-50 to-rose-50 rounded-2xl border-2 border-red-200">
                    <h4 class="font-black text-red-800 mb-3 flex items-center gap-2">
                      <span class="text-2xl">❌</span>
                      {val.prosCons.consTitle || "Що НЕ лікує"}
                    </h4>
                    <ul class="space-y-2 text-sm sm:text-base text-slate-700">
                      {(val.prosCons.consItems || []).map((item: string) => (
                        <li set:html={formatInlineMarkdown(item)} />
                      ))}
                    </ul>
                  </div>
                </div>
              )}

              {Array.isArray(val.warningBoxes) && val.warningBoxes.length > 0 && (
                <ContentBlocks type="info-boxes" variant="warning" items={val.warningBoxes} />
              )}

              {Array.isArray(val.checklistItems) && val.checklistItems.length > 0 && (
                <Interactive
                  type="checklist"
                  title={val.checklistTitle || "Чекліст"}
                  items={val.checklistItems}
                />
              )}

              {val.bottomHighlight?.enabled && (
                <ContentBlocks
                  type="highlight"
                  variant={val.bottomHighlight.variant || "info"}
                  icon={val.bottomHighlight.icon || ""}
                  title={val.bottomHighlight.title || ""}
                >
                  <div set:html={formatRichText(val.bottomHighlight.text || "")} />
                </ContentBlocks>
              )}
            </ServiceUI>
          );
        }

        if (type === "faq") {
          const faqItems = Array.isArray(val.items) ? val.items : [];
          return (
            <ServiceUI
              type="accordion"
              title={val.title || "Поширені запитання"}
              icon={val.icon || "❓"}
              variant={val.variant || "default"}
            >
              {faqItems.map((item: any) => (
                <ContentBlocks type="expandable" title={item.question || ""} icon={item.icon || "❓"}>
                  {item.alertVariant && item.alertVariant !== "none" && (item.alertTitle || item.alertText) && (
                    <div
                      class={`mb-3 p-3.5 rounded-xl border-2 text-sm ${
                        item.alertVariant === "danger"
                          ? "bg-red-50 border-red-200 text-red-900"
                          : item.alertVariant === "warning"
                          ? "bg-amber-50 border-amber-200 text-amber-900"
                          : item.alertVariant === "success"
                          ? "bg-emerald-50 border-emerald-200 text-emerald-900"
                          : "bg-blue-50 border-blue-200 text-blue-900"
                      }`}
                    >
                      {item.alertTitle && <p class="font-black mb-1">{item.alertTitle}</p>}
                      {item.alertText && <div set:html={formatRichText(item.alertText)} />}
                    </div>
                  )}
                  {item.answer && <div class="mb-2" set:html={formatRichText(item.answer)} />}
                  {Array.isArray(item.bullets) && item.bullets.length > 0 && (
                    <ul class="list-disc pl-5 space-y-1 text-sm sm:text-base mt-2">
                      {item.bullets.map((b: string) => (
                        <li set:html={formatInlineMarkdown(b)} />
                      ))}
                    </ul>
                  )}
                </ContentBlocks>
              ))}
            </ServiceUI>
          );
        }

        return null;
      })}

      {/* Додатковий вільний MDX-контент (якщо доданий редактором у Keystatic) */}
      {hasExtraMarkdownBody && (
        <article class="mt-10 bg-white border-2 border-slate-100 rounded-2xl lg:rounded-[2.5rem] p-6 lg:p-10 shadow-sm prose prose-slate max-w-none">
          <Content />
        </article>
      )}
    </div>
  </main>
</Layout>
