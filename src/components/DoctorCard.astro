---
import type { Doctor } from "../types";
import ImagePlaceholder from "./ImagePlaceholder.astro";

interface Props {
  doctor: Doctor;
}

const { doctor } = Astro.props;
const safeName = doctor?.name || "";
const safeSurname = doctor?.surname || "";
const safeRole = doctor?.role || "Фахівець відділення";
const safeDept = doctor?.department || "Променева терапія";
const safeColor = doctor?.color || "from-slate-600 to-slate-700";
const safeImage = (doctor?.image || "").trim();
const hasPhoto = Boolean(safeImage);
const safeInitials =
  doctor?.initials ||
  `${safeName.charAt(0)}${safeSurname.charAt(0)}`.toUpperCase();
const safeSpecs = Array.isArray(doctor?.specializations) ? doctor.specializations : [];

const isLongName = safeName.length > 10 || safeSurname.length > 10;
const closedTitleClass = isLongName ? "text-2xl md:text-3xl" : "text-3xl md:text-4xl";
const expandedTitleClass = isLongName ? "text-xl md:text-2xl" : "text-2xl md:text-3xl";
---

<div
  class={`doctor-card ${!hasPhoto ? "doctor-card--placeholder" : ""} group relative h-[550px] rounded-[2.5rem] overflow-hidden cursor-pointer shadow-xl border ${hasPhoto ? "border-white/20 bg-slate-200" : "border-sky-200/80 bg-sky-50"} transition-all duration-500 hover:-translate-y-2`}
  data-name={`${safeName} ${safeSurname}`}
  data-role={safeRole}
  data-dept={safeDept}
>
  <div class={`absolute inset-0 overflow-hidden ${hasPhoto ? "bg-slate-200" : "bg-sky-50"}`}>
    {hasPhoto ? (
      <>
        <img
          src={safeImage}
          alt={`${safeName} ${safeSurname}`}
          width="450"
          height="550"
          loading="lazy"
          decoding="async"
          class="card-image w-full h-full object-cover transition-transform duration-700 pointer-events-none group-[.is-expanded]:scale-110"
          referrerpolicy="no-referrer"
        />
        <div class="card-overlay absolute inset-0 bg-gradient-to-t from-black/95 via-black/10 to-transparent opacity-100 group-[.is-expanded]:opacity-30 transition-opacity duration-500"></div>
      </>
    ) : (
      <>
        <ImagePlaceholder
          variant="staff"
          initials={safeInitials}
          title={`${safeName} ${safeSurname}`}
          subtitle={safeDept}
          size="lg"
          class="pb-44"
        />
        <div class="card-overlay absolute inset-x-0 bottom-0 h-[52%] bg-gradient-to-t from-white via-sky-50/92 to-transparent pointer-events-none"></div>
      </>
    )}
  </div>

  <div class="card-closed absolute inset-0 p-8 flex flex-col justify-end transition-all duration-500 group-[.is-expanded]:opacity-0 group-[.is-expanded]:pointer-events-none">
    {doctor?.badge ? (
      <div class="status-rotator-container overflow-hidden h-[44px] mb-4">
        <div class="status-rotator-track flex flex-col animate-rotate-status">
          <div class="h-[44px] flex items-center">
            <div class={`inline-block bg-gradient-to-r ${safeColor} text-[9px] font-bold text-white px-4 py-2 rounded-xl tracking-widest uppercase shadow-lg whitespace-nowrap`}>
              {safeRole}
            </div>
          </div>

          <div class="h-[38px] flex items-center">
            <div class="inline-block bg-white/95 backdrop-blur-sm text-[9px] font-black text-[#1a365d] px-4 py-1.5 rounded-xl tracking-widest uppercase shadow-lg border border-sky-200/70 leading-tight max-w-[240px]">
              {doctor.badge}
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="h-[44px] flex items-center mb-4">
        <div class={`inline-block bg-gradient-to-r ${safeColor} text-[9px] font-bold text-white px-4 py-2 rounded-xl tracking-widest uppercase shadow-lg ring-1 ring-white/10 whitespace-nowrap`}>
          {safeRole}
        </div>
      </div>
    )}

    <h3 class={`font-serif ${closedTitleClass} font-bold ${hasPhoto ? "text-white" : "text-[#1a365d]"} leading-[1.1] mb-4`}>
      {safeName}<br />{safeSurname}
    </h3>

    <div class={`flex items-center gap-2 ${hasPhoto ? "text-white/80" : "text-blue-700"}`}>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      <span class="text-[10px] font-bold tracking-widest uppercase">Детальна анкета</span>
    </div>
  </div>

  <div class="card-expanded absolute inset-0 z-30 bg-white flex flex-col translate-y-full group-[.is-expanded]:translate-y-0 transition-transform duration-500 ease-[cubic-bezier(0.4,0,0.2,1)]">
    <div class="pt-4 flex justify-center">
      <div class="w-12 h-1 bg-slate-200 rounded-full"></div>
    </div>

    <div class="flex-1 overflow-y-auto px-6 md:px-8 py-6 custom-scrollbar text-[#1a2b3b]">
      <div class="flex items-center gap-4 md:gap-6 mb-8">
        <div class="w-20 h-20 md:w-24 md:h-24 rounded-full overflow-hidden border-4 border-[#f8fafc] shadow-2xl flex-shrink-0 bg-sky-50">
          {hasPhoto ? (
            <img
              src={safeImage}
              alt={safeName}
              width="96"
              height="96"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
              referrerpolicy="no-referrer"
            />
          ) : (
            <ImagePlaceholder
              variant="staff"
              initials={safeInitials}
              title={`${safeName} ${safeSurname}`}
              size="avatar"
            />
          )}
        </div>
        <div class="min-w-0">
          <h4 class={`${expandedTitleClass} font-serif font-bold leading-tight text-[#1a365d]`}>
            {safeName}<br />{safeSurname}
          </h4>

          {doctor?.badge && (
            <div class="inline-flex items-center px-2.5 py-1 bg-slate-100 border border-slate-200 text-[#1a365d] text-[9px] font-black uppercase tracking-widest rounded-lg mt-3">
              <span class="w-1.5 h-1.5 rounded-full bg-[#1a365d] mr-2"></span>
              {doctor.badge}
            </div>
          )}

          <span class="text-[9px] md:text-[10px] font-bold text-slate-400 uppercase tracking-widest block mt-2">
            {safeRole}
          </span>
        </div>
      </div>

      <div class="space-y-6">
        {doctor?.bio && (
          <div class="relative p-5 bg-[#f8fafc] rounded-3xl border-l-[6px] border-[#1a365d]/10">
            <p class="italic text-sm md:text-base text-slate-600 leading-relaxed font-serif pl-2">
              "{doctor.bio}"
            </p>
          </div>
        )}

        <div class="grid grid-cols-2 gap-4 md:gap-6 border-b border-slate-100 pb-6">
          <div>
            <span class="block text-slate-400 uppercase tracking-widest mb-1.5 text-[9px] md:text-[10px] font-bold">Досвід</span>
            <p class="text-xl md:text-2xl font-bold text-[#1a365d]">{doctor?.experience || "—"}</p>
          </div>
          <div>
            <span class="block text-slate-400 uppercase tracking-widest mb-1.5 text-[9px] md:text-[10px] font-bold">Відділення</span>
            <p class="text-xs md:text-sm font-bold uppercase tracking-wide leading-tight text-[#1a365d]">{safeDept}</p>
          </div>
        </div>

        {doctor?.education && doctor.education !== "-" && (
          <div class="border-b border-slate-100 pb-6">
            <span class="block text-slate-400 uppercase tracking-widest mb-2 text-[9px] md:text-[10px] font-bold">Освіта</span>
            <p class="text-xs md:text-sm font-medium text-slate-700 leading-relaxed">{doctor.education}</p>
          </div>
        )}

        {doctor?.achievements && (
          <div class="border-b border-slate-100 pb-6">
            <span class="block text-slate-400 uppercase tracking-widest mb-2 text-[9px] md:text-[10px] font-bold">Досягнення</span>
            <p class="text-xs md:text-sm font-medium text-slate-700 leading-relaxed">{doctor.achievements}</p>
          </div>
        )}

        {safeSpecs.length > 0 && (
          <div class="pb-4">
            <span class="block text-slate-400 uppercase tracking-widest mb-3 text-[9px] md:text-[10px] font-bold">Ключові напрямки</span>
            <div class="flex flex-wrap gap-2">
              {safeSpecs.map((spec) => (
                <span class="px-3 py-1.5 bg-[#1a365d]/5 text-[#1a365d] text-[9px] font-bold rounded-lg uppercase tracking-wide border border-[#1a365d]/10">
                  {spec}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes rotate-status {
    0%, 40% { transform: translateY(0); }
    50%, 90% { transform: translateY(-38px); }
    100% { transform: translateY(0); }
  }

  .animate-rotate-status {
    animation: rotate-status 6s infinite ease-in-out;
  }

  .doctor-card:global(.is-expanded) {
    z-index: 50;
  }
  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
</style>
