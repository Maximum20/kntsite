---
import { Icon } from "astro-icon/components";
import { siteSettings } from "../data";
import { buildSiteSearchData, type SearchIconKey } from "../utils/searchIndex";

const { searchIndex, quickChipsPool, quickCardsPool, emptyState } =
  await buildSiteSearchData();

const initialChips = quickChipsPool.slice(0, 4);
const initialCards = quickCardsPool.slice(0, 6);

// Єдина система мінімалістичних контурних SVG-іконок (без емодзі)
const ICON_PATHS: Record<SearchIconKey, string> = {
  accelerator:
    '<path d="M13 2L4.5 13.5H11.5L10.5 22L19.5 10.5H12.5L13 2Z" />',
  ct:
    '<circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="4.5" /><path d="M12 3v2M12 19v2M3 12h2M19 12h2" />',
  brachy:
    '<circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3" />',
  gamma:
    '<circle cx="12" cy="12" r="2.2" /><path d="M12 3a9 9 0 0 1 7.8 4.5M19.8 16.5A9 9 0 0 1 12 21M4.2 16.5A9 9 0 0 1 4.2 7.5" /><path d="M8.5 8.5l2 2M15.5 8.5l-2 2M12 14.5V17" />',
  nearfocus:
    '<path d="M12 3L3 8l9 5 9-5-9-5Z" /><path d="M3 12.5l9 5 9-5" /><path d="M3 17l9 5 9-5" />',
  rehab:
    '<path d="M3.5 12h3.5l2.2-5 3.6 10 2.2-5h5.5" />',
  doctor:
    '<circle cx="12" cy="8" r="3.5" /><path d="M5.5 20a6.5 6.5 0 0 1 13 0" /><path d="M12 14v3M10.5 15.5h3" />',
  team:
    '<circle cx="9" cy="8" r="3" /><path d="M3.5 19.5a5.5 5.5 0 0 1 11 0" /><circle cx="16.5" cy="9" r="2.3" /><path d="M16.5 14a4.5 4.5 0 0 1 4 4.5" />',
  phone:
    '<path d="M5.5 4.5h3.2l1.5 4-2 1.6a11.5 11.5 0 0 0 5.7 5.7l1.6-2 4 1.5v3.2a1.8 1.8 0 0 1-1.9 1.8A15.4 15.4 0 0 1 3.7 6.4 1.8 1.8 0 0 1 5.5 4.5Z" />',
  clock:
    '<circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.2 2" />',
  location:
    '<path d="M12 21s6.5-5.8 6.5-11a6.5 6.5 0 1 0-13 0c0 5.2 6.5 11 6.5 11Z" /><circle cx="12" cy="10" r="2.3" />',
  shield:
    '<path d="M12 3l7.5 3v5.5c0 4.7-3.1 8.4-7.5 9.8-4.4-1.4-7.5-5.1-7.5-9.8V6L12 3Z" /><path d="M9 12l2 2 4-4" />',
  route:
    '<rect x="5" y="4" width="14" height="17" rx="2.5" /><path d="M9 4.5h6M9 10h6M9 14h4M9 17.5h3" />',
  news:
    '<path d="M5 5.5A1.5 1.5 0 0 1 6.5 4h11A1.5 1.5 0 0 1 19 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 18.5v-13Z" /><path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4.5" />',
  briefcase:
    '<rect x="3.5" y="7.5" width="17" height="12" rx="2.2" /><path d="M9 7.5V5.8A1.8 1.8 0 0 1 10.8 4h2.4A1.8 1.8 0 0 1 15 5.8v1.7M3.5 12.5h17" />',
  spark:
    '<path d="M12 3l1.9 5.6L19.5 10.5l-5.6 1.9L12 18l-1.9-5.6L4.5 10.5l5.6-1.9L12 3Z" /><path d="M18.5 4v2.5M17.25 5.25h2.5" />',
  building:
    '<path d="M4.5 20V6.5A1.5 1.5 0 0 1 6 5h12a1.5 1.5 0 0 1 1.5 1.5V20M3 20h18M9 9h1.5M13.5 9H15M9 13h1.5M13.5 13H15M10.5 20v-3.5h3V20" />',
};

const renderIconSvg = (key: SearchIconKey) =>
  ICON_PATHS[key] || ICON_PATHS.building;
---

{/* --- 1. КНОПКИ В ШАПЦІ (без змін верстки) --- */}
<div class="flex items-center gap-2.5 mr-1 xl:mr-4 xl:ml-2">
  {/* БУЛЬБАШКА СОЦМЕРЕЖ */}
  <div class="hidden xl:flex items-center gap-3.5 bg-white/60 p-2 px-3.5 rounded-full border border-slate-200/50 shadow-sm backdrop-blur-md transition-all hover:shadow-md hover:bg-white/80">
    {siteSettings.socials.facebook && (
      <a href={siteSettings.socials.facebook} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-blue-600 transition-all hover:scale-110" aria-label="Facebook">
        <Icon name="bx:bxl-facebook-circle" class="w-5 h-5" />
      </a>
    )}
    {siteSettings.socials.telegram && (
      <a href={siteSettings.socials.telegram} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-sky-500 transition-all hover:scale-110" aria-label="Telegram">
        <Icon name="bx:bxl-telegram" class="w-5 h-5" />
      </a>
    )}
    {siteSettings.socials.instagram && (
      <a href={siteSettings.socials.instagram} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-pink-500 transition-all hover:scale-110" aria-label="Instagram">
        <Icon name="bx:bxl-instagram" class="w-5 h-5" />
      </a>
    )}
    {siteSettings.socials.youtube && (
      <a href={siteSettings.socials.youtube} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-red-600 transition-all hover:scale-110" aria-label="YouTube">
        <Icon name="bx:bxl-youtube" class="w-5 h-5" />
      </a>
    )}
    {siteSettings.socials.tiktok && (
      <a href={siteSettings.socials.tiktok} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-slate-900 transition-all hover:scale-110" aria-label="TikTok">
        <Icon name="bx:bxl-tiktok" class="w-5 h-5" />
      </a>
    )}
  </div>

  {/* БУЛЬБАШКА ПОШУКУ */}
  <div class="flex items-center w-full xl:w-auto">
    <button
      id="search-trigger"
      type="button"
      class="group relative flex items-center justify-start h-10 w-full xl:w-10 xl:hover:w-60 bg-blue-600 text-white rounded-full transition-all duration-500 ease-in-out overflow-hidden shadow-lg shadow-blue-500/20 active:scale-95 cursor-pointer px-3 xl:px-0"
      aria-label="Відкрити розумний пошук по сайту (Ctrl+K)"
    >
      <div class="flex items-center justify-center min-w-[28px] xl:min-w-[40px] h-10 shrink-0">
        <Icon name="bx:bx-search" class="w-5 h-5" />
      </div>
      <span class="whitespace-nowrap opacity-100 xl:opacity-0 xl:group-hover:opacity-100 transition-opacity duration-300 xl:delay-100 font-bold text-[13px] tracking-tight pr-4">
        Знайти інформацію на сайті
      </span>
    </button>
  </div>
</div>

{/* --- 2. МОДАЛЬНЕ ВІКНО РОЗУМНОГО ПОШУКУ --- */}
<div
  id="search-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Пошук по сайту"
  class="fixed inset-0 z-[999] hidden bg-slate-950/55 backdrop-blur-md items-start md:items-center justify-center p-0 md:p-6 font-sans"
>
  <div class="search-modal-surface bg-white w-full h-[100dvh] md:h-auto md:max-h-[85vh] md:max-w-3xl rounded-none md:rounded-3xl shadow-[0_24px_64px_rgba(15,23,42,0.22)] overflow-hidden flex flex-col border-0 md:border md:border-slate-200/80 transition-all">

    {/* ВЕРХНЯ ПАНЕЛЬ І ПОЛЕ ВВОДУ */}
    <div class="px-4 pt-4 pb-3.5 sm:px-6 sm:pt-5 sm:pb-4 bg-white border-b border-slate-100 shrink-0">
      <div class="flex items-center justify-between mb-3">
        <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-400">
          Пошук по сайту
        </span>
        <div class="flex items-center gap-2.5">
          <div class="hidden sm:flex items-center gap-1.5 text-[11px] text-slate-400">
            <kbd class="search-kbd px-1.5 py-0.5 rounded-md bg-slate-100 text-slate-500 font-sans font-medium text-[10px]">↑↓</kbd>
            <span>навігація</span>
            <span class="text-slate-300">·</span>
            <kbd class="search-kbd px-1.5 py-0.5 rounded-md bg-slate-100 text-slate-500 font-sans font-medium text-[10px]">Enter</kbd>
            <span>перехід</span>
            <span class="text-slate-300">·</span>
            <kbd class="search-kbd px-1.5 py-0.5 rounded-md bg-slate-100 text-slate-500 font-sans font-medium text-[10px]">Esc</kbd>
            <span>закрити</span>
          </div>
          <button
            id="modal-close-btn"
            type="button"
            class="w-8 h-8 flex items-center justify-center rounded-xl bg-slate-100/90 hover:bg-slate-200/90 text-slate-500 hover:text-slate-800 transition-colors cursor-pointer shrink-0"
            aria-label="Закрити вікно пошуку"
            title="Закрити (Esc)"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 6L6 18M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      {/* Поле вводу */}
      <div class="search-input-shell relative flex items-center gap-2.5 bg-slate-50/80 px-3.5 sm:px-4 py-3 rounded-2xl border border-slate-200/90 focus-within:bg-white focus-within:border-sky-400 focus-within:ring-4 focus-within:ring-sky-500/10 transition-all">
        <svg class="w-5 h-5 text-sky-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7.5" />
          <path d="M20 20l-3.8-3.8" />
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="Введіть слово або літеру (прискорювач, КТ, НСЗУ, лікар, Космічна)..."
          class="bg-transparent border-none outline-none w-full font-medium text-slate-800 placeholder:text-slate-400 placeholder:font-normal text-sm sm:text-[15px]"
          autocomplete="off"
          spellcheck="false"
        />
        <button
          id="search-clear-btn"
          type="button"
          class="hidden w-7 h-7 rounded-full bg-slate-200/80 hover:bg-slate-300/90 text-slate-600 hover:text-slate-900 items-center justify-center transition-colors cursor-pointer shrink-0 text-base leading-none"
          aria-label="Очистити поле пошуку"
          title="Очистити"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    {/* ОСНОВНА ОБЛАСТЬ: ПІДКАЗКИ ТА ЖИВІ РЕЗУЛЬТАТИ */}
    <div id="search-scroll-area" class="flex-1 overflow-y-auto px-4 py-4 sm:px-6 sm:py-5 custom-scrollbar">

      {/* СТАН ДО ВВЕДЕННЯ ЗАПИТУ */}
      <div id="suggestions-box" class="space-y-5">
        {/* Блок "Часто шукають" — строго ОДИН ряд (4 чіпи на десктопі) */}
        <div>
          <div class="flex items-center justify-between gap-2 mb-2.5">
            <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-400">
              Часто шукають
            </p>
            <button
              id="shuffle-suggestions-btn"
              type="button"
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium text-sky-600 hover:text-sky-700 hover:bg-sky-50/90 transition-colors cursor-pointer"
            >
              <svg id="shuffle-icon" class="w-3.5 h-3.5 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12a9 9 0 0 0-15.3-6.4L3 8" />
                <path d="M3 3v5h5" />
                <path d="M3 12a9 9 0 0 0 15.3 6.4L21 16" />
                <path d="M16 16h5v5" />
              </svg>
              <span>Оновити підбірку</span>
            </button>
          </div>

          <div
            id="quick-chips-list"
            class="flex flex-nowrap overflow-x-auto no-scrollbar gap-2 pb-1 -mx-1 px-1 md:grid md:grid-cols-4 md:overflow-visible md:pb-0 md:mx-0 md:px-0"
          >
            {initialChips.map((chip) => (
              <button
                type="button"
                class="tag-btn search-chip group inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-50 hover:bg-sky-50 text-slate-700 hover:text-sky-700 text-xs font-medium transition-all active:scale-[0.98] cursor-pointer border border-slate-200/80 hover:border-sky-200 whitespace-nowrap shrink-0 md:w-full md:min-w-0"
                data-query={chip.query}
                data-chip-id={chip.id}
              >
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-sky-500 shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" />
                  <path d="M20 20l-3.5-3.5" />
                </svg>
                <span class="truncate">{chip.label}</span>
              </button>
            ))}
          </div>
        </div>

        {/* Блок швидких переходів — рівно 6 карток (2 колонки × 3 ряди на десктопі, 1 на мобільних) */}
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-400 mb-2.5">
            Швидкі переходи
          </p>
          <div id="default-cards-list" class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
            {initialCards.map((card) => (
              <a
                href={card.href}
                data-card-id={card.id}
                class="search-nav-item search-card group flex items-center justify-between gap-3 p-3 rounded-2xl bg-slate-50/70 hover:bg-sky-50/60 border border-slate-200/75 hover:border-sky-200 transition-all"
              >
                <div class="flex items-center gap-3 min-w-0">
                  <span class="search-icon-tile w-9 h-9 rounded-xl bg-sky-50/90 text-sky-600 border border-sky-100/90 flex items-center justify-center shrink-0 group-hover:bg-sky-100/80 group-hover:text-sky-700 transition-colors">
                    <svg
                      class="w-[18px] h-[18px]"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={renderIconSvg(card.icon)}
                    />
                  </span>
                  <div class="min-w-0">
                    <span class="block text-[10px] font-semibold uppercase tracking-wider text-sky-600/90 leading-tight mb-0.5">
                      {card.badge}
                    </span>
                    <span class="block text-[13px] sm:text-sm font-semibold text-slate-800 group-hover:text-sky-700 truncate leading-snug">
                      {card.title}
                    </span>
                    {card.subtitle && (
                      <span class="block text-[11px] text-slate-500 truncate mt-0.5 leading-tight">
                        {card.subtitle}
                      </span>
                    )}
                  </div>
                </div>
                <svg class="w-4 h-4 text-slate-300 group-hover:text-sky-500 group-hover:translate-x-0.5 transition-all shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 6l6 6-6 6" />
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>

      {/* ЖИВІ РЕЗУЛЬТАТИ ПОШУКУ */}
      <div id="results-container" class="hidden space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2 px-0.5">
          <div class="flex items-center gap-2">
            <span id="results-count" class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-400">
              Знайдено: 0
            </span>
            <span
              id="layout-hint"
              class="hidden inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-sky-50 text-sky-700 border border-sky-200/70 text-[11px] font-medium"
            ></span>
          </div>
          <span class="hidden sm:inline text-[11px] text-slate-400">
            Натисніть <kbd class="search-kbd px-1.5 py-0.5 bg-slate-100 rounded text-slate-600 font-medium">Enter</kbd> для переходу
          </span>
        </div>
        <div id="results-list" class="space-y-2" role="listbox"></div>
      </div>

    </div>

    {/* НИЖНІЙ КОЛОНТИТУЛ */}
    <div class="px-4 sm:px-6 py-3 bg-slate-50/80 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500 shrink-0">
      <a
        href={emptyState.phoneTel}
        class="inline-flex items-center gap-2 text-slate-600 hover:text-sky-700 transition-colors"
      >
        <svg class="w-4 h-4 text-sky-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5.5 4.5h3.2l1.5 4-2 1.6a11.5 11.5 0 0 0 5.7 5.7l1.6-2 4 1.5v3.2a1.8 1.8 0 0 1-1.9 1.8A15.4 15.4 0 0 1 3.7 6.4 1.8 1.8 0 0 1 5.5 4.5Z" />
        </svg>
        <span>
          Реєстратура: <strong class="font-semibold text-slate-700">{emptyState.phone}</strong>
        </span>
      </a>
      <a
        href="/#contacts"
        class="search-quick-close-link font-medium text-sky-600 hover:text-sky-700 hover:underline inline-flex items-center gap-1"
      >
        <span>Усі контакти та адреси</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>

  </div>
  <div id="search-close" class="fixed inset-0 -z-10 cursor-pointer"></div>
</div>

<script
  is:inline
  define:vars={{
    searchIndex,
    quickChipsPool,
    quickCardsPool,
    emptyState,
    ICON_PATHS,
  }}
>
  (function initSmartSiteSearch() {
    const MIN_QUERY_LENGTH = 1;
    const CHIPS_PER_ROW = 4;
    const CARDS_PER_GRID = 6;
    const MAX_RESULTS = 12;

    // Конвертація помилкової англійської розкладки в українську (+ російський фолбек для 3 клавіш)
    const EN_TO_UA = {
      q: "й", w: "ц", e: "у", r: "к", t: "е", y: "н", u: "г", i: "ш", o: "щ", p: "з", "[": "х", "]": "ї",
      a: "ф", s: "і", d: "в", f: "а", g: "п", h: "р", j: "о", k: "л", l: "д", ";": "ж", "'": "є",
      z: "я", x: "ч", c: "с", v: "м", b: "и", n: "т", m: "ь", ",": "б", ".": "ю", "`": "'",
    };
    const EN_TO_RU = {
      ...EN_TO_UA,
      s: "ы",
      "'": "э",
      "]": "ъ",
      "`": "ё",
    };

    // Багатий словник асоціацій (українська + російська + суржик + побутові запити пацієнтів)
    const SYNONYM_GROUPS = [
      {
        triggers: [
          "лінак", "линак", "лінійник", "линейник", "лінійний", "линейный",
          "прискорювач", "ускоритель", "elekta", "електа", "электа",
          "versa", "верса", "synergy", "сінерджі", "синерджи", "linac",
          "опромінення", "облучение", "лучевая", "лучевая терапия", "промені", "лучи",
          "променева", "радіотерапія", "радиотерапия", "мегавольтна", "мегавольтная",
          "imrt", "vmat", "igrt", "sbrt", "srs", "sgrt", "dibh", "апарат", "аппарат"
        ],
        targets: ["лінійний прискорювач", "мегавольтна", "elekta", "versa hd", "synergy", "променева терапія"]
      },
      {
        triggers: [
          "brainlab", "брейнлаб", "exactrac", "стереотаксис", "радіохірургія",
          "радиохирургия", "кіберніж", "кибернож", "дихання", "дыхание", "теплова камера"
        ],
        targets: ["brainlab", "versa hd", "стереотаксис", "мрія здійснилась"]
      },
      {
        triggers: [
          "брахітерапія", "брахитерапия", "брахі", "брахи", "контактна", "контактная",
          "внутрішньопорожнинна", "внутриполостная", "bebig", "multisource", "hdr",
          "іридій", "иридий", "аплікатор", "аппликатор", "гінекологія", "гинекология",
          "матка", "шийка", "шейка", "ендометрій", "эндометрий", "простата"
        ],
        targets: ["брахітерапія", "контактна", "bebig"]
      },
