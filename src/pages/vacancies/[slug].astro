---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from "astro-icon/components";
import Layout from '../../layouts/Layout.astro';

// 1. Отримуємо slug прямо з параметрів URL (назва файлу [slug].astro)
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/vacancies');
}

// 2. Завантажуємо конкретну вакансію з колекції за її ID/slug
const entry = await getEntry('vacancies', slug);

// Якщо такої вакансії немає (наприклад, ввели неправильний URL) — кидаємо на 404
if (!entry) {
  return Astro.redirect('/404');
}

// 3. Рендеримо MDX контент
const { Content } = await render(entry);
---

<Layout title={`${entry.data?.title || 'Вакансія'} | Центр`}>
  <main class="py-16 md:py-24 bg-slate-50/50">
    <div class="container mx-auto px-5 max-w-4xl">
      
      <a href="/vacancies" class="inline-flex items-center gap-2 text-slate-400 hover:text-blue-600 transition-colors mb-8 font-bold uppercase text-[10px] tracking-[0.2em]">
        <Icon name="bx:left-arrow-alt" class="w-5 h-5" /> Назад до вакансій
      </a>

      <div class="bg-white p-8 md:p-12 rounded-[2.5rem] border border-slate-100 shadow-xl shadow-slate-200/20 mb-12">
        <div class="flex items-center gap-3 mb-6">
          {entry.data?.isActive !== false ? (
            <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-emerald-50 text-emerald-700 text-[10px] font-black uppercase tracking-widest rounded-lg">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Актуальна вакансія
            </span>
          ) : (
            <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-slate-100 text-slate-500 text-[10px] font-black uppercase tracking-widest rounded-lg">
              <span class="w-2 h-2 rounded-full bg-slate-400"></span> Архів
            </span>
          )}
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6 leading-tight">{entry.data?.title}</h1>
        <p class="text-slate-500 text-lg font-medium leading-relaxed">{entry.data?.description || ''}</p>
      </div>

      {entry.data?.benefits && entry.data.benefits.length > 0 && (
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-slate-900 mb-6 px-2">Що ми пропонуємо:</h2>
          <div class="grid gap-6 md:grid-cols-2">
            {entry.data.benefits.map((benefit) => (
              <div class="bg-white rounded-3xl border border-slate-100 p-6 flex flex-col gap-4 shadow-sm hover:shadow-md transition-shadow overflow-hidden group">
                {benefit.image && (
                  <div class="aspect-[16/9] overflow-hidden rounded-2xl relative">
                    <Image src={benefit.image} alt={benefit.title || 'Benefit'} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  </div>
                )}
                <h3 class="font-bold text-slate-800 text-lg leading-snug">{benefit.title}</h3>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Основний текст вакансії -->
      <div class="bg-white p-8 md:p-12 rounded-[2.5rem] border border-slate-100 shadow-sm prose prose-slate max-w-none">
        <Content />
      </div>

      <!-- 👇 БЛОК КОНТАКТІВ ВСТАВЛЕНО СЮДИ -->
      {entry.data?.contacts && (entry.data.contacts.phone || entry.data.contacts.email || entry.data.contacts.messengerUrl) && (
        <div class="mt-12 bg-gradient-to-br from-blue-600 to-indigo-700 rounded-[2.5rem] p-8 md:p-12 text-white shadow-xl shadow-blue-500/20 flex flex-col lg:flex-row items-center justify-between gap-8">
          <div class="max-w-md text-center lg:text-left">
            <h2 class="text-3xl font-black mb-3 tracking-tight">Зацікавила вакансія?</h2>
            <p class="text-blue-100 font-medium leading-relaxed">
              Не відкладайте! Зв'яжіться з нами прямо зараз телефоном, у месенджерах або надсилайте своє резюме на пошту.
            </p>
          </div>
          
          <div class="flex flex-col sm:flex-row lg:flex-col xl:flex-row gap-4 w-full lg:w-auto justify-center">
            {entry.data.contacts.phone && (
              <a href={`tel:${entry.data.contacts.phone.replace(/\s+/g, '')}`} class="flex items-center justify-center gap-3 px-6 py-4 bg-white text-blue-600 font-bold rounded-2xl hover:bg-blue-50 transition-all shadow-md text-sm whitespace-nowrap">
                <Icon name="bx:phone" class="w-5 h-5 text-blue-500" />
                {entry.data.contacts.phone}
              </a>
            )}

            {entry.data.contacts.messengerUrl && (
              <a href={entry.data.contacts.messengerUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-3 px-6 py-4 bg-sky-500/20 backdrop-blur-md text-white border border-sky-400/30 font-bold rounded-2xl hover:bg-sky-500/30 transition-all text-sm whitespace-nowrap">
                <Icon name="bx:message-rounded-dots" class="w-5 h-5 text-sky-300" />
                {entry.data.contacts.messengerName || 'Messenger'}
              </a>
            )}

            {entry.data.contacts.email && (
              <a href={`mailto:${entry.data.contacts.email}`} class="flex items-center justify-center gap-3 px-6 py-4 bg-white/10 backdrop-blur-md text-white border border-white/10 font-bold rounded-2xl hover:bg-white/20 transition-all text-sm whitespace-nowrap">
                <Icon name="bx:envelope" class="w-5 h-5 text-blue-200" />
                {entry.data.contacts.email}
              </a>
            )}
          </div>
        </div>
      )}

    </div>
  </main>
</Layout>