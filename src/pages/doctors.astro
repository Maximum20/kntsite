---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import DoctorCard from "../components/DoctorCard.astro";
import SearchBar from "../components/SearchBar.astro";
import { Icon } from "astro-icon/components";
import { doctors } from "../data";
import TeamGallery from "@components/TeamGallery.astro";

// Активні працівники вже відфільтровані (isActive: true) і відсортовані (order -> алфавіт)
const boss = doctors.find((d) => d.isHead) || doctors.find((d) => d.surname === "Сніжинська");
const otherStaff = doctors.filter((d) => d !== boss);

// Візуальний поділ на 2 групи за полем group обраної посади
const doctorGroup = otherStaff.filter((d) => d.roleGroup === "doctors");
const specialistGroup = otherStaff.filter((d) => d.roleGroup === "specialists");
---

<Layout title="Наша команда" hideSubNav={true}>
  <main class="min-h-screen py-8 px-4 md:px-8 bg-slate-50/50">
    <!-- Навігація -->
    <div class="relative z-20 px-2 md:px-12 flex items-center mb-12">
      <a href="/" class="inline-flex items-center gap-4 group">
        <div class="w-12 h-12 rounded-full backdrop-blur-xl bg-white/60 border border-white/80 flex items-center justify-center group-hover:bg-white/90 transition-all shadow-lg shadow-slate-200/40">
          <Icon name="bx:left-arrow-alt" class="w-6 h-6 text-slate-700 group-hover:-translate-x-1 transition-transform" />
        </div>
        <span class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">На головну</span>
      </a>
    </div>

    <header class="text-center mb-12">
      <h1 class="font-serif text-5xl md:text-6xl font-bold text-[#1a365d] mb-6 tracking-tight">
        Наша велика команда
      </h1>
      <p class="text-[10px] md:text-xs font-bold tracking-[0.4em] text-slate-400 uppercase">
        Професіоналізм • Турбота • Технології
      </p>
    </header>

    <!-- Компонент пошуку та фільтрації персоналу -->
    <SearchBar />

    <div class="container mx-auto px-4 mt-16">
      <!-- 1. АКЦЕНТНИЙ БЛОК: Керівництво відділення -->
      {boss && (
        <div id="headSection" class="flex flex-col lg:flex-row items-center justify-center gap-10 lg:gap-16 mb-24 max-w-6xl mx-auto px-2">
          <div class="w-full max-w-[400px] shrink-0 relative z-10">
            <DoctorCard doctor={boss} />
          </div>

          <div class="relative w-full max-w-xl">
            <div class="absolute -top-10 -left-10 w-32 h-32 bg-blue-100 rounded-full blur-3xl opacity-40 -z-10"></div>

            <div class="bg-white/80 backdrop-blur-md p-8 md:p-12 rounded-[3rem] border border-white shadow-xl shadow-slate-200/50 relative">
              <span class="inline-block text-amber-600 font-black tracking-[0.2em] uppercase text-[10px] mb-4 px-4 py-1.5 bg-amber-50 rounded-full">
                Очільниця команди
              </span>

              <h2 class="text-3xl md:text-4xl font-serif font-bold text-[#1a365d] mb-6 leading-tight">
                Керівництво відділення
              </h2>

              <div class="space-y-6">
                <p class="text-slate-600 text-base md:text-lg leading-relaxed font-medium italic border-l-4 border-[#1a365d]/20 pl-6">
                  "Робота нашого відділення побудована на високих міжнародних стандартах. Ми об'єднали кращих спеціалістів, щоб забезпечити точність та безпеку для кожного пацієнта."
                </p>

                <div class="pt-4 mt-8 border-t border-slate-100">
                  <span class="block text-[10px] font-black uppercase tracking-[0.3em] text-slate-400 mb-2">
                    {boss.badge || "Завідувачка відділення"}
                  </span>
                  <p class="font-serif text-xl md:text-2xl font-bold text-[#1a365d]">
                    {boss.fullNamePatronymic || `${boss.surname} ${boss.name}`}
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      <!-- 2. СЕКЦІЯ 1: Лікарі (group === "doctors") -->
      {doctorGroup.length > 0 && (
        <section id="doctorsGroupSection" data-staff-section="doctors" class="mb-20">
          <div class="text-center mb-12">
            <h2 class="text-2xl md:text-3xl font-serif font-bold text-[#1a365d]">
              Лікарі
            </h2>
            <div class="w-16 h-1 bg-[#1a365d]/20 mx-auto mt-4 rounded-full"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 max-w-7xl mx-auto">
            {doctorGroup.map((doctor) => (
              <div class="doctor-wrapper transition-all duration-500 opacity-100 translate-y-0">
                <DoctorCard doctor={doctor} />
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- 3. СЕКЦІЯ 2: Медичні фізики, інженери та рентгенлаборанти (group === "specialists") -->
      {specialistGroup.length > 0 && (
        <section id="specialistsGroupSection" data-staff-section="specialists" class="mb-20">
          <div class="text-center mb-12">
            <h2 class="text-2xl md:text-3xl font-serif font-bold text-[#1a365d]">
              Медичні фізики, інженери та рентгенлаборанти
            </h2>
            <div class="w-16 h-1 bg-[#1a365d]/20 mx-auto mt-4 rounded-full"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 max-w-7xl mx-auto">
            {specialistGroup.map((doctor) => (
              <div class="doctor-wrapper transition-all duration-500 opacity-100 translate-y-0">
                <DoctorCard doctor={doctor} />
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Повідомлення про відсутність результатів (для пошуку та фільтрів) -->
      <div id="noResults" class="hidden text-center py-20">
        <Icon name="bx:search-alt" class="w-16 h-16 text-slate-200 mx-auto mb-4" />
        <p class="text-slate-400 text-xl font-serif italic">Спеціалістів не знайдено за вашим запитом...</p>
      </div>
    </div>

    <TeamGallery />
  </main>
</Layout>

<style>
  .doctor-wrapper.is-visible {
    display: block !important;
    opacity: 1 !important;
    transform: translateY(0) !important;
    animation: fadeInUp 0.5s ease forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  function initTeamPage() {
    // Відкриваємо зворотну анкету лише для карток, де дозволено переворот
    const cards = document.querySelectorAll('.doctor-card[data-flippable="true"]');
    cards.forEach((card) => {
      if (card.hasAttribute("data-card-bound")) return;
      card.setAttribute("data-card-bound", "true");
      card.addEventListener("click", () => {
        if (card.classList.contains("is-expanded")) {
          card.classList.remove("is-expanded");
        } else {
          cards.forEach((c) => c.classList.remove("is-expanded"));
          card.classList.add("is-expanded");
        }
      });
    });
  }

  initTeamPage();
  document.addEventListener("astro:after-swap", initTeamPage);
</script>
