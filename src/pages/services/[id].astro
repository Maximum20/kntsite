---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const serviceEntries = await getCollection("services");

  return serviceEntries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
if (!entry) {
  return Astro.redirect("/");
}

const { Content } = await render(entry);
---

<Layout title={entry.data?.title || "Відділення"} description={entry.data?.description}>
  <main class="w-full font-sans">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-10 pt-10 sm:pt-20 pb-32">
      <Content />
    </div>
  </main>
</Layout>
