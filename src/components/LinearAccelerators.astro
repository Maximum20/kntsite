---
import { equipmentData } from "../data";

const accelerators =
  equipmentData.accelerators && equipmentData.accelerators.length > 0
    ? equipmentData.accelerators
    : [
        {
          name: "Elekta Synergy Platform",
          image: "/hero/platform.jpg",
          imaging: "iView",
          controlSystem: "",
          description:
            "Надійна платформа з перевіреною системою візуалізації для точного позиціонування пацієнта",
        },
        {
          name: "Elekta Synergy",
          image: "/hero/synergy2.jpg",
          imaging: "XVI, iView",
          controlSystem: "",
          description:
            "Розширена система з подвійною візуалізацією для максимальної точності променевої терапії",
        },
        {
          name: "Elekta VersaHD",
          image: "/hero/versahd.jpg",
          imaging: "XVI, iView",
          controlSystem: "BrainLAB",
          description:
            "Найсучасніша система з контролем дихання і високоточним позиціонуванням BrainLAB для складних випадків",
        },
      ];
---

<section id="accelerators" class="linear-accelerators scroll-mt-28">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{equipmentData.sectionTitle}</h2>
      <p class="section-subtitle">{equipmentData.sectionSubtitle}</p>
    </div>

    <div class="accelerators-grid">
      {accelerators.map((acc) => (
        <div class="accelerator-card">
          <div class="card-image">
            <img
              src={acc.image || "/hero/versahd.jpg"}
              alt={acc.name}
              width="600"
              height="400"
              loading="lazy"
            />
          </div>
          <div class="card-content">
            <h3 class="card-title">{acc.name}</h3>
            <div class="tech-details">
              {acc.imaging && (
                <div class="detail-item">
                  <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>Система візуалізації: <strong>{acc.imaging}</strong></span>
                </div>
              )}
              {acc.controlSystem && (
                <div class="detail-item highlight">
                  <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  <span>Система контролю: <strong>{acc.controlSystem}</strong></span>
                </div>
              )}
            </div>
            <p class="card-description">{acc.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- BrainLAB System Section -->
    <div class="brainlab-section">
      <div class="brainlab-header">
        <h3 class="brainlab-title">Система BrainLAB ExacTrac Dynamic</h3>
        <p class="brainlab-subtitle">
          Передова технологія контролю дихання і позиціонування для високоточної променевої терапії та радіохірургії
        </p>
      </div>
      <div class="brainlab-gallery">
        <div class="brainlab-image">
          <img
            src="/hero/brain1.jpg"
            alt="Система BrainLAB - контрольна панель"
            width="700"
            height="450"
            loading="lazy"
          />
        </div>
        <div class="brainlab-image">
          <img
            src="/hero/brain0.jpg"
            alt="Система BrainLAB - робоче місце"
            width="700"
            height="450"
            loading="lazy"
          />
        </div>
      </div>
      <div class="brainlab-features">
        <div class="feature">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h4>Контроль дихання</h4>
          <p>Синхронізація опромінення з диханням пацієнта у реальному часі</p>
        </div>
        <div class="feature">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h4>Точне позиціонування</h4>
          <p>Субміліметрова точність опромінення пухлини завдяки 4D тепло-оптичній камері</p>
        </div>
        <div class="feature">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h4>Захист здорових тканин</h4>
          <p>Мінімальний вплив на навколишні критичні органи (серце, легені, спинний мозок)</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .linear-accelerators {
    padding: 80px 24px;
    background: transparent;
  }

  .container {
    max-width: 1440px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .section-title {
    font-size: 2.75rem;
    font-weight: 800;
    color: #1e293b;
    margin-bottom: 18px;
    line-height: 1.2;
  }

  .section-subtitle {
    font-size: 1.2rem;
    color: #64748b;
    max-width: 820px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .accelerators-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px;
    margin-bottom: 80px;
  }

  .accelerator-card {
    background: white;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 4px 12px -1px rgb(0 0 0 / 0.08);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
  }

  .accelerator-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 24px 48px -12px rgb(0 0 0 / 0.15);
  }

  .card-image {
    width: 100%;
    height: 340px;
    overflow: hidden;
    background: #f1f5f9;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .accelerator-card:hover .card-image img {
    transform: scale(1.06);
  }

  .card-content {
    padding: 28px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-size: 1.65rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 18px;
  }

  .tech-details {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 18px;
  }

  .detail-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: #f8fafc;
    border-radius: 12px;
    font-size: 0.95rem;
    color: #475569;
  }

  .detail-item.highlight {
    background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
    border: 1.5px solid #3b82f6;
    color: #1e40af;
  }

  .detail-item strong {
    color: #0f172a;
    font-weight: 700;
  }

  .detail-item.highlight strong {
    color: #1e40af;
  }

  .icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  .card-description {
    color: #64748b;
    line-height: 1.65;
    font-size: 0.98rem;
  }

  .brainlab-section {
    background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    border-radius: 28px;
    padding: 56px;
    color: white;
  }

  .brainlab-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .brainlab-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 14px;
    color: white;
  }

  .brainlab-subtitle {
    font-size: 1.15rem;
    color: #cbd5e1;
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.65;
  }

  .brainlab-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    margin-bottom: 48px;
  }

  .brainlab-image {
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.3);
  }

  .brainlab-image img {
    width: 100%;
    height: 360px;
    object-fit: cover;
  }

  .brainlab-features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .feature {
    text-align: center;
    padding: 28px 22px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    backdrop-filter: blur(10px);
  }

  .feature-icon {
    width: 52px;
    height: 52px;
    margin: 0 auto 18px;
    color: #60a5fa;
  }

  .feature h4 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 10px;
    color: white;
  }

  .feature p {
    color: #cbd5e1;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  @media (max-width: 1024px) {
    .accelerators-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .brainlab-features {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .linear-accelerators {
      padding: 48px 16px;
    }
    .section-title {
      font-size: 1.9rem;
    }
    .accelerators-grid {
      grid-template-columns: 1fr;
    }
    .brainlab-section {
      padding: 32px 20px;
    }
    .brainlab-gallery {
      grid-template-columns: 1fr;
    }
    .brainlab-image img {
      height: 260px;
    }
  }
</style>
