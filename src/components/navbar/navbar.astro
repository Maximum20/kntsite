---
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import fullLogo from "../../assets/full-logo.png"; 
import Search from "../Search.astro"; 

const { hideSubNav } = Astro.props;

const menuitems = [
  { title: "Персонал", path: "/doctors" },
  { title: "Новини", path: "/all-news" },
];

const mainClinic = { title: "На головну клініки", path: "https://dokod.org.ua/" };

const departments = [
  { id: "linac", btnTitle: "Мегавольтна терапія" },
  { id: "gamma", btnTitle: "Гамма-терапія" },
  { id: "brachy", btnTitle: "Брахітерапія" },
  { id: "nearfocus", btnTitle: "Близький фокус" },
  { id: "ct", btnTitle: "КТ-розмітка" },
  { id: "mlt", btnTitle: "Реабілітація" }
];

const { id: currentId } = Astro.params; 
const currentIndex = departments.findIndex(d => d.id === currentId);
const isServiceDetailPage = currentIndex !== -1;

const prevIndex = isServiceDetailPage ? (currentIndex - 1 + departments.length) % departments.length : 0;
const nextIndex = isServiceDetailPage ? (currentIndex + 1) % departments.length : 0;

const prevPath = isServiceDetailPage ? `/services/${departments[prevIndex].id}` : '';
const nextPath = isServiceDetailPage ? `/services/${departments[nextIndex].id}` : '';

const prevTitle = isServiceDetailPage ? departments[prevIndex].btnTitle : '';
const nextTitle = isServiceDetailPage ? departments[nextIndex].btnTitle : '';
const currentTitle = isServiceDetailPage ? departments[currentIndex].btnTitle : '';
---

<header class="w-full relative xl:sticky xl:top-0 z-[100] transition-all duration-300">
  <div class="bg-transparent xl:bg-white/70 xl:backdrop-blur-xl border-transparent xl:border-b xl:border-white/60 shadow-none xl:shadow-sm relative z-20">
    <div class="max-w-[1800px] mx-auto px-5 font-sans">
      <div class="flex flex-col xl:flex-row items-center py-3 xl:py-2 gap-4">
        <Astronav>
          <div class="flex w-full xl:w-auto items-center justify-between relative z-50">
            <div class="flex items-center gap-2 sm:gap-4">
              <a href="/" class="logo-home-trigger flex items-center shrink-0 transition-transform hover:scale-105 active:scale-95" data-target="home">
                <Image src={fullLogo} alt="Лого" class="h-10 md:h-12 xl:h-14 w-auto object-contain" loading="eager" />
              </a>
              <div class="flex items-center border-l border-slate-200 pl-2 sm:pl-4">
                <span class="text-slate-500 font-bold text-[9px] sm:text-[12px] uppercase leading-tight">КНТ "ДОКОД" ДОР</span>
              </div>
            </div>
            <div class="flex items-center gap-3 xl:hidden">
              <a href="#contacts" class="text-blue-600 bg-blue-50 border border-blue-100 rounded-full px-4 py-2 flex items-center gap-2 font-bold text-xs active:scale-95">
                <Icon name="bx:bxs-phone-call" class="w-4 h-4" /> Зв'язок
              </a>
              
              <div id="burger-wrapper" class="p-1.5 bg-white/85 backdrop-blur-2xl border border-white/90 rounded-2xl flex items-center justify-center shadow-sm active:scale-95 transition-all">
                <MenuIcon class="w-7 h-7 text-slate-800" />
              </div>
            </div>
          </div>

          <MenuItems id="mobile-menu-overlay" class="hidden fixed inset-0 z-40 bg-black/5 backdrop-blur-xs xl:relative xl:inset-auto xl:z-auto xl:flex xl:w-auto xl:bg-transparent xl:backdrop-blur-none mt-0 xl:ml-auto">
            
            <ul id="mobile-menu-panel" class="flex flex-col w-full max-w-[300px] h-[calc(100vh-95px)] mt-[75px] mr-5 mb-4 ml-auto bg-white/85 backdrop-blur-2xl border border-white/90 p-5 pt-5 pb-14 shadow-2xl shadow-blue-950/5 overflow-y-auto gap-1 rounded-[2.2rem] xl:flex-row xl:w-auto xl:max-w-none xl:h-auto xl:bg-transparent xl:backdrop-blur-none xl:border-none xl:p-0 xl:pt-0 xl:mt-0 xl:mr-0 xl:mb-0 xl:ml-0 xl:shadow-none xl:overflow-visible xl:items-center 2xl:gap-4">
              
              <Search />

              <div class="xl:hidden px-2 mt-4 mb-1.5 flex items-center gap-2">
                <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Сторінки</p>
                <div class="flex-1 h-px bg-slate-500/10"></div>
              </div>

              {menuitems.map((item) => (
                <li>
                  <a href={item.path} class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-[14px] font-bold text-slate-700 hover:bg-white/60 hover:text-blue-600 transition-all group">
                    <span>{item.title}</span>
                    <Icon name="bx:chevron-right" class="w-4 h-4 text-slate-400 xl:hidden group-hover:text-blue-500 transition-transform group-hover:translate-x-0.5" />
                  </a>
                </li>
              ))}

              <div class="xl:hidden px-2 mt-5 mb-1.5 flex items-center gap-2">
                <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Детальніше про:</p>
                <div class="flex-1 h-px bg-slate-500/10"></div>
              </div>

              {departments.map((dept) => (
                <li class="xl:hidden">
                  <a href={`/services/${dept.id}`} class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-[14px] font-bold text-slate-700 hover:bg-white/60 hover:text-blue-600 transition-all group">
                    <span>{dept.btnTitle}</span>
                    <Icon name="bx:chevron-right" class="w-4 h-4 text-slate-400 xl:hidden group-hover:text-blue-500 transition-transform group-hover:translate-x-0.5" />
                  </a>
                </li>
              ))}

              <div class="hidden xl:block w-px h-6 bg-slate-200 mx-1"></div>
              
              <li class="mt-4 xl:mt-0">
                <a href={mainClinic.path} target="_blank" class="flex items-center gap-2 px-4 py-2 rounded-full bg-white/50 text-slate-700 font-bold text-[13px] hover:bg-slate-800 hover:text-white border border-white/80 transition-all">
                  <Icon name="bx:link-external" class="w-4 h-4 opacity-50" />
                  <span>{mainClinic.title}</span>
                </a>
              </li>

              <li class="hidden xl:flex">
                <a href="#contacts" class="flex items-center gap-2 bg-blue-600 text-white px-6 py-2.5 rounded-full font-bold text-[13px] hover:bg-blue-700 shadow-lg shadow-blue-100 active:scale-95 transition-all">
                  <Icon name="bx:bxs-phone-call" class="w-4 h-4" />
                  <span>Зв'язок</span>
                </a>
              </li>

              <li class="xl:hidden mt-auto pt-5 border-t border-slate-500/10 flex flex-col items-center text-center gap-4">
                <div class="flex items-center gap-2.5">
                  <Image src={fullLogo} alt="Лого" class="h-9 w-auto object-contain" />
                  <div class="text-left border-l border-slate-300 pl-2">
                    <p class="text-[10px] font-black uppercase tracking-wider text-slate-800 leading-tight">КНТ "ДОКОД" ДОР</p>
                    <p class="text-[9px] text-slate-500 font-medium">Радіологічний департамент</p>
                  </div>
                </div>
                
                <div class="flex flex-wrap items-center justify-center gap-2 mt-0.5 text-slate-600 w-full">
                  <a href="https://www.facebook.com/" target="_blank" aria-label="Facebook" class="p-2 bg-white/60 border border-white/80 rounded-full hover:bg-white hover:text-blue-600 active:scale-90 transition-all shadow-sm">
                    <Icon name="bx:bxl-facebook" class="w-4 h-4" />
                  </a>
                  <a href="https://www.instagram.com/" target="_blank" aria-label="Instagram" class="p-2 bg-white/60 border border-white/80 rounded-full hover:bg-white hover:text-pink-600 active:scale-90 transition-all shadow-sm">
                    <Icon name="bx:bxl-instagram" class="w-4 h-4" />
                  </a>
                  <a href="https://www.tiktok.com/" target="_blank" aria-label="TikTok" class="p-2 bg-white/60 border border-white/80 rounded-full hover:bg-white hover:text-black active:scale-90 transition-all shadow-sm">
                    <Icon name="bx:bxl-tiktok" class="w-4 h-4" />
                  </a>
                  <a href="https://t.me/" target="_blank" aria-label="Telegram" class="p-2 bg-white/60 border border-white/80 rounded-full hover:bg-white hover:text-blue-500 active:scale-90 transition-all shadow-sm">
                    <Icon name="bx:bxl-telegram" class="w-4 h-4" />
                  </a>
                  <a href="https://www.youtube.com/" target="_blank" aria-label="YouTube" class="p-2 bg-white/60 border border-white/80 rounded-full hover:bg-white hover:text-red-600 active:scale-90 transition-all shadow-sm">
                    <Icon name="bx:bxl-youtube" class="w-4 h-4" />
                  </a>
                </div>
              </li>

            </ul>
          </MenuItems>
        </Astronav>
      </div>
    </div>
  </div>

  { !hideSubNav && (
    <div id="dept-panel" class="hidden xl:flex justify-center px-5 pt-3 pb-2 relative z-10 transition-all duration-500">
      {isServiceDetailPage ? (
        <div class="bg-white/80 backdrop-blur-2xl p-2 rounded-[3.5rem] border border-white/60 shadow-2xl flex items-center gap-2 pointer-events-auto">
          <a href={prevPath} class="group flex items-center gap-3 pl-2 pr-4 py-2 rounded-full hover:bg-slate-50 transition-all">
            <div class="w-10 h-10 rounded-full flex items-center justify-center bg-slate-100 text-slate-400 group-hover:bg-blue-600 group-hover:text-white transition-all shadow-sm">
              <Icon name="bx:chevron-left" class="w-6 h-6" />
            </div>
            <span class="hidden lg:block text-[11px] font-bold text-slate-300 uppercase tracking-tighter opacity-50 group-hover:opacity-100 transition-opacity">
              {prevTitle}
            </span>
          </a>
          <div class="px-10 py-1 text-center min-w-[200px] border-x border-slate-100">
            <span class="block text-[9px] text-blue-600 font-black uppercase tracking-[0.4em] mb-0.5">Відділення</span>
            <h2 class="text-xl font-black text-slate-900 tracking-tighter uppercase whitespace-nowrap">{currentTitle}</h2>
          </div>
          <a href={nextPath} class="group flex items-center gap-3 pr-2 pl-4 py-2 rounded-full hover:bg-slate-50 transition-all text-right">
            <span class="hidden lg:block text-[11px] font-bold text-slate-300 uppercase tracking-tighter opacity-50 group-hover:opacity-100 transition-opacity">
              {nextTitle}
            </span>
            <div class="w-10 h-10 rounded-full flex items-center justify-center bg-slate-100 text-slate-400 group-hover:bg-blue-600 group-hover:text-white transition-all shadow-sm">
              <Icon name="bx:chevron-right" class="w-6 h-6" />
            </div>
          </a>
        </div>
      ) : (
        <div class="bg-white/70 backdrop-blur-xl p-1.5 rounded-[2.5rem] border border-white/60 shadow-2xl flex flex-wrap justify-center gap-1.5 pointer-events-auto no-scrollbar overflow-x-auto max-w-full">
          {departments.map((dept) => (
            <a href={`/services/${dept.id}`} class="px-5 py-2.5 rounded-[1.8rem] font-bold text-[13px] transition-all duration-300 whitespace-nowrap active:scale-95 text-slate-600 hover:bg-blue-600 hover:text-white">{dept.btnTitle}</a>
          ))}
        </div>
      )}
    </div>
  )}
</header>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  .dept-hidden { transform: translateY(-110%); opacity: 0; pointer-events: none; }
  #dept-panel { transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s linear; will-change: transform; }
</style>

<script>
  let lastScrollTop = 0;
  const panel = document.getElementById('dept-panel');
  const threshold = 10;

  window.addEventListener('scroll', () => {
    if (window.innerWidth >= 1280) {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      const distance = Math.abs(scrollTop - lastScrollTop);
      if (distance > threshold) {
        if (scrollTop > lastScrollTop && scrollTop > 80) {
          panel?.classList.add('dept-hidden');
        } else {
          panel?.classList.remove('dept-hidden');
        }
        lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
      }
    }
  }, { passive: true });

  const menuOverlay = document.getElementById('mobile-menu-overlay');
  const menuPanel = document.getElementById('mobile-menu-panel');
  
  const getToggleBtn = () => document.querySelector('#burger-wrapper button') as HTMLElement;

  if (menuOverlay) {
    const observer = new MutationObserver(() => {
      if (!menuOverlay.classList.contains('hidden')) {
        document.body.classList.add('overflow-hidden');
      } else {
        document.body.classList.remove('overflow-hidden');
      }
    });
    observer.observe(menuOverlay, { attributes: true, attributeFilter: ['class'] });
  }

  menuOverlay?.addEventListener('click', (e) => {
    if (window.innerWidth < 1280 && menuPanel && !menuPanel.contains(e.target as Node)) {
      getToggleBtn()?.click();
    }
  });
</script>