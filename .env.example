# Конфігурація Keystatic CMS для продакшену (Vercel + GitHub)
KEYSTATIC_GITHUB_CLIENT_ID=your_github_client_id
KEYSTATIC_GITHUB_CLIENT_SECRET=your_github_client_secret
KEYSTATIC_SECRET=your_random_64_char_hex_secret
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=maximum20-keystatic

# GitHub API для безпечної відправки анкети персоналу та відгуків (Fine-grained PAT з правом Contents: Read and write)
GITHUB_TOKEN=github_pat_your_fine_grained_token
GITHUB_OWNER=maximum20
GITHUB_REPO=kntsite
GITHUB_BRANCH=main

# Обов'язковий секретний код доступу для прихованої сторінки /anketa-personalu
STAFF_FORM_SECRET=your_strong_staff_access_code

# Обов'язковий Cloudflare Turnstile для публічної форми відгуків і питань (/api/submit-feedback)
PUBLIC_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key
