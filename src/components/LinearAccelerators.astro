---
// LinearAccelerators.astro - Компонент для презентації лінійних прискорювачів
---

<section class="linear-accelerators">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Сучасне обладнання для променевої терапії</h2>
      <p class="section-subtitle">
        У нашому центрі встановлено три лінійних прискорювача Elekta останнього покоління
        для високоточного лікування онкологічних захворювань
      </p>
    </div>

    <div class="accelerators-grid">
      <!-- Elekta Synergy Platform -->
      <div class="accelerator-card">
        <div class="card-image">
          <img
            src="/hero/platform.jpg"
            alt="Elekta Synergy Platform"
            loading="lazy"
          />
        </div>
        <div class="card-content">
          <h3 class="card-title">Elekta Synergy Platform</h3>
          <div class="tech-details">
            <div class="detail-item">
              <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Система візуалізації: <strong>iView</strong></span>
            </div>
          </div>
          <p class="card-description">
            Надійна платформа з перевіреною системою візуалізації для точного позиціонування пацієнта
          </p>
        </div>
      </div>

      <!-- Elekta Synergy -->
      <div class="accelerator-card">
        <div class="card-image">
          <img
            src="/hero/synergy2.jpg"
            alt="Elekta Synergy"
            loading="lazy"
          />
        </div>
        <div class="card-content">
          <h3 class="card-title">Elekta Synergy</h3>
          <div class="tech-details">
            <div class="detail-item">
              <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Система візуалізації: <strong>XVI, iView</strong></span>
            </div>
          </div>
          <p class="card-description">
            Розширена система з подвійною візуалізацією для максимальної точності променевої терапії
          </p>
        </div>
      </div>

      <!-- Elekta VersaHD -->
      <div class="accelerator-card">
        <div class="card-image">
          <img
            src="/hero/versahd.jpg"
            alt="Elekta VersaHD"
            loading="lazy"
          />
        </div>
        <div class="card-content">
          <h3 class="card-title">Elekta VersaHD</h3>
          <div class="tech-details">
            <div class="detail-item">
              <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Система візуалізації: <strong>XVI, iView</strong></span>
            </div>
            <div class="detail-item highlight">
              <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              <span>Система контролю: <strong>BrainLAB</strong></span>
            </div>
          </div>
          <p class="card-description">
            Найсучасніша система з контролем дихання і високоточним позиціонуванням BrainLAB для складних випадків
          </p>
        </div>
      </div>
    </div>

    <!-- BrainLAB System Section -->
    <div class="brainlab-section">
      <div class="brainlab-header">
        <h3 class="brainlab-title">Система BrainLAB</h3>
        <p class="brainlab-subtitle">
          Передова технологія контролю дихання і позиціонування для високоточної променевої терапії
        </p>
      </div>
      <div class="brainlab-gallery">
        <div class="brainlab-image">
          <img
            src="/hero/brain1.jpg"
            alt="Система BrainLAB - контрольна панель"
            loading="lazy"
          />
        </div>
        <div class="brainlab-image">
          <img
            src="/hero/brain0.jpg"
            alt="Система BrainLAB - робоче місце"
            loading="lazy"
          />
        </div>
      </div>
      <div class="brainlab-features">
        <div class="feature">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h4>Контроль дихання</h4>
          <p>Синхронізація опромінення з диханням пацієнта</p>
        </div>
        <div class="feature">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h4>Точне позиціонування</h4>
          <p>Субміліметрова точність опромінення пухлини</p>
        </div>
        <div class="feature">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h4>Захист здорових тканин</h4>
          <p>Мінімальний вплив на навколишні органи</p>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .linear-accelerators {
    padding: 100px 24px;
    background: transparent;
  }

  .container {
    max-width: 1440px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 72px;
  }

  .section-title {
    font-size: 3rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 20px;
    line-height: 1.2;
  }

  .section-subtitle {
    font-size: 1.25rem;
    color: #64748b;
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .accelerators-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-bottom: 96px;
  }

  .accelerator-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .accelerator-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 24px 48px -12px rgb(0 0 0 / 0.15);
  }

  .card-image {
    width: 100%;
    height: 360px;
    overflow: hidden;
    background: #f1f5f9;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .accelerator-card:hover .card-image img {
    transform: scale(1.08);
  }

  .card-content {
    padding: 32px;
  }

  .card-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 20px;
  }

  .tech-details {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 20px;
  }

  .detail-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: #f8fafc;
    border-radius: 10px;
    font-size: 1rem;
    color: #475569;
    transition: all 0.2s ease;
  }

  .detail-item:hover {
    background: #f1f5f9;
  }

  .detail-item.highlight {
    background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
    border: 1.5px solid #3b82f6;
    color: #1e40af;
  }

  .detail-item.highlight:hover {
    background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
  }

  .detail-item strong {
    color: #0f172a;
    font-weight: 600;
  }

  .detail-item.highlight strong {
    color: #1e40af;
  }

  .icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  .card-description {
    color: #64748b;
    line-height: 1.7;
    font-size: 1rem;
  }

  /* BrainLAB Section */
  .brainlab-section {
    background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    border-radius: 28px;
    padding: 64px;
    color: white;
  }

  .brainlab-header {
    text-align: center;
    margin-bottom: 56px;
  }

  .brainlab-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 16px;
    color: white;
  }

  .brainlab-subtitle {
    font-size: 1.25rem;
    color: #cbd5e1;
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .brainlab-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-bottom: 56px;
  }

  .brainlab-image {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.3), 0 10px 10px -5px rgb(0 0 0 / 0.2);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .brainlab-image:hover {
    transform: translateY(-8px);
  }

  .brainlab-image img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .brainlab-image:hover img {
    transform: scale(1.06);
  }

  .brainlab-features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .feature {
    text-align: center;
    padding: 32px 24px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
  }

  .feature:hover {
    background: rgba(255, 255, 255, 0.12);
    transform: translateY(-4px);
  }

  .feature-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 20px;
    color: #60a5fa;
  }

  .feature h4 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 12px;
    color: white;
  }

  .feature p {
    color: #cbd5e1;
    font-size: 1rem;
    line-height: 1.6;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .accelerators-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }

    .brainlab-features {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .linear-accelerators {
      padding: 64px 20px;
    }

    .section-header {
      margin-bottom: 48px;
    }

    .section-title {
      font-size: 2rem;
    }

    .section-subtitle {
      font-size: 1.125rem;
    }

    .accelerators-grid {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-bottom: 64px;
    }

    .card-image {
      height: 280px;
    }

    .card-content {
      padding: 24px;
    }

    .card-title {
      font-size: 1.5rem;
    }

    .brainlab-section {
      padding: 40px 24px;
    }

    .brainlab-header {
      margin-bottom: 40px;
    }

    .brainlab-title {
      font-size: 1.75rem;
    }

    .brainlab-subtitle {
      font-size: 1.125rem;
    }

    .brainlab-gallery {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-bottom: 40px;
    }

    .brainlab-image img {
      height: 300px;
    }

    .feature {
      padding: 24px 20px;
    }
  }

  @media (max-width: 480px) {
    .section-title {
      font-size: 1.75rem;
    }

    .section-subtitle {
      font-size: 1rem;
    }

    .card-image {
      height: 240px;
    }

    .card-title {
      font-size: 1.375rem;
    }

    .brainlab-image img {
      height: 260px;
    }
  }
</style>
