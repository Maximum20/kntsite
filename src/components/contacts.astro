---
import { Icon } from "astro-icon/components";
import { siteSettings } from "../data";
---

<section id="contacts" class="container mx-auto px-5 py-20 scroll-mt-32 relative overflow-hidden">
  <!-- Заголовок секції -->
  <div class="text-center mb-12">
    <h2 class="text-4xl sm:text-5xl md:text-7xl font-bold mb-6 tracking-tighter relative inline-block">
      <span class="gradient-text">Наші контакти</span>
      <div class="absolute -bottom-3 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-sky-400 to-transparent animate-pulse"></div>
    </h2>
    <p class="text-slate-600 text-base sm:text-lg max-w-2xl mx-auto mb-6">
      Оберіть зручний для вас спосіб зв'язку, скопіюйте номер у один дотик або прокладіть маршрут
    </p>

    {/* Блок графіка роботи з Keystatic */}
    <div class="inline-flex flex-col sm:flex-row items-center gap-2 sm:gap-4 px-5 py-3 rounded-2xl bg-white/85 backdrop-blur-md border border-blue-200/80 shadow-md text-xs sm:text-sm">
      <div class="flex items-center gap-2 font-black text-blue-700">
        <Icon name="bx:time-five" class="w-5 h-5 text-blue-600 shrink-0" />
        <span>{siteSettings.schedule}</span>
      </div>
      {siteSettings.scheduleNote && (
        <span class="text-slate-500 font-medium border-t sm:border-t-0 sm:border-l border-slate-200 pt-1.5 sm:pt-0 sm:pl-4">
          {siteSettings.scheduleNote}
        </span>
      )}
    </div>
  </div>

  <!-- Сітка карток контактів -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
    <!-- 1. Телефони реєстратури -->
    <div class="glass-card group hover-lift">
      <div class="card-glow"></div>
      <div class="relative z-10">
        <div class="flex items-center gap-4 mb-6">
          <div class="icon-wrapper bg-gradient-to-br from-sky-400 to-blue-600">
            <Icon name="bx:phone" class="w-7 h-7 text-white icon-float" />
          </div>
          <div>
            <h3 class="font-bold text-xl text-slate-800">Реєстратура</h3>
            <p class="text-sm text-sky-600">Натисніть для дзвінка або копіювання</p>
          </div>
        </div>

        <div class="space-y-3">
          {siteSettings.phones.map((phoneObj, index) => (
            <div
              class="phone-item group/phone"
              style={`--delay: ${index * 0.08}s`}
            >
              <a
                href={`tel:${phoneObj.number.replace(/[^\d+]/g, "")}`}
                class="phone-link min-w-0"
              >
                <Icon
                  name="bx:phone-call"
                  class="w-5 h-5 text-sky-500 group-hover/phone:rotate-12 transition-transform shrink-0"
                />
                <div class="min-w-0">
                  <span class="block font-bold text-slate-800 text-sm sm:text-base leading-tight">
                    {phoneObj.number}
                  </span>
                  {phoneObj.label && (
                    <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mt-0.5">
                      {phoneObj.label}
                    </span>
                  )}
                </div>
              </a>
              <button
                type="button"
                class="copy-btn"
                data-copy={phoneObj.number}
                aria-label={`Скопіювати номер ${phoneObj.number}`}
                title="Скопіювати номер"
              >
                <Icon name="bx:copy" class="w-4 h-4 copy-icon" />
                <Icon name="bx:check" class="w-4 h-4 check-icon" />
              </button>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- 2. Локація, Адреса та Email -->
    <div class="glass-card group hover-lift">
      <div class="card-glow"></div>
      <div class="relative z-10">
        <div class="flex items-center gap-4 mb-6">
          <div class="icon-wrapper bg-gradient-to-br from-cyan-400 to-teal-600">
            <Icon name="bx:map" class="w-7 h-7 text-white icon-float" />
          </div>
          <div>
            <h3 class="font-bold text-xl text-slate-800">Локація та Пошта</h3>
            <p class="text-sm text-cyan-600">Адреса відділення та маршрут</p>
          </div>
        </div>

        <!-- Email -->
        {siteSettings.email && (
          <div class="email-item mb-4">
            <a href={`mailto:${siteSettings.email}`} class="email-link min-w-0">
              <Icon name="bx:envelope" class="w-5 h-5 text-cyan-600 shrink-0" />
              <span class="font-bold text-slate-800 break-all text-sm sm:text-base">
                {siteSettings.email}
              </span>
            </a>
            <button
              type="button"
              class="copy-btn"
              data-copy={siteSettings.email}
              aria-label="Скопіювати email"
              title="Скопіювати email"
            >
              <Icon name="bx:copy" class="w-4 h-4 copy-icon" />
              <Icon name="bx:check" class="w-4 h-4 check-icon" />
            </button>
          </div>
        )}

        <!-- Адреси з копіюванням та кнопкою Google Maps -->
        <div class="flex flex-col gap-3.5">
          {siteSettings.addresses.map((loc) => (
            <div class="address-card">
              <div class="flex items-start justify-between gap-2 mb-3">
                <div class="flex items-start gap-2.5 min-w-0">
                  <Icon name="bx:map-pin" class="w-6 h-6 text-teal-600 mt-0.5 shrink-0 pulse-icon" />
                  <div class="min-w-0">
                    <p class="font-bold text-slate-800 leading-snug text-sm sm:text-base">
                      {loc.address}
                    </p>
                    <p class="text-xs text-slate-500 mt-0.5">{loc.subtitle}</p>
                  </div>
                </div>
                <button
                  type="button"
                  class="copy-btn shrink-0"
                  data-copy={loc.address}
                  aria-label={`Скопіювати адресу ${loc.address}`}
                  title="Скопіювати адресу"
                >
                  <Icon name="bx:copy" class="w-4 h-4 copy-icon" />
                  <Icon name="bx:check" class="w-4 h-4 check-icon" />
                </button>
              </div>

              <a
                href={loc.mapUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs uppercase tracking-wider transition-all shadow-sm active:scale-95"
              >
                <Icon name="bx:navigation" class="w-4 h-4" />
                <span>Прокласти маршрут у Google Maps</span>
                <Icon name="bx:right-arrow-alt" class="w-4 h-4" />
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- 3. Соціальні мережі -->
    <div class="glass-card group hover-lift">
      <div class="card-glow"></div>
      <div class="relative z-10 flex flex-col h-full">
        <div class="flex items-center gap-4 mb-6">
          <div class="icon-wrapper bg-gradient-to-br from-violet-500 to-purple-600">
            <Icon name="bx:chat" class="w-7 h-7 text-white icon-float" />
          </div>
          <div>
            <h3 class="font-bold text-xl text-slate-800">Соціальні мережі</h3>
            <p class="text-sm text-violet-600">Слідкуйте за новинами центру</p>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6">
          {siteSettings.socials.telegram && (
            <a href={siteSettings.socials.telegram} target="_blank" rel="noopener noreferrer" class="social-btn telegram">
              <Icon name="bx:bxl-telegram" class="w-6 h-6" />
              <span class="social-label">Telegram</span>
            </a>
          )}
          {siteSettings.socials.facebook && (
            <a href={siteSettings.socials.facebook} target="_blank" rel="noopener noreferrer" class="social-btn facebook">
              <Icon name="bx:bxl-facebook" class="w-6 h-6" />
              <span class="social-label">Facebook</span>
            </a>
          )}
          {siteSettings.socials.instagram && (
            <a href={siteSettings.socials.instagram} target="_blank" rel="noopener noreferrer" class="social-btn instagram">
              <Icon name="bx:bxl-instagram" class="w-6 h-6" />
              <span class="social-label">Instagram</span>
            </a>
          )}
          {siteSettings.socials.youtube && (
            <a href={siteSettings.socials.youtube} target="_blank" rel="noopener noreferrer" class="social-btn youtube">
              <Icon name="bx:bxl-youtube" class="w-6 h-6" />
              <span class="social-label">YouTube</span>
            </a>
          )}
          {siteSettings.socials.tiktok && (
            <a href={siteSettings.socials.tiktok} target="_blank" rel="noopener noreferrer" class="social-btn tiktok">
              <Icon name="bx:bxl-tiktok" class="w-6 h-6" />
              <span class="social-label">TikTok</span>
            </a>
          )}
          <a href={siteSettings.mainClinicUrl} target="_blank" rel="noopener noreferrer" class="social-btn">
            <Icon name="bx:globe" class="w-6 h-6" />
            <span class="social-label">Сайт ДОКОД</span>
          </a>
        </div>

        <div class="mt-auto p-4 rounded-2xl bg-violet-50/70 border border-violet-200/60 flex items-start gap-3">
          <Icon name="bx:info-circle" class="w-5 h-5 text-violet-600 shrink-0 mt-0.5" />
          <p class="text-xs text-slate-600 leading-relaxed">
            Лікування у відділенні променевої терапії проводиться <strong>безоплатно</strong> згідно з програмою медичних гарантій НСЗУ за наявності електронного направлення.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .gradient-text {
    background: linear-gradient(135deg, #0ea5e9 0%, #3b82f6 25%, #6366f1 50%, #8b5cf6 75%, #0ea5e9 100%);
    background-size: 300% 300%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientFlow 8s ease infinite;
  }

  @keyframes gradientFlow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .glass-card {
    position: relative;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(20px);
    border-radius: 32px;
    padding: 1.75rem;
    border: 2px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 8px 32px rgba(14, 165, 233, 0.08), 0 2px 8px rgba(59, 130, 246, 0.04);
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }

  .glass-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(14, 165, 233, 0.16);
  }

  .icon-wrapper {
    width: 52px;
    height: 52px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 16px rgba(14, 165, 233, 0.25);
    flex-shrink: 0;
  }

  .phone-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.85rem 1rem;
    background: rgba(240, 249, 255, 0.75);
    border-radius: 16px;
    border: 1px solid rgba(14, 165, 233, 0.15);
    transition: all 0.25s ease;
  }

  .phone-item:hover {
    background: rgba(224, 242, 254, 0.9);
    border-color: rgba(14, 165, 233, 0.35);
  }

  .phone-link,
  .email-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex: 1;
  }

  .email-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.85rem 1rem;
    background: rgba(240, 253, 250, 0.75);
    border-radius: 16px;
    border: 1px solid rgba(20, 184, 166, 0.2);
    transition: all 0.25s ease;
  }

  .copy-btn {
    padding: 0.5rem;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(14, 165, 233, 0.25);
    border-radius: 11px;
    cursor: pointer;
    transition: all 0.2s ease;
    color: #0284c7;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .copy-btn:hover {
    background: #e0f2fe;
    border-color: #0284c7;
    transform: scale(1.08);
  }

  .check-icon {
    display: none;
    color: #10b981;
  }

  .copy-btn.copied .copy-icon {
    display: none;
  }

  .copy-btn.copied .check-icon {
    display: block;
  }

  .address-card {
    padding: 1.15rem;
    background: linear-gradient(135deg, rgba(240, 253, 250, 0.7), rgba(224, 242, 254, 0.7));
    border-radius: 20px;
    border: 1.5px solid rgba(20, 184, 166, 0.25);
    transition: all 0.3s ease;
  }

  .address-card:hover {
    border-color: rgba(14, 165, 233, 0.45);
    box-shadow: 0 8px 20px rgba(14, 165, 233, 0.12);
  }

  .social-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 1rem 0.5rem;
    background: rgba(255, 255, 255, 0.75);
    border: 1.5px solid rgba(139, 92, 246, 0.2);
    border-radius: 18px;
    text-decoration: none;
    color: #4f46e5;
    transition: all 0.3s ease;
  }

  .social-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .social-btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 20px rgba(139, 92, 246, 0.18);
  }

  .social-btn.telegram:hover { background: #0088cc; color: white; border-color: #0088cc; }
  .social-btn.facebook:hover { background: #1877f2; color: white; border-color: #1877f2; }
  .social-btn.instagram:hover { background: linear-gradient(135deg, #f09433, #dc2743, #bc1888); color: white; border-color: #dc2743; }
  .social-btn.youtube:hover { background: #ff0000; color: white; border-color: #ff0000; }
  .social-btn.tiktok:hover { background: #0f172a; color: white; border-color: #0f172a; }
</style>
