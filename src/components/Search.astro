---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { doctors, siteSettings, equipmentData, patientRouteData } from "../data";

const allServices = (await getCollection("services")) || [];
const visibleServices = allServices
  .filter((s) => s.data?.isVisible !== false)
  .sort((a, b) => (a.data?.order ?? 99) - (b.data?.order ?? 99));
const visibleServiceIds = new Set(visibleServices.map((s) => s.id));

const allNews = (await getCollection("news")) || [];
const allVacancies = (await getCollection("vacancies")) || [];

// Динамічні сторінки видимих відділень із Keystatic
const serviceSearchItems = visibleServices.map((svc) => ({
  title: svc.data.heroTitle || svc.data.title,
  subtitle: svc.data.description || svc.data.heroText || "",
  url: `/services/${svc.id}`,
  category: "Сторінка",
  icon: svc.data.icon || "🏥",
  tags: [
    svc.id.toLowerCase(),
    (svc.data.title || "").toLowerCase(),
    (svc.data.navTitle || "").toLowerCase(),
    (svc.data.subtitle || "").toLowerCase(),
    (svc.data.description || "").toLowerCase(),
    ...(Array.isArray(svc.data.searchKeywords)
      ? svc.data.searchKeywords.map((k: string) => String(k).toLowerCase())
      : []),
    "відділення",
    "послуга",
    "лікування",
  ].filter(Boolean),
}));

// Формуємо комплексний клієнтський пошуковий індекс під час збірки (SSG)
const staticPagesAndEquipment = [
  ...(visibleServiceIds.has("linac")
    ? [
        {
          title: "Лінійний прискорювач Elekta Versa HD + BrainLAB ExacTrac Dynamic",
          subtitle: "Стереотаксична радіохірургія, 4D-контроль дихання та субміліметрова точність",
          url: "/services/linac#accelerators",
          category: "Обладнання",
          icon: "🎯",
          tags: [
            "versa", "versahd", "brainlab", "брейнлаб", "exactrac", "стереотаксис", "радіохірургія",
            "прискорювач", "опромінення", "контроль дихання", "теплова камера", "апарат", "обладнання", "elekta"
          ]
        },
        {
          title: "Лінійні прискорювачі Elekta Synergy та Synergy Platform",
          subtitle: "3D-візуалізація XVI / iViewGT та високоточне ротаційне опромінення VMAT / IMRT",
          url: "/services/linac#accelerators",
          category: "Обладнання",
          icon: "🔬",
          tags: [
            "synergy", "сінерджі", "platform", "elekta", "електа", "xvi", "iview", "прискорювач",
            "опромінення", "апарат", "обладнання", "vmat", "imrt"
          ]
        },
      ]
    : []),
  {
    title: "Підготовка до променевої терапії та Маршрут пацієнта (Чекліст)",
    subtitle: "Інтерактивний чекліст документів, аналізів, дисків КТ/МРТ та кроків перед першим візитом",
    url: "/#patient-checklist",
    category: "Пацієнту",
    icon: "📋",
    tags: [
      "підготовка", "маршрут", "шлях пацієнта", "чекліст", "документи", "довідка", "аналізи",
      "кров", "паспорт", "іпн", "гістологія", "біопсія", "диск", "флешка", "мрт", "пэт",
      "перший візит", "що брати", "консиліум", "одяг", "як підготуватися"
    ]
  },
  {
    title: "Направлення та безкоштовне лікування (Програма НСЗУ)",
    subtitle: "Як отримати електронне направлення та пройти курс променевої терапії безоплатно",
    url: "/#faq-section",
    category: "Пацієнту",
    icon: "🏥",
    tags: [
      "направлення", "електронне направлення", "нсзу", "безкоштовно", "безоплатно", "ціна",
      "вартість", "оплата", "гарантії", "сімейний лікар", "онколог", "державна програма", "faq", "питання"
    ]
  },
  {
    title: "Графік роботи, телефони реєстратури та адреса",
    subtitle: `${siteSettings.schedule} • ${siteSettings.phones.map((p) => p.number).join(", ")} • вул. Космічна, 21`,
    url: "/#contacts",
    category: "Сторінка",
    icon: "📞",
    tags: [
      "контакти", "телефон", "реєстратура", "адреса", "графік", "години роботи", "розклад",
      "як доїхати", "маршрут", "карта", "космічна", "гавриленка", "ребініна", "дніпро",
      "пошта", "email", "запис", "записатися", "прийом", "зв'язок"
    ]
  },
  {
    title: "Персонал відділення (Усі лікарі, фізики та медсестри)",
    subtitle: "Повний склад команди: радіаційні онкологи, рентгенологи, медичні фізики",
    url: "/doctors",
    category: "Сторінка",
    icon: "👨‍⚕️",
    tags: [
      "персонал", "лікарі", "команда", "спеціалісти", "фахівці", "радіолог", "онколог",
      "медичний фізик", "фізики", "рентгенолог", "медсестра", "завідувачка"
    ]
  },
  {
    title: "Архів новин та публікацій відділення",
    subtitle: "Події, впровадження нових технологій та досягнення центру",
    url: "/all-news",
    category: "Сторінка",
    icon: "📰",
    tags: ["новини", "публікації", "статті", "події", "архів", "блог"]
  },
  {
    title: "Актуальні вакансії відділення",
    subtitle: "Приєднуйтесь до команди радіологічного центру КНТ «ДОКОД» ДОР",
    url: "/vacancies",
    category: "Сторінка",
    icon: "💼",
    tags: ["вакансії", "робота", "працевлаштування", "кар'єра", "рентгенолаборант", "лаборант"]
  }
];

// Додаємо кожного спеціаліста окремою карткою в пошуковий індекс
const doctorItems = doctors.map((doc) => ({
  title: `${doc.surname} ${doc.name}`,
  subtitle: `${doc.badge ? doc.badge + " • " : ""}${doc.role} (${doc.department}, досвід: ${doc.experience})`,
  url: `/doctors?doctor=${encodeURIComponent(doc.surname)}`,
  category: "Лікар",
  icon: "👩‍⚕️",
  tags: [
    doc.surname.toLowerCase(),
    doc.name.toLowerCase(),
    (doc.fullNamePatronymic || "").toLowerCase(),
    doc.role.toLowerCase(),
    doc.department.toLowerCase(),
    ...(doc.specializations || []).map((s) => s.toLowerCase()),
    doc.badge ? doc.badge.toLowerCase() : "",
    "лікар", "спеціаліст", "фахівець", "радіолог", "онколог", "консультація"
  ].filter(Boolean)
}));

// Додаємо всі новини
const newsItems = allNews.map((item) => ({
  title: item.data.title,
  subtitle: `${item.data.category || "Новина"} • ${item.data.date.toLocaleDateString("uk-UA")} — ${item.data.description || ""}`,
  url: `/news/${item.id}`,
  category: "Новина",
  icon: "📰",
  tags: [
    item.data.title.toLowerCase(),
    (item.data.description || "").toLowerCase(),
    (item.data.category || "новина").toLowerCase(),
    ...(item.data.tags || []).map((t: string) => t.toLowerCase()),
    "новина", "стаття"
  ]
}));

// Додаємо всі вакансії
const vacancyItems = allVacancies.map((item) => ({
  title: `Вакансія: ${item.data.title}`,
  subtitle: item.data.description || "Актуальна пропозиція роботи у відділенні",
  url: `/vacancies/${item.id}`,
  category: "Сторінка",
  icon: "💼",
  tags: [
    (item.data.title || "").toLowerCase(),
    (item.data.description || "").toLowerCase(),
    "вакансія", "робота", "лаборант", "рентгенлаборант"
  ]
}));

// Додаємо методики з сінглтона обладнання
const methodItems = (equipmentData.methods || []).map((m) => ({
  title: `Метод ${m.code}: ${m.title}`,
  subtitle: m.description,
  url: "/#methods-section",
  category: "Обладнання",
  icon: "⚡",
  tags: [
    m.code.toLowerCase(),
    m.title.toLowerCase(),
    m.description.toLowerCase(),
    "метод", "опромінення", "технологія", "лікування"
  ]
}));

const searchIndex = [
  ...serviceSearchItems,
  ...staticPagesAndEquipment,
  ...doctorItems,
  ...methodItems,
  ...newsItems,
  ...vacancyItems
];

// Швидкі пресети для блоку "Часто шукають / Може бути корисним" (тільки видимі відділення)
const quickPresets = [
  ...(visibleServiceIds.has("linac")
    ? [
        {
          label: "Лінійні прискорювачі Elekta",
          query: "Elekta",
          href: "/services/linac",
          icon: "⚡",
          badge: "Обладнання"
        },
      ]
    : []),
  {
    label: "Персонал відділення",
    query: "Лікар",
    href: "/doctors",
    icon: "👨‍⚕️",
    badge: "Команда"
  },
  {
    label: "Направлення та безкоштовне лікування (НСЗУ)",
    query: "НСЗУ направлення",
    href: "/#faq-section",
    icon: "🏥",
    badge: "НСЗУ"
  },
  {
    label: "Графік роботи та контакти",
    query: "Контакти реєстратура",
    href: "/#contacts",
    icon: "📞",
    badge: "Контакти"
  },
  ...(visibleServiceIds.has("ct")
    ? [
        {
          label: "КТ-розмітка та симуляція",
          query: "КТ-розмітка",
          href: "/services/ct",
          icon: "🖥️",
          badge: "Планування"
        },
      ]
    : []),
];

const quickChips = [
  ...(visibleServiceIds.has("linac") ? [{ label: "Лінійні прискорювачі Elekta", q: "прискорювач" }] : []),
  { label: "Підготовка та аналізи", q: "аналізи" },
  { label: "Направлення НСЗУ", q: "направлення" },
  ...(visibleServiceIds.has("linac") ? [{ label: "Система BrainLAB", q: "brainlab" }] : []),
  { label: "Лікарі-радіологи", q: "лікар" },
  ...(visibleServiceIds.has("ct") ? [{ label: "КТ-розмітка (маска)", q: "кт" }] : []),
  ...(visibleServiceIds.has("brachy") ? [{ label: "Брахітерапія", q: "брахітерапія" }] : []),
  { label: "Телефони та графік", q: "контакти" },
];
---

{/* --- 1. КНОПКИ В ШАПЦІ --- */}
<div class="flex items-center gap-2.5 mr-1 xl:mr-4 xl:ml-2">
  {/* БУЛЬБАШКА СОЦМЕРЕЖ */}
  <div class="hidden xl:flex items-center gap-3.5 bg-white/60 p-2 px-3.5 rounded-full border border-slate-200/50 shadow-sm backdrop-blur-md transition-all hover:shadow-md hover:bg-white/80">
    {siteSettings.socials.facebook && (
      <a href={siteSettings.socials.facebook} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-blue-600 transition-all hover:scale-110" aria-label="Facebook">
        <Icon name="bx:bxl-facebook-circle" class="w-5 h-5" />
      </a>
    )}
    {siteSettings.socials.telegram && (
      <a href={siteSettings.socials.telegram} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-sky-500 transition-all hover:scale-110" aria-label="Telegram">
        <Icon name="bx:bxl-telegram" class="w-5 h-5" />
      </a>
    )}
    {siteSettings.socials.instagram && (
      <a href={siteSettings.socials.instagram} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-pink-500 transition-all hover:scale-110" aria-label="Instagram">
        <Icon name="bx:bxl-instagram" class="w-5 h-5" />
      </a>
    )}
    {siteSettings.socials.youtube && (
      <a href={siteSettings.socials.youtube} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-red-600 transition-all hover:scale-110" aria-label="YouTube">
        <Icon name="bx:bxl-youtube" class="w-5 h-5" />
      </a>
    )}
    {siteSettings.socials.tiktok && (
      <a href={siteSettings.socials.tiktok} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-slate-900 transition-all hover:scale-110" aria-label="TikTok">
        <Icon name="bx:bxl-tiktok" class="w-5 h-5" />
      </a>
    )}
  </div>

  {/* БУЛЬБАШКА ПОШУКУ */}
  <div class="flex items-center w-full xl:w-auto">
    <button
      id="search-trigger"
      type="button"
      class="group relative flex items-center justify-start h-10 w-full xl:w-10 xl:hover:w-60 bg-blue-600 text-white rounded-full transition-all duration-500 ease-in-out overflow-hidden shadow-lg shadow-blue-500/20 active:scale-95 cursor-pointer px-3 xl:px-0"
      aria-label="Відкрити розумний пошук по сайту (Ctrl+K)"
    >
      <div class="flex items-center justify-center min-w-[28px] xl:min-w-[40px] h-10 shrink-0">
        <Icon name="bx:bx-search" class="w-5 h-5" />
      </div>
      <span class="whitespace-nowrap opacity-100 xl:opacity-0 xl:group-hover:opacity-100 transition-opacity duration-300 xl:delay-100 font-bold text-[13px] tracking-tight pr-4">
        Знайти інформацію на сайті
      </span>
    </button>
  </div>
</div>

{/* --- 2. ВІКНО РОЗУМНОГО ПОШУКУ (MODAL) --- */}
<div
  id="search-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Інтелектуальний пошук по сайту"
  class="fixed inset-0 z-[999] hidden bg-slate-950/60 backdrop-blur-xl items-start md:items-center justify-center p-0 md:p-6 lg:p-8 font-sans"
>
  <div class="bg-white w-full h-[100dvh] md:h-auto md:max-h-[86vh] md:max-w-3xl lg:max-w-4xl rounded-none md:rounded-[2rem] shadow-[0_25px_70px_rgba(0,0,0,0.3)] overflow-hidden flex flex-col border-0 md:border md:border-slate-100 transition-all">
    
    {/* ВЕРХНЯ ПАНЕЛЬ З ПОЛЕМ ПОШУКУ */}
    <div class="p-4 sm:p-5 bg-gradient-to-b from-slate-50 to-white border-b border-slate-100 shrink-0">
      <div class="flex items-center justify-between mb-3 px-1">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
          <span class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500">
            Пошук інформації на сайті
          </span>
        </div>
        <div class="flex items-center gap-2">
          <span class="hidden sm:inline-flex items-center gap-1 text-[10px] font-bold text-slate-400 bg-slate-100 px-2 py-1 rounded-md">
            <kbd class="font-sans">↑↓</kbd> навігація • <kbd class="font-sans">Enter</kbd> вибір • <kbd class="font-sans">Esc</kbd> закрити
          </span>
          <button
            id="modal-close-btn"
            type="button"
            class="w-8 h-8 flex items-center justify-center rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-900 transition-all cursor-pointer shrink-0"
            aria-label="Закрити вікно пошуку"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      {/* Поле вводу */}
      <div class="relative flex items-center gap-3 bg-white px-4 sm:px-5 py-3.5 rounded-2xl border-2 border-slate-200 focus-within:border-blue-500 focus-within:ring-4 focus-within:ring-blue-500/10 transition-all shadow-sm">
        <Icon name="bx:bx-search" class="w-6 h-6 text-blue-600 shrink-0" />
        <input
          id="search-input"
          type="text"
          placeholder="Введіть запит (напр.: прискорювач, Сніжинська, направлення, аналізи, КТ)..."
          class="bg-transparent border-none outline-none w-full font-semibold text-slate-800 placeholder:text-slate-400 placeholder:font-normal text-sm sm:text-base"
          autocomplete="off"
          spellcheck="false"
        />
        <button
          id="search-clear-btn"
          type="button"
          class="hidden px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-800 text-xs font-bold transition-colors cursor-pointer shrink-0"
        >
          Очистити
        </button>
      </div>
    </div>

    {/* ОСНОВНА ОБЛАСТЬ СПИСКУ ПІДКАЗОК ТА РЕЗУЛЬТАТІВ */}
    <div id="search-scroll-area" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6 custom-scrollbar">
      
      {/* СТАН ДО ВВЕДЕННЯ ТЕКСТУ: МИТТЄВИЙ ВИПАДАЮЧИЙ СПИСОК "ЧАСТО ШУКАЮТЬ" */}
      <div id="suggestions-box" class="space-y-6">
        <div>
          <div class="flex items-center justify-between mb-3 px-1">
            <p class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-400">
              🔥 Часто шукають / Може бути корисним
            </p>
            <button
              id="shuffle-suggestions-btn"
              type="button"
              class="text-[11px] font-bold text-blue-600 hover:text-blue-800 flex items-center gap-1 cursor-pointer transition-colors"
            >
              <span>Оновити підбірку</span>
              <Icon name="bx:refresh" class="w-4 h-4" />
            </button>
          </div>

          {/* Швидкі теги-фільтри (заповнюють пошук або переходять) */}
          <div class="flex flex-wrap gap-2 mb-5">
            {quickChips.map((chip) => (
              <button
                type="button"
                class="tag-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-100/90 hover:bg-blue-600 text-slate-700 hover:text-white text-xs font-bold transition-all active:scale-95 cursor-pointer border border-slate-200/60 hover:border-blue-600"
                data-query={chip.q}
              >
                <Icon name="bx:search-alt-2" class="w-3.5 h-3.5 opacity-60" />
                <span>{chip.label}</span>
              </button>
            ))}
          </div>

          {/* Швидкі картки переходів (підтримують навігацію клавіатурою ↑ ↓ Enter) */}
          <div id="default-cards-list" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            {quickPresets.map((preset) => (
              <a
                href={preset.href}
                class="search-nav-item group flex items-center justify-between p-3.5 rounded-2xl bg-slate-50/80 hover:bg-blue-50/80 border border-slate-200/70 hover:border-blue-300 transition-all"
              >
                <div class="flex items-center gap-3 min-w-0">
                  <span class="w-10 h-10 rounded-xl bg-white border border-slate-100 flex items-center justify-center text-lg shadow-2xs shrink-0 group-hover:scale-105 transition-transform">
                    {preset.icon}
                  </span>
                  <div class="min-w-0">
                    <span class="block text-[9px] font-black uppercase tracking-widest text-blue-600 mb-0.5">
                      {preset.badge}
                    </span>
                    <span class="block text-xs sm:text-sm font-bold text-slate-800 group-hover:text-blue-700 truncate">
                      {preset.label}
                    </span>
                  </div>
                </div>
                <Icon name="bx:chevron-right" class="w-5 h-5 text-slate-400 group-hover:text-blue-600 group-hover:translate-x-0.5 transition-all shrink-0 ml-2" />
              </a>
            ))}
          </div>
        </div>
      </div>

      {/* ЖИВІ РЕЗУЛЬТАТИ ПОШУКУ */}
      <div id="results-container" class="hidden space-y-3">
        <div class="flex items-center justify-between px-1">
          <span id="results-count" class="text-[11px] font-black uppercase tracking-widest text-slate-400">
            Знайдено результатів: 0
          </span>
          <span class="text-[11px] text-slate-400 font-medium">
            Натисніть <kbd class="px-1.5 py-0.5 bg-slate-100 rounded text-slate-600 font-bold">Enter</kbd> для переходу
          </span>
        </div>
        <div id="results-list" class="space-y-2" role="listbox"></div>
      </div>

    </div>

    {/* НИЖНІЙ КОЛОНТИТУЛ МОДАЛКИ */}
    <div class="px-5 py-3 bg-slate-50 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500 shrink-0">
      <div class="flex items-center gap-2">
        <Icon name="bx:phone-call" class="w-4 h-4 text-blue-600" />
        <span>Реєстратура: <strong class="text-slate-700">{siteSettings.phones[0]?.number || "(056) 720-79-01"}</strong></span>
      </div>
      <a href="/#contacts" class="search-QuickCloseLink font-bold text-blue-600 hover:underline flex items-center gap-1">
        <span>Усі контакти та маршрут</span>
        <Icon name="bx:right-arrow-alt" class="w-4 h-4" />
      </a>
    </div>

  </div>
  <div id="search-close" class="fixed inset-0 -z-10 cursor-pointer"></div>
</div>

<script is:inline define:vars={{ searchIndex, quickPresets, isLinacVisible: visibleServiceIds.has("linac") }}>
  (function initSmartSearch() {
    // Словник медичних синонімів та семантичних асоціацій
    const SYNONYM_MAP = [
      {
        triggers: ["прискорювач", "опромінення", "лінійник", "електа", "elekta", "versa", "synergy", "imrt", "vmat", "igrt", "sbrt", "промені", "променева", "радіотерапія"],
        expand: ["мегавольтна", "elekta", "versa hd", "synergy", "brainlab"]
      },
      {
        triggers: ["брейнлаб", "brainlab", "стереотаксис", "радіохірургія", "кіберніж", "точність", "дихання"],
        expand: ["brainlab", "versa hd", "мрія здійснилась", "стереотаксис"]
      },
      {
        triggers: ["довідка", "аналізи", "аналіз", "документи", "паспорт", "направлення", "електронне", "перший візит", "підготовка", "що брати", "гістологія", "біопсія", "диск", "чекліст"],
        expand: ["підготовка", "маршрут", "чекліст", "направлення", "нсзу", "кт-розмітка"]
      },
      {
        triggers: ["нсзу", "безкоштовно", "безоплатно", "ціна", "вартість", "платно", "гроші", "оплата", "гарантії"],
        expand: ["нсзу", "безкоштовне", "направлення"]
      },
      {
        triggers: ["лікар", "лікарі", "онколог", "радіолог", "спеціаліст", "завідувачка", "завідуюча", "персонал", "фізик", "рентгенолог", "медсестра"],
        expand: ["лікар", "персонал", "радіолог"]
      },
      {
        triggers: ["кт", "томограф", "томографія", "маска", "розмітка", "симуляція", "топометрія", "тату", "мітки", "контраст"],
        expand: ["кт-розмітка", "топометрія", "toshiba"]
      },
      {
        triggers: ["телефон", " подзвонити", "адреса", "як доїхати", "де знаходиться", "космічна", "гавриленка", "ребініна", "графік", "години", "розклад", "реєстратура", "контакти", "запис"],
        expand: ["контакти", "реєстратура", "графік", "космічна"]
      },
      {
        triggers: ["шкіра", "базаліома", "родимка", "меланома", "рубець", "келоїд", "шпора", "близький", "рентген"],
        expand: ["близькофокусна", "рентгенотерапія", "шкіра"]
      },
      {
        triggers: ["матка", "шийка", "простата", "гінекологія", "контактна", "іридій", "брахі", "аплікатор"],
        expand: ["брахітерапія", "контактна"]
      },
      {
        triggers: ["кобальт", "тератрон", "агат", "гамма"],
        expand: ["гамма-терапія", "кобальт"]
      },
      {
        triggers: ["магніт", "реабілітація", "відновлення", "набряк", "лімфостаз", "фіброз", "суглоб"],
        expand: ["магнітотерапія", "реабілітація"]
      }
    ];

    const CATEGORY_STYLES = {
      "Сторінка": "bg-blue-50 text-blue-700 border-blue-200",
      "Лікар": "bg-emerald-50 text-emerald-700 border-emerald-200",
      "Обладнання": "bg-purple-50 text-purple-700 border-purple-200",
      "Пацієнту": "bg-amber-50 text-amber-800 border-amber-200",
      "Новина": "bg-cyan-50 text-cyan-700 border-cyan-200"
    };

    function escapeHtml(str) {
      return String(str || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function highlightText(text, tokens) {
      const safeText = escapeHtml(text);
      if (!tokens || tokens.length === 0) return safeText;
      const validTokens = tokens
        .filter((t) => t.length >= 1)
        .map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));
      if (validTokens.length === 0) return safeText;

      const regex = new RegExp(`(${validTokens.join("|")})`, "gi");
      return safeText.replace(
        regex,
        '<mark class="bg-amber-200/80 text-slate-900 rounded px-0.5 font-extrabold">$1</mark>'
      );
    }

    function setupSearchElements() {
      const modal = document.getElementById("search-modal");
      if (modal && modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }

      const trigger = document.getElementById("search-trigger");
      const closeBackdrop = document.getElementById("search-close");
      const closeBtn = document.getElementById("modal-close-btn");
      const searchInput = document.getElementById("search-input");
      const clearBtn = document.getElementById("search-clear-btn");
      const suggestionsBox = document.getElementById("suggestions-box");
      const resultsContainer = document.getElementById("results-container");
      const resultsList = document.getElementById("results-list");
      const resultsCount = document.getElementById("results-count");
      const shuffleBtn = document.getElementById("shuffle-suggestions-btn");
      const defaultCardsList = document.getElementById("default-cards-list");

      if (!modal || !searchInput) return;

      let activeIndex = -1;

      function getNavigableItems() {
        if (!resultsContainer.classList.contains("hidden")) {
          return Array.from(resultsList.querySelectorAll(".search-nav-item"));
        }
        return Array.from(defaultCardsList.querySelectorAll(".search-nav-item"));
      }

      function updateActiveSelection() {
        const items = getNavigableItems();
        items.forEach((el, idx) => {
          if (idx === activeIndex) {
            el.classList.add("ring-2", "ring-blue-500", "bg-blue-50/90", "border-blue-400");
            el.scrollIntoView({ block: "nearest", behavior: "smooth" });
          } else {
            el.classList.remove("ring-2", "ring-blue-500", "bg-blue-50/90", "border-blue-400");
          }
        });
      }

      function openModal() {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
        activeIndex = -1;
        updateActiveSelection();
        setTimeout(() => searchInput.focus(), 20);
      }

      function closeModal() {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        document.body.style.overflow = "";
        activeIndex = -1;
      }

      function performSmartSearch(rawQuery) {
        const cleanQuery = (rawQuery || "").toLowerCase().trim();
        clearBtn.classList.toggle("hidden", cleanQuery.length === 0);

        if (cleanQuery.length === 0) {
          resultsContainer.classList.add("hidden");
          suggestionsBox.classList.remove("hidden");
          activeIndex = -1;
          updateActiveSelection();
          return;
        }

        suggestionsBox.classList.add("hidden");
        resultsContainer.classList.remove("hidden");

        // Розбиваємо введений запит на окремі слова (підтримка 1-2 літер та 2+ слів)
        const queryTokens = cleanQuery.split(/\s+/).filter(Boolean);

        // Розширюємо семантичними асоціаціями
        const expandedTerms = new Set(queryTokens);
        SYNONYM_MAP.forEach((group) => {
          const matched = group.triggers.some((trig) =>
            queryTokens.some((tok) =>
              tok.length >= 2 ? trig.includes(tok) || tok.includes(trig) : trig.startsWith(tok)
            )
          );
          if (matched) {
            group.expand.forEach((e) => expandedTerms.add(e));
          }
        });

        const scored = [];

        searchIndex.forEach((item) => {
          const titleLower = (item.title || "").toLowerCase();
          const subtitleLower = (item.subtitle || "").toLowerCase();
          const tagsLower = (item.tags || []).map((t) => String(t).toLowerCase());
          let score = 0;

          // 1. Прямі збіги з тим, що ввів користувач (найвищий пріоритет)
          let allTokensMatched = true;
          for (const tok of queryTokens) {
            let tokenMatched = false;
            if (titleLower.includes(tok)) {
              score += titleLower.startsWith(tok) ? 45 : 30;
              tokenMatched = true;
            }
            if (tagsLower.some((t) => t === tok || t.startsWith(tok))) {
              score += 25;
              tokenMatched = true;
            } else if (tagsLower.some((t) => t.includes(tok))) {
              score += 15;
              tokenMatched = true;
            }
            if (subtitleLower.includes(tok)) {
              score += 10;
              tokenMatched = true;
            }
            if (!tokenMatched) {
              allTokensMatched = false;
            }
          }

          if (allTokensMatched && queryTokens.length > 1) {
            score += 35; // Бонус за точний збіг обох слів
          }

          // 2. Семантичні асоціації (якщо користувач ввів синонім)
          if (queryTokens[0].length >= 2) {
            expandedTerms.forEach((term) => {
              if (!queryTokens.includes(term)) {
                if (titleLower.includes(term) || tagsLower.some((t) => t.includes(term))) {
                  score += 12;
                }
              }
            });
          }

          if (score > 0) {
            scored.push({ item, score });
          }
        });

        scored.sort((a, b) => b.score - a.score);
        const topResults = scored.slice(0, 12).map((s) => s.item);

        if (resultsCount) {
          resultsCount.textContent = `Знайдено результатів: ${topResults.length}`;
        }

        if (topResults.length === 0) {
          resultsList.innerHTML = `
            <div class="text-center py-10 px-4 bg-slate-50 rounded-2xl border border-slate-100">
              <div class="text-3xl mb-2">🔍</div>
              <p class="text-sm font-bold text-slate-700 mb-1">За запитом «${escapeHtml(rawQuery)}» прямих збігів не знайдено</p>
              <p class="text-xs text-slate-500 mb-4">Спробуйте інше формулювання або перейдіть до популярних розділів:</p>
              <div class="flex flex-wrap justify-center gap-2">
                ${isLinacVisible ? '<a href="/services/linac" class="px-3.5 py-2 rounded-xl bg-white border border-slate-200 text-xs font-bold text-blue-600 hover:bg-blue-50">⚡ Лінійні прискорювачі</a>' : ''}
                <a href="/doctors" class="px-3.5 py-2 rounded-xl bg-white border border-slate-200 text-xs font-bold text-blue-600 hover:bg-blue-50">👨‍⚕️ Лікарі відділення</a>
                <a href="/#patient-checklist" class="px-3.5 py-2 rounded-xl bg-white border border-slate-200 text-xs font-bold text-blue-600 hover:bg-blue-50">📋 Маршрут пацієнта</a>
                <a href="/#contacts" class="px-3.5 py-2 rounded-xl bg-white border border-slate-200 text-xs font-bold text-blue-600 hover:bg-blue-50">📞 Контакти</a>
              </div>
            </div>
          `;
          activeIndex = -1;
          return;
        }

        resultsList.innerHTML = topResults
          .map((item) => {
            const catClass =
              CATEGORY_STYLES[item.category] || "bg-slate-100 text-slate-700 border-slate-200";
            return `
              <a
                href="${escapeHtml(item.url)}"
                role="option"
                class="search-nav-item group flex items-center justify-between p-3.5 sm:p-4 rounded-2xl bg-slate-50/70 hover:bg-blue-50/70 border border-slate-200/70 hover:border-blue-300 transition-all"
              >
                <div class="flex items-start gap-3.5 min-w-0 pr-3">
                  <span class="w-10 h-10 rounded-xl bg-white border border-slate-200/80 flex items-center justify-center text-lg shrink-0 mt-0.5 shadow-2xs group-hover:scale-105 transition-transform">
                    ${escapeHtml(item.icon || "📄")}
                  </span>
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="px-2 py-0.5 text-[9px] font-black uppercase tracking-wider rounded-md border ${catClass}">
                        ${escapeHtml(item.category)}
                      </span>
                    </div>
                    <div class="text-sm sm:text-base font-bold text-slate-900 group-hover:text-blue-700 transition-colors leading-snug">
                      ${highlightText(item.title, queryTokens)}
                    </div>
                    ${
                      item.subtitle
                        ? `<div class="text-xs text-slate-500 mt-1 line-clamp-2 leading-relaxed">${highlightText(item.subtitle, queryTokens)}</div>`
                        : ""
                    }
                  </div>
                </div>
                <div class="w-8 h-8 flex items-center justify-center rounded-full bg-white text-slate-400 group-hover:bg-blue-600 group-hover:text-white shadow-2xs transition-all shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </a>
            `;
          })
          .join("");

        activeIndex = 0;
        updateActiveSelection();

        // Закриваємо модалку при кліку на результат (особливо важливо для якірних посилань типу /#contacts)
        resultsList.querySelectorAll(".search-nav-item").forEach((link) => {
          link.addEventListener("click", () => {
            closeModal();
          });
        });
      }

      trigger?.addEventListener("click", openModal);
      closeBackdrop?.addEventListener("click", closeModal);
      closeBtn?.addEventListener("click", closeModal);

      modal.querySelectorAll(".search-nav-item, .search-QuickCloseLink").forEach((link) => {
        link.addEventListener("click", () => {
          closeModal();
        });
      });

      searchInput.addEventListener("input", (e) => {
        performSmartSearch(e.target.value);
      });

      searchInput.addEventListener("focus", () => {
        if (!searchInput.value.trim()) {
          suggestionsBox.classList.remove("hidden");
          resultsContainer.classList.add("hidden");
        }
      });

      clearBtn?.addEventListener("click", () => {
        searchInput.value = "";
        performSmartSearch("");
        searchInput.focus();
      });

      // Клік по швидкому тегу
      modal.querySelectorAll(".tag-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const q = btn.getAttribute("data-query") || "";
          searchInput.value = q;
          performSmartSearch(q);
          searchInput.focus();
        });
      });

      // Рандомізація / оновлення підбірки швидких карток
      shuffleBtn?.addEventListener("click", () => {
        const cards = Array.from(defaultCardsList.children);
        for (let i = cards.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          defaultCardsList.appendChild(cards[j]);
        }
      });

      // Клавіатурна навігація (↑, ↓, Enter, Esc, Ctrl+K)
      document.addEventListener("keydown", (e) => {
        // Відкриття за Ctrl+K або Cmd+K
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          if (modal.classList.contains("hidden")) {
            openModal();
          } else {
            closeModal();
          }
          return;
        }

        if (modal.classList.contains("hidden")) return;

        if (e.key === "Escape") {
          e.preventDefault();
          if (searchInput.value.trim().length > 0) {
            searchInput.value = "";
            performSmartSearch("");
          } else {
            closeModal();
          }
          return;
        }

        const items = getNavigableItems();
        if (items.length === 0) return;

        if (e.key === "ArrowDown") {
          e.preventDefault();
          activeIndex = (activeIndex + 1) % items.length;
          updateActiveSelection();
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          activeIndex = (activeIndex - 1 + items.length) % items.length;
          updateActiveSelection();
        } else if (e.key === "Enter" && activeIndex >= 0 && items[activeIndex]) {
          e.preventDefault();
          const targetHref = items[activeIndex].getAttribute("href");
          closeModal();
          if (targetHref) {
            window.location.href = targetHref;
          }
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupSearchElements);
    } else {
      setupSearchElements();
    }
    document.addEventListener("astro:after-swap", setupSearchElements);
  })();
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 10px;
  }
  input:focus {
    outline: none;
  }
</style>
