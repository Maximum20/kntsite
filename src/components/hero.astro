---
import { Icon } from "astro-icon/components";
import { siteSettings } from "../data";

const {
  description = siteSettings.heroDescription,
  subtitle = siteSettings.heroSubtitle,
} = Astro.props;
---

<section class="max-w-[1850px] mx-auto px-6 md:px-12 lg:px-20 pt-4 md:pt-16 pb-16 md:pb-28 font-sans relative overflow-visible">
  <div class="grid lg:grid-cols-[1fr_1.3fr] items-center gap-12 lg:gap-24 relative z-10 min-h-[560px]">
    <div class="text-center lg:text-left order-1 relative z-10">
      <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5 mb-6">
        <div class="inline-flex items-center gap-2 bg-cyan-50 text-cyan-700 px-4 py-2 rounded-full text-[11px] font-bold uppercase tracking-[0.18em] border border-cyan-100 shadow-xs select-none">
          <Icon name="bx:bxs-badge-check" class="w-4 h-4 text-cyan-600" />
          <span>Передові технології лікування</span>
        </div>

        <a
          href="#faq-section"
          class="inline-flex items-center gap-2 bg-blue-50 hover:bg-blue-100/80 text-blue-700 px-3.5 py-2 rounded-full text-[10px] md:text-[11px] font-bold uppercase tracking-widest border border-blue-100 shadow-xs transition-transform duration-300 hover:scale-105 select-none"
        >
          <img src="/hero/nszu.png" alt="НСЗУ" width="20" height="20" class="h-4 md:h-5 w-auto object-contain" />
          <span>Програма медичних гарантій</span>
        </a>
      </div>

      <div class="mb-8 animate-fade-in-up text-center lg:text-left relative z-20 overflow-visible group">
        <div class="inline-flex items-center justify-center lg:justify-start gap-2 mb-3 relative">
          <div class="w-4 h-8 border-l-2 border-t-2 border-blue-500/40 rounded-tl-lg transition-all duration-700 group-hover:translate-x-1 group-hover:translate-y-1"></div>
          <h1 class="text-5xl md:text-8xl font-extrabold tracking-tight">
            <span class="bg-gradient-to-br from-gray-900 via-slate-800 to-slate-600 bg-clip-text text-transparent px-2">
              Центр
            </span>
          </h1>
          <div class="w-4 h-8 border-r-2 border-b-2 border-blue-500/40 rounded-br-lg transition-all duration-700 group-hover:-translate-x-1 group-hover:-translate-y-1"></div>
        </div>

        <div class="text-4xl sm:text-5xl md:text-8xl font-black leading-none mb-7">
          <span class="inline-block pr-2 bg-gradient-to-r from-blue-600 via-cyan-500 to-purple-600 bg-clip-text text-transparent">
            променевої терапії
          </span>
        </div>

        <div class="inline-flex items-center gap-3 px-6 py-3 rounded-2xl bg-white/60 backdrop-blur-md border border-white/80 shadow-[0_8px_32px_0_rgba(31,38,135,0.1)] transition-transform hover:scale-105 cursor-default">
          <div class="relative flex items-center justify-center">
            <Icon name="bx:bxs-map-pin" class="w-6 h-6 text-blue-500 animate-bounce" />
          </div>
          <span class="text-xl md:text-3xl font-bold bg-gradient-to-r from-slate-700 to-slate-500 bg-clip-text text-transparent tracking-wide">
            {subtitle}
          </span>
          <span class="text-2xl group-hover:rotate-12 transition-transform">🏙️</span>
        </div>
      </div>

      {/* Мобільне зображення */}
      <div class="lg:hidden my-10 relative z-10">
        <div class="rounded-[2rem] overflow-hidden shadow-xl border-4 border-white bg-slate-100 relative z-10 aspect-[4/3]">
          <img
            src="/hero/raddepartment.jpg"
            alt="Будівля відділення променевої терапії КНТ ДОКОД ДОР"
            width="800"
            height="600"
            class="hero-dynamic-img w-full h-full object-cover"
            loading="eager"
          />
        </div>

        <div class="hero-hug-trigger absolute -bottom-6 -right-2 bg-white/95 backdrop-blur-md py-3 px-4 rounded-[1.5rem] shadow-2xl border border-slate-100 max-w-[260px] animate-hero-float z-20 cursor-pointer active:scale-95">
          <div class="flex items-center gap-3 text-left pointer-events-none">
            <div class="w-10 h-10 shrink-0 bg-cyan-100 rounded-full flex items-center justify-center text-cyan-600 shadow-inner relative overflow-hidden">
              <div class="hero-heart-layer absolute inset-0 flex items-center justify-center transition-all duration-300">
                <Icon name="bx:bxs-heart" class="w-6 h-6" />
              </div>
              <div class="hero-hug-layer absolute inset-0 flex items-center justify-center text-2xl opacity-0 scale-50 transition-all duration-300">🤗</div>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 text-[11px] mb-0 tracking-tight text-balance">Турбота про кожного</h4>
              <p class="text-[9px] text-slate-500 leading-tight font-medium">Індивідуальні плани лікування та підтримка на кожному етапі.</p>
            </div>
          </div>
        </div>
      </div>

      <p class="text-base md:text-lg mt-6 text-slate-600 max-w-xl mx-auto lg:mx-0 leading-relaxed font-medium relative z-20">
        {description}
      </p>

      {/* Швидкі кнопки переходу для пацієнтів */}
      <div class="mt-8 flex flex-col sm:flex-row gap-3.5 justify-center lg:justify-start relative z-20">
        <a
          href="#patient-checklist"
          class="inline-flex gap-2.5 items-center justify-center px-7 py-4 rounded-2xl font-bold text-sm shadow-lg shadow-blue-600/20 bg-blue-600 hover:bg-blue-700 text-white transition-all active:scale-95"
        >
          <Icon class="w-5 h-5" name="bx:list-check" />
          <span>Підготовка до візиту (Чекліст)</span>
        </a>

        <a
          href="/doctors"
          class="inline-flex gap-2.5 items-center justify-center px-7 py-4 rounded-2xl font-bold text-sm bg-white/80 hover:bg-white border border-slate-200 hover:border-blue-300 transition-all active:scale-95 text-slate-700 shadow-sm"
        >
          <Icon class="text-blue-600 w-5 h-5" name="bx:user-check" />
          <span>Наші спеціалісти</span>
        </a>
      </div>

      <div class="mt-10 inline-flex items-center justify-between bg-white/60 backdrop-blur-md border border-white/80 py-3.5 px-8 md:py-4 md:px-12 rounded-[2.5rem] relative z-20 shadow-sm min-w-[280px] md:min-w-[400px]">
        <div class="flex flex-col text-left">
          <span class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tighter">{siteSettings.statsYears}</span>
          <span class="text-[9px] md:text-xs uppercase font-bold text-slate-500 tracking-widest mt-0.5">Років досвіду</span>
        </div>
        <div class="w-px h-10 bg-slate-300/60 mx-4"></div>
        <div class="flex flex-col text-left">
          <span class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tighter">{siteSettings.statsPatients}</span>
          <span class="text-[9px] md:text-xs uppercase font-bold text-slate-500 tracking-widest mt-0.5">Пацієнтів щорічно</span>
        </div>
      </div>
    </div>

    <div class="hidden lg:block relative order-2 z-10 w-full">
      <div class="relative transform lg:scale-105 transition-transform duration-500 hover:scale-[1.09] group">
        <div class="rounded-[2.5rem] overflow-hidden shadow-2xl border-8 border-white bg-slate-100 relative z-10 aspect-[4/3]">
          <img
            src="/hero/raddepartment.jpg"
            alt="Будівля відділення променевої терапії КНТ ДОКОД ДОР"
            width="1200"
            height="900"
            class="hero-dynamic-img w-full h-full object-cover transition-opacity duration-500"
            loading="eager"
          />
        </div>
      </div>

      <div class="hero-hug-trigger absolute -bottom-10 -right-6 xl:-right-10 bg-white/95 backdrop-blur-md p-6 md:p-7 rounded-[2.5rem] shadow-2xl border border-slate-100 max-w-[280px] md:max-w-[320px] animate-hero-float z-30 transition-all duration-300 cursor-pointer active:scale-95 select-none overflow-hidden">
        <div class="flex items-start gap-4 text-left pointer-events-none">
          <div class="w-12 h-12 shrink-0 bg-cyan-100 rounded-full flex items-center justify-center text-cyan-600 shadow-inner relative overflow-hidden">
            <div class="hero-heart-layer absolute inset-0 flex items-center justify-center transition-all duration-300 opacity-100 scale-100">
              <Icon name="bx:bxs-heart" class="w-7 h-7" />
            </div>
            <div class="hero-hug-layer absolute inset-0 flex items-center justify-center text-4xl opacity-0 scale-50 transition-all duration-300 leading-none">🤗</div>
          </div>
          <div class="pr-2">
            <h4 class="font-bold text-slate-900 text-base mb-1 tracking-tight leading-tight">Турбота про кожного</h4>
            <p class="text-[12px] text-slate-500 leading-relaxed font-medium">Індивідуальні плани лікування та підтримка на кожному етапі.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes hero-float-anim {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  .animate-hero-float {
    animation: hero-float-anim 5s ease-in-out infinite;
  }
</style>

<script>
  function initHeroHug() {
    const cards = document.querySelectorAll<HTMLElement>(".hero-hug-trigger");
    cards.forEach((card) => {
      const heart = card.querySelector<HTMLElement>(".hero-heart-layer");
      const hug = card.querySelector<HTMLElement>(".hero-hug-layer");
      if (heart && hug) {
        card.addEventListener("click", () => {
          heart.style.opacity = "0";
          heart.style.transform = "scale(0)";
          hug.style.opacity = "1";
          hug.style.transform = "scale(1.4)";
          setTimeout(() => {
            heart.style.opacity = "1";
            heart.style.transform = "scale(1)";
            hug.style.opacity = "0";
            hug.style.transform = "scale(0.5)";
          }, 1500);
        });
      }
    });
  }

  initHeroHug();
  document.addEventListener("astro:after-swap", initHeroHug);
</script>
