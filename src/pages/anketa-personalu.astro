---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import { staffRoles } from "../data";

const departments = [
  "Мегавольтна терапія",
  "Гамма-терапія",
  "Брахітерапія",
  "Близький фокус",
  "КТ-розмітка",
  "Реабілітація",
  "Інженерно-фізична група",
];

const doctorRoles = staffRoles.filter((r) => r.group === "doctors");
const specialistRoles = staffRoles.filter((r) => r.group !== "doctors");
---

<Layout
  title="Анкета для персоналу"
  description="Службова прихована форма для подання даних спеціаліста відділення до Keystatic CMS."
  hideSubNav={true}
  noindex={true}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14 font-sans">
    {/* Шапка сторінки */}
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-50 border border-sky-200 text-sky-700 text-[11px] font-black uppercase tracking-[0.18em] mb-3">
        <span class="w-2 h-2 rounded-full bg-sky-500"></span>
        <span>Службова анкета • Потрібен код доступу</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        Анкета <span class="bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent">працівника відділення</span>
      </h1>
      <p class="text-slate-600 text-sm sm:text-base mt-3 max-w-2xl leading-relaxed">
        Заповніть форму нижче, щоб створити чернетку своєї картки спеціаліста. Після відправки дані потраплять на перевірку адміністратору в Keystatic і будуть опубліковані на сайті після підтвердження.
      </p>
    </div>

    {/* Стан успішної відправки */}
    <section
      id="staffSuccessPanel"
      class="hidden rounded-[2rem] bg-white/95 backdrop-blur-xl border-2 border-emerald-200 p-8 sm:p-10 shadow-xl text-center"
      role="status"
      aria-live="polite"
    >
      <div class="w-16 h-16 mx-auto mb-5 rounded-3xl bg-emerald-50 border border-emerald-200 text-emerald-600 flex items-center justify-center">
        <svg class="w-9 h-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
          <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mb-3">
        Анкету надіслано на перевірку
      </h2>
      <p id="staffSuccessText" class="text-slate-600 text-sm sm:text-base max-w-xl mx-auto leading-relaxed mb-6">
        Дякуємо! Ваші дані збережено як чернетку. Після модерації адміністратором у Keystatic картка зʼявиться у розділі «Персонал».
      </p>
      <button
        id="staffResetBtn"
        type="button"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-lg shadow-blue-600/20 transition-all cursor-pointer"
      >
        Заповнити ще одну анкету
      </button>
    </section>

    {/* Основна форма */}
    <form
      id="staffAnketaForm"
      class="space-y-6"
      novalidate
    >
      {/* Приховане honeypot-поле для захисту від ботів */}
      <div class="sr-only" aria-hidden="true">
        <label for="staffWebsiteTrap">Вебсайт</label>
        <input
          id="staffWebsiteTrap"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      {/* 1. Код доступу */}
      <section class="bg-white/90 backdrop-blur-xl border-2 border-blue-200/80 rounded-[2rem] p-5 sm:p-7 shadow-md">
        <div class="flex items-start gap-3 mb-4">
          <div class="w-10 h-10 rounded-2xl bg-blue-50 border border-blue-200 text-blue-600 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-black text-slate-900">1. Код доступу</h2>
            <p class="text-xs sm:text-sm text-slate-500">
              Обовʼязковий службовий код, який надає завідувач або адміністратор сайту. Без нього анкета не буде прийнята.
            </p>
          </div>
        </div>

        <div class="relative">
          <label for="staffAccessCode" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
            Код доступу <span class="text-red-500">*</span>
          </label>
          <div class="relative flex items-center">
            <input
              id="staffAccessCode"
              name="accessCode"
              type="password"
              required
              autocomplete="off"
              placeholder="Введіть код доступу"
              class="w-full px-4 py-3 pr-12 rounded-2xl border border-slate-200 bg-white text-slate-900 font-semibold text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all"
            />
            <button
              id="toggleAccessCodeBtn"
              type="button"
              aria-label="Показати або приховати код доступу"
              class="absolute right-3 p-1.5 rounded-xl text-slate-400 hover:text-blue-600 hover:bg-blue-50 transition-colors cursor-pointer"
            >
              <svg id="eyeIconOpen" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
              <svg id="eyeIconClosed" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                <line x1="1" y1="1" x2="23" y2="23" />
              </svg>
            </button>
          </div>
        </div>
      </section>

      {/* 2. Основна інформація */}
      <section class="bg-white/90 backdrop-blur-xl border border-slate-200/80 rounded-[2rem] p-5 sm:p-7 shadow-md space-y-5">
        <div>
          <h2 class="text-lg font-black text-slate-900">2. Основні дані</h2>
          <p class="text-xs sm:text-sm text-slate-500">
            Відображаються на лицьовій стороні картки спеціаліста та у фільтрах команди.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div class="md:col-span-2">
            <label for="staffFullName" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
              ПІБ (Прізвище Імʼя По батькові) <span class="text-red-500">*</span>
            </label>
            <input
              id="staffFullName"
              name="fullName"
              type="text"
              required
              maxlength="120"
              placeholder="Наприклад: Іваненко Олена Петрівна"
              class="w-full px-4 py-3 rounded-2xl border border-slate-200 bg-white text-slate-900 font-semibold text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all"
            />
            <p class="text-[11px] text-slate-500 mt-1">
              Перше слово використовується як прізвище для картки та файлу, а повне ПІБ зберігається в анкеті.
            </p>
          </div>

          <div>
            <label for="staffRole" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
              Посада <span class="text-red-500">*</span>
            </label>
            <select
              id="staffRole"
              name="role"
              required
              class="w-full px-4 py-3 rounded-2xl border border-slate-200 bg-white text-slate-900 font-semibold text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all"
            >
              <option value="">Оберіть посаду...</option>
              {doctorRoles.length > 0 && (
                <optgroup label="Лікарі">
                  {doctorRoles.map((role) => (
                    <option value={role.slug}>{role.title}</option>
                  ))}
                </optgroup>
              )}
              {specialistRoles.length > 0 && (
                <optgroup label="Медичні фізики, інженери та середній медперсонал">
                  {specialistRoles.map((role) => (
                    <option value={role.slug}>{role.title}</option>
                  ))}
                </optgroup>
              )}
            </select>
          </div>

          <div>
            <label for="staffDepartment" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
              Відділення / підрозділ <span class="text-red-500">*</span>
            </label>
            <select
              id="staffDepartment"
              name="department"
              required
              class="w-full px-4 py-3 rounded-2xl border border-slate-200 bg-white text-slate-900 font-semibold text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all"
            >
              {departments.map((dept) => (
                <option value={dept}>{dept}</option>
              ))}
            </select>
          </div>

          <div class="md:col-span-2">
            <label for="staffExperience" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
              Досвід роботи / кваліфікаційна категорія
            </label>
            <input
              id="staffExperience"
              name="experience"
              type="text"
              maxlength="120"
              placeholder="Наприклад: 12 років • Вища кваліфікаційна категорія"
              class="w-full px-4 py-3 rounded-2xl border border-slate-200 bg-white text-slate-900 font-semibold text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all"
            />
          </div>
        </div>
      </section>

      {/* 3. Професійний профіль та зворотна сторона картки */}
      <section class="bg-white/90 backdrop-blur-xl border border-slate-200/80 rounded-[2rem] p-5 sm:p-7 shadow-md space-y-5">
        <div>
          <h2 class="text-lg font-black text-slate-900">3. Професійна інформація</h2>
          <p class="text-xs sm:text-sm text-slate-500">
            Заповніть поля, які ви хочете показати пацієнтам на зворотній стороні картки.
          </p>
        </div>

        {/* Перемикач зворотної сторони картки ("auto" / "hide") */}
        <fieldset>
          <legend class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">
            Показувати зворотну сторону картки
          </legend>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <label class="flex items-start gap-3 p-3.5 rounded-2xl border-2 border-blue-200 bg-blue-50/50 cursor-pointer has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50 transition-all">
              <input
                type="radio"
                name="showBackCard"
                value="auto"
                checked
                class="mt-1 w-4 h-4 accent-blue-600 cursor-pointer"
              />
              <div>
                <span class="block text-sm font-bold text-slate-900">Автоматично (рекомендовано)</span>
                <span class="block text-xs text-slate-500 mt-0.5">
                  Картка перевертається за натисканням, якщо є заповнена інформація
                </span>
              </div>
            </label>

            <label class="flex items-start gap-3 p-3.5 rounded-2xl border-2 border-slate-200 bg-slate-50/70 cursor-pointer has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50 transition-all">
              <input
                type="radio"
                name="showBackCard"
                value="hide"
                class="mt-1 w-4 h-4 accent-blue-600 cursor-pointer"
              />
              <div>
                <span class="block text-sm font-bold text-slate-900">Не показувати</span>
                <span class="block text-xs text-slate-500 mt-0.5">
                  Статична картка лише з фото, ПІБ, посадою та відділенням
                </span>
              </div>
            </label>
          </div>
        </fieldset>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="staffBio" class="block text-xs font-bold uppercase tracking-wider text-slate-600">
              Коротка цитата / про підхід до роботи
            </label>
            <span id="staffBioCount" class="text-[11px] font-bold text-slate-400">0 / 800</span>
          </div>
          <textarea
            id="staffBio"
            name="bio"
            rows="3"
            maxlength="800"
            placeholder="Короткий опис професійної спеціалізації або ваш принцип у роботі з пацієнтами..."
            class="w-full px-4 py-3 rounded-2xl border border-slate-200 bg-white text-slate-900 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all resize-y"
          ></textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label for="staffEducation" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
              Освіта та кваліфікація
            </label>
            <textarea
              id="staffEducation"
              name="education"
              rows="3"
              maxlength="300"
              placeholder="Навчальний заклад, інтернатура, спеціалізація..."
              class="w-full px-4 py-3 rounded-2xl border border-slate-200 bg-white text-slate-900 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all resize-y"
            ></textarea>
          </div>

          <div>
            <label for="staffAchievements" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
              Досягнення та стажування
            </label>
            <textarea
              id="staffAchievements"
              name="achievements"
              rows="3"
              maxlength="600"
              placeholder="Міжнародні курси, сертифікати, участь у конференціях (ESTRO, IAEA тощо)..."
              class="w-full px-4 py-3 rounded-2xl border border-slate-200 bg-white text-slate-900 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all resize-y"
            ></textarea>
          </div>
        </div>

        {/* Ключові напрямки (інтерактивний список тегів) */}
        <div>
          <label for="staffSpecInput" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
            Ключові напрямки / методики (до 15 пунктів)
          </label>
          <div class="flex gap-2">
            <input
              id="staffSpecInput"
              type="text"
              maxlength="80"
              placeholder="Наприклад: IMRT / VMAT, КТ-розмітка, Стереотаксис..."
              class="flex-1 px-4 py-2.5 rounded-2xl border border-slate-200 bg-white text-slate-900 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all"
            />
            <button
              id="addSpecBtn"
              type="button"
              class="px-4 py-2.5 rounded-2xl bg-sky-50 hover:bg-blue-600 text-blue-700 hover:text-white border border-sky-200 hover:border-blue-600 font-bold text-sm transition-all cursor-pointer shrink-0"
            >
              + Додати
            </button>
          </div>
          <p class="text-[11px] text-slate-500 mt-1">
            Натисніть Enter або «+ Додати» (можна вводити кілька через кому).
          </p>
          <div id="staffSpecsList" class="flex flex-wrap gap-2 mt-3"></div>
        </div>
      </section>

      {/* 4. Фото (опціонально з автоматичним WebP-стисненням у браузері) */}
      <section class="bg-white/90 backdrop-blur-xl border border-slate-200/80 rounded-[2rem] p-5 sm:p-7 shadow-md space-y-4">
        <div>
          <h2 class="text-lg font-black text-slate-900">4. Фотографія (необовʼязково)</h2>
          <p class="text-xs sm:text-sm text-slate-500">
            Бажано вертикальний портрет (3:4). Браузер автоматично стисне фото до max 800px у формат WebP (якість 80%) перед відправкою.
          </p>
        </div>

        <div
          id="staffPhotoDropZone"
          role="button"
          tabindex="0"
          aria-label="Оберіть або перетягніть фотографію"
          class="rounded-2xl border-2 border-dashed border-sky-300 bg-sky-50/40 hover:bg-sky-50 hover:border-blue-500 p-6 text-center transition-all cursor-pointer"
        >
          <input
            id="staffPhotoInput"
            type="file"
            accept="image/jpeg,image/png,image/webp,image/*"
            class="hidden"
          />
          <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-white border border-sky-200 text-blue-600 flex items-center justify-center shadow-xs">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <polyline points="21 15 16 10 5 21" />
            </svg>
          </div>
          <p class="text-sm font-bold text-slate-800">Натисніть для вибору або перетягніть фото</p>
          <p class="text-xs text-slate-500 mt-1">JPG, PNG або WebP • автоматичне стиснення до 800px WebP (до 1 МБ)</p>
        </div>

        {/* Превʼю та вага в КБ */}
        <div
          id="staffPhotoPreviewBox"
          class="hidden flex flex-col sm:flex-row items-center gap-5 p-4 rounded-2xl bg-slate-50 border border-slate-200"
        >
          <img
            id="staffPhotoPreviewImg"
            alt="Попередній перегляд стиснутого WebP фото"
            class="w-32 h-40 object-cover rounded-2xl border border-slate-200 shadow-xs bg-white shrink-0"
          />
          <div class="flex-1 min-w-0 text-center sm:text-left space-y-1.5">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-[11px] font-black uppercase tracking-wider">
              Готово у WebP (quality 0.8)
            </div>
            <p id="staffPhotoStats" class="text-sm font-bold text-slate-800"></p>
            <p id="staffPhotoDims" class="text-xs text-slate-500"></p>
            <div class="pt-1 flex flex-wrap justify-center sm:justify-start gap-2">
              <button
                id="replacePhotoBtn"
                type="button"
                class="px-3.5 py-1.5 rounded-xl bg-white hover:bg-sky-50 border border-slate-200 text-slate-700 hover:text-blue-700 font-bold text-xs transition-colors cursor-pointer"
              >
                Замінити фото
              </button>
              <button
                id="removePhotoBtn"
                type="button"
                class="px-3.5 py-1.5 rounded-xl bg-red-50 hover:bg-red-100 border border-red-200 text-red-700 font-bold text-xs transition-colors cursor-pointer"
              >
                Видалити
              </button>
            </div>
          </div>
        </div>
      </section>

      {/* Повідомлення про помилку */}
      <div
        id="staffErrorBox"
        role="alert"
        class="hidden p-4 rounded-2xl bg-red-50 border border-red-200 text-red-800 text-sm font-bold"
      ></div>

      {/* Кнопка відправки */}
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
        <p class="text-xs text-slate-500 text-center sm:text-left">
          Анкета створюється у статусі чернетки (<code>isActive: false</code>) і не публікується без модерації.
        </p>
        <button
          id="staffSubmitBtn"
          type="submit"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-2xl bg-blue-600 hover:bg-blue-700 disabled:opacity-60 disabled:cursor-not-allowed text-white font-extrabold text-sm shadow-lg shadow-blue-600/20 active:scale-[0.99] transition-all cursor-pointer"
        >
          <span id="staffSubmitSpinner" class="hidden w-4 h-4 border-2 border-white/40 border-t-white rounded-full animate-spin"></span>
          <span id="staffSubmitLabel">Надіслати анкету на перевірку</span>
        </button>
      </div>
    </form>
  </main>
</Layout>

<style>
  :global(html[data-theme="dark"]:not([data-a11y-contrast])) #staffAccessCode {
    background-color: #0f172a !important;
    border-color: #475569 !important;
    color: #f8fafc !important;
  }
</style>

<script>
  function initStaffAnketaForm() {
    const form = document.getElementById("staffAnketaForm") as HTMLFormElement | null;
    if (!form || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    const mountTime = performance.now();

    const successPanel = document.getElementById("staffSuccessPanel");
    const successText = document.getElementById("staffSuccessText");
    const resetBtn = document.getElementById("staffResetBtn");
    const errorBox = document.getElementById("staffErrorBox");

    const accessCodeInput = document.getElementById("staffAccessCode") as HTMLInputElement | null;
    const toggleAccessBtn = document.getElementById("toggleAccessCodeBtn");
    const eyeOpen = document.getElementById("eyeIconOpen");
    const eyeClosed = document.getElementById("eyeIconClosed");

    const fullNameInput = document.getElementById("staffFullName") as HTMLInputElement | null;
    const roleSelect = document.getElementById("staffRole") as HTMLSelectElement | null;
    const deptSelect = document.getElementById("staffDepartment") as HTMLSelectElement | null;
    const expInput = document.getElementById("staffExperience") as HTMLInputElement | null;
    const bioInput = document.getElementById("staffBio") as HTMLTextAreaElement | null;
    const bioCount = document.getElementById("staffBioCount");
    const eduInput = document.getElementById("staffEducation") as HTMLTextAreaElement | null;
    const achInput = document.getElementById("staffAchievements") as HTMLTextAreaElement | null;
    const honeypotInput = document.getElementById("staffWebsiteTrap") as HTMLInputElement | null;

    const specInput = document.getElementById("staffSpecInput") as HTMLInputElement | null;
    const addSpecBtn = document.getElementById("addSpecBtn");
    const specsList = document.getElementById("staffSpecsList");

    const photoDropZone = document.getElementById("staffPhotoDropZone");
    const photoInput = document.getElementById("staffPhotoInput") as HTMLInputElement | null;
    const photoPreviewBox = document.getElementById("staffPhotoPreviewBox");
    const photoPreviewImg = document.getElementById("staffPhotoPreviewImg") as HTMLImageElement | null;
    const photoStats = document.getElementById("staffPhotoStats");
    const photoDims = document.getElementById("staffPhotoDims");
    const replacePhotoBtn = document.getElementById("replacePhotoBtn");
    const removePhotoBtn = document.getElementById("removePhotoBtn");

    const submitBtn = document.getElementById("staffSubmitBtn") as HTMLButtonElement | null;
    const submitSpinner = document.getElementById("staffSubmitSpinner");
    const submitLabel = document.getElementById("staffSubmitLabel");

    let specializations: string[] = [];
    let compressedPhotoDataUrl = "";
    let isSubmitting = false;

    function showError(msg: string) {
      if (!errorBox) return;
      if (!msg) {
        errorBox.classList.add("hidden");
        errorBox.textContent = "";
      } else {
        errorBox.textContent = msg;
        errorBox.classList.remove("hidden");
        errorBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    }

    function formatKB(bytes: number): string {
      return `${(bytes / 1024).toLocaleString("uk-UA", {
        minimumFractionDigits: 1,
        maximumFractionDigits: 1,
      })} КБ`;
    }

    // Показати / приховати код доступу
    toggleAccessBtn?.addEventListener("click", () => {
      if (!accessCodeInput) return;
      const isHidden = accessCodeInput.type === "password";
      accessCodeInput.type = isHidden ? "text" : "password";
      eyeOpen?.classList.toggle("hidden", isHidden);
      eyeClosed?.classList.toggle("hidden", !isHidden);
    });

    // Лічильник символів цитати
    bioInput?.addEventListener("input", () => {
      if (bioCount) {
        bioCount.textContent = `${bioInput.value.length} / 800`;
      }
    });

    // Керування тегами спеціалізацій
    function renderSpecs() {
      if (!specsList) return;
      specsList.innerHTML = "";
      specializations.forEach((spec, idx) => {
        const chip = document.createElement("span");
        chip.className =
          "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-blue-50 border border-blue-200 text-blue-800 text-xs font-bold";
        const label = document.createElement("span");
        label.textContent = spec;
        const removeBtn = document.createElement("button");
        removeBtn.type = "button";
        removeBtn.className =
          "w-4 h-4 rounded-full bg-blue-200/70 hover:bg-red-500 hover:text-white flex items-center justify-center text-[10px] leading-none transition-colors cursor-pointer";
        removeBtn.setAttribute("aria-label", `Видалити ${spec}`);
        removeBtn.textContent = "×";
        removeBtn.addEventListener("click", () => {
          specializations.splice(idx, 1);
          renderSpecs();
        });
        chip.append(label, removeBtn);
        specsList.appendChild(chip);
      });
    }

    function addSpecFromInput() {
      if (!specInput) return;
      const raw = specInput.value.trim();
      if (!raw) return;

      const parts = raw
        .split(/[,;\n]+/)
        .map((s) => s.trim().slice(0, 80))
        .filter(Boolean);

      for (const item of parts) {
        if (specializations.length >= 15) break;
        if (!specializations.some((s) => s.toLowerCase() === item.toLowerCase())) {
          specializations.push(item);
        }
      }
      specInput.value = "";
      renderSpecs();
    }

    addSpecBtn?.addEventListener("click", addSpecFromInput);
    specInput?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        addSpecFromInput();
      }
    });

    // Клієнтське стиснення фото через Canvas до max 800px у WebP (quality 0.8)
    function clearPhoto() {
      compressedPhotoDataUrl = "";
      if (photoInput) photoInput.value = "";
      if (photoPreviewImg) photoPreviewImg.src = "";
      photoPreviewBox?.classList.add("hidden");
      photoDropZone?.classList.remove("hidden");
    }

    function processPhotoFile(file: File) {
      showError("");
      if (!file.type.startsWith("image/")) {
        showError("Оберіть файл зображення (JPG, PNG або WebP).");
        return;
      }

      const objectUrl = URL.createObjectURL(file);
      const img = new Image();

      img.onload = () => {
        URL.revokeObjectURL(objectUrl);

        const origW = img.naturalWidth;
        const origH = img.naturalHeight;
        const maxSide = 800;
        const scale = Math.min(1, maxSide / Math.max(origW, origH));
        const outW = Math.max(1, Math.round(origW * scale));
        const outH = Math.max(1, Math.round(origH * scale));

        const canvas = document.createElement("canvas");
        canvas.width = outW;
        canvas.height = outH;

        const ctx = canvas.getContext("2d");
        if (!ctx) {
          showError("Ваш браузер не підтримує обробку фото на Canvas.");
          return;
        }

        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = "high";
        ctx.drawImage(img, 0, 0, outW, outH);

        canvas.toBlob(
          (blob) => {
            if (!blob || blob.type !== "image/webp") {
              showError(
                "Ваш браузер не зміг зберегти фото у форматі WebP. Спробуйте сучасний Chrome, Edge, Safari або Firefox."
              );
              return;
            }

            if (blob.size > 1024 * 1024) {
              showError("Навіть після стиснення фото перевищує 1 МБ. Оберіть інше фото.");
              return;
            }

            const reader = new FileReader();
            reader.onloadend = () => {
              const dataUrl = typeof reader.result === "string" ? reader.result : "";
              if (!dataUrl.startsWith("data:image/webp;base64,")) {
                showError("Не вдалося підготувати WebP-зображення.");
                return;
              }
              compressedPhotoDataUrl = dataUrl;
              if (photoPreviewImg) photoPreviewImg.src = dataUrl;
              if (photoStats) {
                const savedPct =
                  file.size > 0
                    ? Math.max(0, Math.round(((file.size - blob.size) / file.size) * 100))
                    : 0;
                photoStats.textContent = `Вага: ${formatKB(blob.size)} (оригінал ${formatKB(file.size)}${savedPct > 0 ? `, −${savedPct}%` : ""})`;
              }
              if (photoDims) {
                photoDims.textContent = `Розмір: ${outW} × ${outH} px (було ${origW} × ${origH} px)`;
              }
              photoDropZone?.classList.add("hidden");
              photoPreviewBox?.classList.remove("hidden");
            };
            reader.readAsDataURL(blob);
          },
          "image/webp",
          0.8
        );
      };

      img.onerror = () => {
        URL.revokeObjectURL(objectUrl);
        showError("Не вдалося прочитати вибраний файл зображення.");
      };

      img.src = objectUrl;
    }

    photoDropZone?.addEventListener("click", () => photoInput?.click());
    photoDropZone?.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        photoInput?.click();
      }
    });
    photoDropZone?.addEventListener("dragover", (e) => {
      e.preventDefault();
      photoDropZone.classList.add("border-blue-500", "bg-sky-100/70");
    });
    photoDropZone?.addEventListener("dragleave", () => {
      photoDropZone.classList.remove("border-blue-500", "bg-sky-100/70");
    });
    photoDropZone?.addEventListener("drop", (e) => {
      e.preventDefault();
      photoDropZone.classList.remove("border-blue-500", "bg-sky-100/70");
      const file = e.dataTransfer?.files?.[0];
      if (file) processPhotoFile(file);
    });

    photoInput?.addEventListener("change", () => {
      const file = photoInput.files?.[0];
      if (file) processPhotoFile(file);
    });
    replacePhotoBtn?.addEventListener("click", () => photoInput?.click());
    removePhotoBtn?.addEventListener("click", clearPhoto);

    // Відправка форми
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (isSubmitting) return;
      showError("");

      // Якщо користувач щось ввів у поле напрямків, але не натиснув «Додати» — додаємо автоматично
      if (specInput && specInput.value.trim()) {
        addSpecFromInput();
      }

      const accessCode = accessCodeInput?.value.trim() || "";
      const fullName = fullNameInput?.value.trim() || "";
      const role = roleSelect?.value || "";
      const department = deptSelect?.value || "";
      const showBackCardEl = form.querySelector<HTMLInputElement>(
        'input[name="showBackCard"]:checked'
      );
      const showBackCard = showBackCardEl?.value === "hide" ? "hide" : "auto";

      if (!accessCode) {
        showError("Введіть код доступу.");
        accessCodeInput?.focus();
        return;
      }

      if (fullName.split(/\s+/).filter(Boolean).length < 2) {
        showError("Вкажіть ПІБ повністю (мінімум прізвище та імʼя).");
        fullNameInput?.focus();
        return;
      }

      if (!role) {
        showError("Оберіть посаду зі списку.");
        roleSelect?.focus();
        return;
      }

      const formDurationMs = Math.round(performance.now() - mountTime);
      if (formDurationMs < 3000) {
        showError("Зачекайте кілька секунд перед відправкою форми.");
        return;
      }

      isSubmitting = true;
      if (submitBtn) submitBtn.disabled = true;
      submitSpinner?.classList.remove("hidden");
      if (submitLabel) submitLabel.textContent = "Надсилання...";

      const headers: Record<string, string> = {
        "Content-Type": "application/json",
      };
      if (/^[\x20-\x7E]+$/.test(accessCode)) {
        headers["X-Staff-Access-Code"] = accessCode;
      }

      try {
        const resp = await fetch("/api/submit-staff", {
          method: "POST",
          headers,
          body: JSON.stringify({
            accessCode,
            fullName,
            role,
            department,
            experience: expInput?.value.trim() || "",
            bio: bioInput?.value.trim() || "",
            education: eduInput?.value.trim() || "",
            achievements: achInput?.value.trim() || "",
            specializations,
            showBackCard,
            photoDataUrl: compressedPhotoDataUrl || undefined,
            website: honeypotInput?.value || "",
            formDurationMs,
          }),
        });

        const data = await resp.json().catch(() => ({}));

        if (!resp.ok || !data.ok) {
          showError(data.error || "Не вдалося надіслати анкету. Перевірте дані та спробуйте ще раз.");
          if (resp.status === 403 && accessCodeInput) {
            accessCodeInput.focus();
          }
          return;
        }

        if (successText && data.message) {
          successText.textContent = data.message;
        }
        form.classList.add("hidden");
        successPanel?.classList.remove("hidden");
        successPanel?.scrollIntoView({ behavior: "smooth", block: "center" });
      } catch {
        showError("Помилка мережі. Перевірте інтернет-зʼєднання та спробуйте ще раз.");
      } finally {
        isSubmitting = false;
        if (submitBtn) submitBtn.disabled = false;
        submitSpinner?.classList.add("hidden");
        if (submitLabel) submitLabel.textContent = "Надіслати анкету на перевірку";
      }
    });

    resetBtn?.addEventListener("click", () => {
      form.reset();
      specializations = [];
      renderSpecs();
      clearPhoto();
      if (bioCount) bioCount.textContent = "0 / 800";
      showError("");
      successPanel?.classList.add("hidden");
      form.classList.remove("hidden");
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }

  initStaffAnketaForm();
  document.addEventListener("astro:after-swap", initStaffAnketaForm);
</script>
